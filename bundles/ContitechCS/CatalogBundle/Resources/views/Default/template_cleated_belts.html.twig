{% if parentContainer is not defined %}
	{% extends "@ContitechCSCatalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	{% if editmode %}
		{{ pimcore_relation('cbs_template_cleated_belts_page', {
        'types' : ['object'],
        'subtypes' : {
            'object' : ['object']
        },
        'classes' : ['CSCatalogTables'],
    }) }}
	{% endif %}

	{% if data is defined %}
		<div class="wrapper beltinfotable">
			<header id="header">
				<div class="header-sec">
					<div class="header-txt">
						<span class="first-title">{{('CS_header_title') | trans }}</span>
						<span class="second-title">
							{% if pimcore_input("CB_title").isEmpty() %}
								{{ pimcore_input("CB_title", {'placeholder' : 'Enter your title'}).setDataFromResource(data['HierarchyNameLevel2']) | raw }}
							{% else %}
								{{ pimcore_input("CB_title", {'placeholder' : 'Enter your title'}) }}
							{% endif %}
						</span>
					</div>
					<div class="print-pg-no"></div>
				</div>
			</header>
			<footer id="footer" class="footer">
				<div class="footer-logo">
					<img src="{{ footer_logo_src }}" alt="" width="150">
				</div>
			</footer>
            <main id="content" role="main">
                <section class="fortressxp-belts">
                    {% if editmode %}
                        <div class="attr-font">Attribute Name = Name</div>
                    {% endif %}
                    <h1 class="orange pt-4">
                        {% if editmode %}
                            {% if pimcore_input("CS_ProductName").isEmpty() %}
                                {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}).setDataFromResource(data['Name']) | raw }}
                            {% else %}
                                {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}) }}
                            {% endif %}
                        {% else %}
                            {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}) }}
                        {% endif %}
                    </h1>
                    <div class="p-medium">
                        <p>
                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Short Text</div>
                            {% endif %}
                        </p>
                        {% if editmode and data['ShortText'] is defined %}
                            {% if pimcore_textarea("CB_LongText").isEmpty() %}
                                {{ pimcore_textarea("CB_LongText", {'placeholder' : 'Enter Short Text'}).setDataFromResource(data['ShortText']) | raw }}
                            {% else %}
                                {{ pimcore_textarea("CB_LongText", {'placeholder' : 'Enter Short Text'}) }}
                            {% endif %}
                        {% else %}
                            {{ pimcore_textarea("CB_LongText", {'placeholder' : 'Enter Short Text'}) }}
                        {% endif %}
                    </div>

                    {% if data['cleatedProducts'] is defined %}
                        <h2 class="orange mb-4 pt-4">
                            {% if editmode %}
                                {% if pimcore_textarea("CB_ProfileOption").isEmpty() %}
                                    {{ pimcore_textarea("CB_ProfileOption", {'placeholder' : 'Profile Options'}) }}
                                {% else %}
                                    {{ pimcore_textarea("CB_ProfileOption") }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_textarea("CB_ProfileOption") }}
                            {% endif %}
                        </h2>

                        <div class="row profile-option">
                            {% for key,child in data['cleatedProducts'] %}
                                {% set md5Key = md5Twig(child['Name']) %}

                                <div class="col-2">
                                    {% if editmode %}
                                        <div class="attr-font">Child Attribute Name = Product Image</div>
                                    {% endif %}

                                    <div class="cleated_product_img">
                                        {% if editmode %}
                                            {% if pimcore_image("CBChild_productImage_"~ md5Key).isEmpty() %}
                                                {{ pimcore_image("CBChild_productImage_"~ md5Key).setImage(child['ProductImage']) | raw }}
                                            {% else %}
                                                {{ pimcore_image("CBChild_productImage_"~ md5Key) }}
                                            {% endif %}
                                        {% else %}
                                            {% set CBChild_productImageObj = pimcore_image("CBChild_productImage_"~ md5Key) %}
                                            {% if CBChild_productImageObj.getId() is defined %}
                                                <img src="{{ getImageThumbnail(CBChild_productImageObj, imageWidth) }}" alt=""/>
                                            {% endif %}
                                        {% endif %}
                                    </div>

                                    {% if editmode %}
                                        <div class="attr-font">Child Attribute Name = Name</div>
                                    {% endif %}
                                    <p>
                                        {% if editmode %}
                                            {% if pimcore_textarea("CBChild_Name_"~ md5Key).isEmpty() %}
                                                {{ pimcore_textarea("CBChild_Name_"~ md5Key, {'placeholder' : 'Enter Name'}).setDataFromResource(child['Name']) | raw }}
                                            {% else %}
                                                {{ pimcore_textarea("CBChild_Name_"~ md5Key, {'placeholder' : 'Enter Name'}) }}
                                            {% endif %}
                                        {% else %}
                                            {{ pimcore_textarea("CBChild_Name_"~ md5Key, {'placeholder' : 'Enter Name'}) }}
                                        {% endif %}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <hr class="divider" />

                    {% if displayTablesFlag is defined %}
                        <div class="table w-90 construction-tab">
                            <table width="100%">
                                <tbody>
                                    <tr>
                                        <td class="border-b">
                                        <div class="{{ not editmode ? 'd-flex' : '' }}">
                                            {{ pimcore_areablock('BeltConstruction') }}
                                        </div>
                                    </td>
                                    </tr>
                                    {% set cover_compounds = data['cover_compounds']|batch(3) %}
                                    {% if cover_compounds is defined %}
                                        <tr>
                                            <td class="border-b  pt-4">
                                                <table width="50%" class="mx-auto">
                                                    <thead>
                                                        <tr>
                                                            <th class="orange" colspan="3">
                                                                {{ pimcore_input("P_N_Belt_Construction", {'placeholder' : 'Cleated Belt Compounds'}) }}
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% if cover_compounds is defined %}
                                                            {% for arr in cover_compounds %}
                                                                <tr>
                                                                    {% for obj in arr %}
                                                                        <td>
                                                                            {{ obj.getName() }}
                                                                        </td>
                                                                    {% endfor %}
                                                                </tr>
                                                            {% endfor %}
                                                        {% endif %}
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    {% if editmode %}
                        <div class="page-break"></div>
                        <div class="attr-font">Attribute Name = Name</div>

                        <h2 class="orange pt-4">
                            {% if pimcore_input("CB_ProductNameBeltRoll").isEmpty() %}
                                {{ pimcore_input("CB_ProductNameBeltRoll", {'placeholder' : 'Enter Name'}).setDataFromResource(data['Name']) | raw }}
                            {% else %}
                                {{ pimcore_input("CB_ProductNameBeltRoll", {'placeholder' : 'Enter Name'}) }}
                            {% endif %}

                            <span class="sub-title">
                                {% if pimcore_input("CB_ProductNameBeltRollDiameters").isEmpty() %}
                                    {{ pimcore_input("CB_ProductNameBeltRollDiameters", {'placeholder' : 'Belt Roll Diameters'}) }}
                                {% else %}
                                    {{ pimcore_input("CB_ProductNameBeltRollDiameters") }}
                                {% endif %}
                            </span>
                        </h2>

                        <div class="attr-font">Attribute Name = Belt Roll Diameters</div>
                        {% if pimcore_image("CB_BeltRollDiameters").isEmpty() %}
                            {{ pimcore_image("CB_BeltRollDiameters", {"height" : 525}).setImage(data['BeltRollDiameters']) | raw }}
                        {% else %}
                            {{ pimcore_image("CB_BeltRollDiameters", {"height" : 525}) }}
                        {% endif %}
                    
                    {% else %}
                        {% set CB_BeltRollDiametersObj = pimcore_image("CB_BeltRollDiameters") %}
                        {% if CB_BeltRollDiametersObj.getId() is not empty %}
                            <div class="page-break"></div>
                            <h2 class="orange pt-4">
                                {{ pimcore_input("CB_ProductNameBeltRoll", {'placeholder' : 'Enter Name'}) }}
                                <span class="sub-title">
                                    {{ pimcore_input("CB_ProductNameBeltRollDiameters") }}
                                </span>
                            </h2>
                            <img src="{{ getImageThumbnail(CB_BeltRollDiametersObj, imageWidth) }}" alt="" class="w-100 mt-4 mb-4" style="max-height:525px; width:auto;" />
                        {% endif %}
                    {% endif %}

                    {% if editmode %}
                        <div class="page-break"></div>
                        <div class="attr-font">Attribute Name = Name</div>

                        <h2 class="orange pt-4">
                            {% if pimcore_input("CB_ProductNameAngleIncline").isEmpty() %}
                                {{ pimcore_input("CB_ProductNameAngleIncline", {'placeholder' : 'Enter Name'}).setDataFromResource(data['Name']) | raw }}
                            {% else %}
                                {{ pimcore_input("CB_ProductNameAngleIncline", {'placeholder' : 'Enter Name'}) }}
                            {% endif %}

                            <span class="sub-title">
                                {% if pimcore_input("CB_ProductNameAngleOfInclination").isEmpty() %}
                                    {{ pimcore_input("CB_ProductNameAngleOfInclination", {'placeholder' : 'Angles of Inclination'}) }}
                                {% else %}
                                    {{ pimcore_input("CB_ProductNameAngleOfInclination") }}
                                {% endif %}
                            </span>
                        </h2>

                        <div class="attr-font">Attribute Name = Angles of Inclination</div>
                        {% if pimcore_image("CB_AngleOfInclination").isEmpty() %}
                            {{ pimcore_image("CB_AngleOfInclination", {"height" : 450}).setImage(data['AngleOfInclination']) | raw }}
                        {% else %}
                            {{ pimcore_image("CB_AngleOfInclination", {"height" : 450}) }}
                        {% endif %}
                    {% else %}
                        {% set CB_AngleOfInclinationObj = pimcore_image("CB_AngleOfInclination") %}
                        {% if CB_AngleOfInclinationObj.getId() is not empty %}
                            <div class="page-break"></div>

                            <h2 class="orange pt-4">
                                {{ pimcore_input("CB_ProductNameAngleIncline", {'placeholder' : 'Enter Name'}) }}
                                <span class="sub-title">
                                    {{ pimcore_input("CB_ProductNameAngleOfInclination") }}
                                </span>
                            </h2>

                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Angles of Inclination</div>
                            {% endif %}

                            <img src="{{ getImageThumbnail(CB_AngleOfInclinationObj, imageWidth) }}" alt="" class="w-100 mt-4 mb-4" style="max-height:450px; width:auto;" />

                        {% endif %}
                    {% endif %}

                    {% if data['normalProductsDetails']['childData'] is defined %}
                        <div class="cleated-belts" style="page-break-inside: avoid;">
                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Name</div>
                            {% endif %}
                            <h2 class="orange heading-info pt-4">
                                {% if editmode %}
                                    {% if pimcore_input("CB_ProductNameProfileOptions").isEmpty() %}
                                        {{ pimcore_input("CB_ProductNameProfileOptions", {'placeholder' : 'Enter Name'}).setDataFromResource(data['Name']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("CB_ProductNameProfileOptions", {'placeholder' : 'Enter Name'}) }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("CB_ProductNameProfileOptions", {'placeholder' : 'Enter Name'}) }}
                                {% endif %}

                                <span class="sub-title">
                                    {% if editmode %}
                                    {% if pimcore_input("CB_ProductNameProfileOptionsLabel").isEmpty() %}
                                        {{ pimcore_input("CB_ProductNameProfileOptionsLabel", {'placeholder' : 'Profile Options'}) }}
                                    {% else %}
                                        {{ pimcore_input("CB_ProductNameProfileOptionsLabel") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("CB_ProductNameProfileOptionsLabel") }}
                                {% endif %}
                                </span>
                            </h2>

                            <div class="table construction-tab">
                                {% for key,child in data['normalProductsDetails']['childData'] %}
                                    {% if child['Name'] == "Backbone" %}
                                        {% set md5Key = md5Twig(child['Name']) %}
                                        <table width="100%" class="mt-2 mb-4 pagebreak parentTable">
                                            <thead>
                                                <th colspan="3" class="text-left">
                                                    {% if editmode %}
                                                        <div class="attr-font">Child Attribute Name = Name</div>
                                                    {% endif %}
                                                    <h2 class="mb-0">
                                                        {% if editmode %}
                                                            {% if pimcore_input("CB_Profile_"~ md5Key).isEmpty() %}
                                                                {{ pimcore_input("CB_Profile_"~ md5Key) }}
                                                                {{ pimcore_input("CB_Profile_"~ md5Key, {'placeholder' : 'Profile Name'}).setDataFromResource(child['Name']) | raw }}
                                                            {% else %}
                                                                {{ pimcore_input("CB_Profile_"~ md5Key) }}
                                                            {% endif %}
                                                        {% else %}
                                                            {{ pimcore_input("CB_Profile_"~ md5Key) }}
                                                        {% endif %}
                                                    </h2>
                                                </th>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        <table class="parentTable">
                                                            <tr>
                                                                <td>
                                                                    <div style="width:100vw">
                                                                        <div abs="middle" style="float:right; width:40%; text-align:right;">
                                                                            <table>
                                                                                <tr>
                                                                                    <td width = "50%" style="vertical-align: top;">
                                                                                        {% if editmode %}
                                                                                            <div class="attr-font">Child Attribute Name = Product Image</div>
                                                                                        {% endif %}
                                                                                        {% if editmode %}
                                                                                            {% if pimcore_image("CB_ProfileOptionImage1_"~ md5Key).isEmpty() %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage1_"~ md5Key).setImage(child['ProductImage']) | raw }}
                                                                                            {% else %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage1_"~ md5Key) }}
                                                                                            {% endif %}
                                                                                        {% else %}
                                                                                            {% set CB_ProfileOptionImage1Obj = pimcore_image("CB_ProfileOptionImage1_"~ md5Key) %}
                                                                                            {% if CB_ProfileOptionImage1Obj.getId() is not empty %}
                                                                                                <img src="{{ getImageThumbnail(CB_ProfileOptionImage1Obj, imageWidth) }}" alt="" class="" />
                                                                                            {% endif %}
                                                                                        {% endif %}
                                                                                    </td>
                                                                                    <td width="50%" style="vertical-align: top;">
                                                                                        {% if editmode %}
                                                                                            <div class="attr-font" vertical-align="text-top">Child Attribute Name = Application Image</div>
                                                                                        {% endif %}
                                                                                        {% if editmode %}
                                                                                            {% if pimcore_image("CB_ProfileOptionImage2_"~ md5Key).isEmpty() %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage2_"~ md5Key).setImage(child['ApplicationImage']) | raw }}
                                                                                            {% else %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage2_"~ md5Key) }}
                                                                                            {% endif %}
                                                                                        {% else %}
                                                                                            {% set CB_ProfileOptionImage2Obj = pimcore_image("CB_ProfileOptionImage1_"~ md5Key) %}
                                                                                            {% if CB_ProfileOptionImage2Obj.getId() is not empty %}
                                                                                                <img src="{{ getImageThumbnail(CB_ProfileOptionImage2Obj, imageWidth) }}" alt="" class="" />
                                                                                            {% endif %}
                                                                                        {% endif %}
                                                                                    </td>
                                                                                </tr>
                                                                            </table>
                                                                        </div>
                                                                        <table class="parentTable">
                                                                            <tr class="grip-col">
                                                                                <td class="pr-4">
                                                                                    {% if editmode %}
                                                                                        <div class="attr-font">Child Attribute Name = Short Text</div>
                                                                                    {% endif %}
                                                                                    {% if editmode %}
                                                                                        {% if pimcore_textarea("CB_ProfileDesc_" ~ md5Key).isEmpty() %}
                                                                                            {{ pimcore_textarea("CB_ProfileDesc_" ~ md5Key, {'placeholder' : 'Profile Description'}).setDataFromResource(child['ShortText']) | raw }}
                                                                                        {% else %}
                                                                                            {{ pimcore_textarea("CB_ProfileDesc_" ~ md5Key) }}
                                                                                        {% endif %}
                                                                                    {% else %}
                                                                                        {{ pimcore_textarea("CB_ProfileDesc_" ~ md5Key) }}
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                            <tr style="page-break-inside: avoid;">
                                                                                <td>
                                                                                    <table class="normal-cleated-product">
                                                                                        <tbody>
                                                                                            {% if child['CS_CleatHeightInch'] is defined %}
                                                                                                <tr>
                                                                                                    <th class="orange text-right" style="font-size: 10px;">
                                                                                                        {{ (child['CS_CleatHeightInch'])|trans }}
                                                                                                    </th>
                                                                                                    <td colspan="{{ child['maxColumnLenth'] }}">
                                                                                                        {{ child['CS_CleatHeightInchVal'] ~ " " ~ ('CS_Unit_in')|trans }}
                                                                                                    </td>
                                                                                                </tr>
                                                                                            {% endif %}

                                                                                            {% if child['CS_AvailableBeltWidthInch'] is defined %}
                                                                                                <tr>
                                                                                                    <th class="orange text-right" style="font-size: 10px;">
                                                                                                        {{ (child['CS_AvailableBeltWidthInch'])|trans }}
                                                                                                    </th>
                                                                                                    {% for key,value in child['CS_AvailableBeltWidthInchList'] %}
                                                                                                        <td colspan="{{ child['maxColumnLenth'] }}">
                                                                                                            {{ value ~ " " ~ ('CS_Unit_in')|trans }}
                                                                                                        </td>
                                                                                                    {% endfor %}
                                                                                                </tr>
                                                                                            {% endif %}

                                                                                            {% if child['CS_AvailableProfilePatternWidthsInch'] is defined %}
                                                                                                {% for key,rows in child['CS_AvailableProfilePatternWidthsInch'] %}
                                                                                                    <tr>
                                                                                                        <th class="orange text-right" style="font-size: 10px;">
                                                                                                            {{ ('CS_AvailableProfilePatternWidthsInch')|trans }}
                                                                                                        </th>
                                                                                                        {% set firstIndexData = [] %}
                                                                                                        {% for i in child['CS_AvailableProfilePatternWidthsInch'][0] %}
                                                                                                            {% if i not in firstIndexData %}
                                                                                                                {% set firstIndexData = firstIndexData|merge([i]) %}
                                                                                                            {% endif %}
                                                                                                        {% endfor %}

                                                                                                        {% if child['maxRowLength'] == 1 and (firstIndexData)|length == 1  and not isNumericTwig(firstIndexData[0]) %}
                                                                                                            <td colspan="{{ child['maxColumnLenth'] }}">{{ rows[0] }}</td>
                                                                                                        {% else %}
                                                                                                            {% for key,value in rows %}
                                                                                                                <td>
                                                                                                                    {% if value %}
                                                                                                                        {{ value ~ " " ~ ("CS_Unit_in")|trans }}
                                                                                                                    {% else %}
                                                                                                                        {{ '&#8209' }}
                                                                                                                    {% endif %}
                                                                                                                </td>
                                                                                                            {% endfor %}
                                                                                                        {% endif %}
                                                                                                    </tr>
                                                                                                {% endfor %}
                                                                                            {% endif %}
                                                                                        </tbody>
                                                                                    </table>
                                                                                </td>
                                                                            </tr>
                                                                        </table>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                    {% elseif (child['Name'] == "Backbone Plus") or (child['Name'] == "Flux") %}
                                        {% set md5Key = md5Twig(child['Name']) %}
                                        <table width="100%" class="mt-2 mb-4 pagebreak parentTable">
                                            <thead>
                                                <th colspan="3" class="text-left">
                                                    {% if editmode %}
                                                        <div class="attr-font">Child Attribute Name = Name</div>
                                                    {% endif %}
                                                    <h2 class="mb-0">
                                                        {% if editmode %}
                                                            {% if pimcore_input("CB_Profile_"~ md5Key).isEmpty() %}
                                                                {{ pimcore_input("CB_Profile_"~ md5Key) }}
                                                                {{ pimcore_input("CB_Profile_"~ md5Key, {'placeholder' : 'Profile Name'}).setDataFromResource(child['Name']) | raw }}
                                                            {% else %}
                                                                {{ pimcore_input("CB_Profile_"~ md5Key) }}
                                                            {% endif %}
                                                        {% else %}
                                                            {{ pimcore_input("CB_Profile_"~ md5Key) }}
                                                        {% endif %}
                                                    </h2>
                                                </th>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        <table class="parentTable">
                                                            <tr>
                                                                <td>
                                                                    <div style="width:100vw">
                                                                        <div abs="middle" style="float:right; width:40%; text-align:right;">
                                                                            <table>
                                                                                <tr>
                                                                                    <td width = "50%" style="vertical-align: top;">
                                                                                        {% if editmode %}
                                                                                            <div class="attr-font">Child Attribute Name = Product Image</div>
                                                                                        {% endif %}
                                                                                        {% if editmode %}
                                                                                            {% if pimcore_image("CB_ProfileOptionImage1_"~ md5Key).isEmpty() %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage1_"~ md5Key).setImage(child['ProductImage']) | raw }}
                                                                                            {% else %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage1_"~ md5Key) }}
                                                                                            {% endif %}
                                                                                        {% else %}
                                                                                            {% set CB_ProfileOptionImage1Obj = pimcore_image("CB_ProfileOptionImage1_"~ md5Key) %}
                                                                                            {% if CB_ProfileOptionImage1Obj.getId() is not empty %}
                                                                                                <img src="{{ getImageThumbnail(CB_ProfileOptionImage1Obj, imageWidth) }}" alt="" class="" />
                                                                                            {% endif %}
                                                                                        {% endif %}
                                                                                    </td>
                                                                                    <td width="50%" style="vertical-align: top;">
                                                                                        {% if editmode %}
                                                                                            <div class="attr-font" vertical-align="text-top">Child Attribute Name = Application Image</div>
                                                                                        {% endif %}
                                                                                        {% if editmode %}
                                                                                            {% if pimcore_image("CB_ProfileOptionImage2_"~ md5Key).isEmpty() %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage2_"~ md5Key).setImage(child['ApplicationImage']) | raw }}
                                                                                            {% else %}
                                                                                                {{ pimcore_image("CB_ProfileOptionImage2_"~ md5Key) }}
                                                                                            {% endif %}
                                                                                        {% else %}
                                                                                            {% set CB_ProfileOptionImage2Obj = pimcore_image("CB_ProfileOptionImage1_"~ md5Key) %}
                                                                                            {% if CB_ProfileOptionImage2Obj.getId() is not empty %}
                                                                                                <img src="{{ getImageThumbnail(CB_ProfileOptionImage2Obj, imageWidth) }}" alt="" class="" />
                                                                                            {% endif %}
                                                                                        {% endif %}
                                                                                    </td>
                                                                                </tr>
                                                                            </table>
                                                                        </div>
                                                                        <table class="parentTable" style="width:58%; float:left;">
                                                                            <tr class="grip-col">
                                                                                <td class="pr-5">
                                                                                    {% if editmode %}
                                                                                        <div class="attr-font">Child Attribute Name = Short Text</div>
                                                                                    {% endif %}
                                                                                    {% if editmode %}
                                                                                        {% if pimcore_textarea("CB_ProfileDesc_" ~ md5Key).isEmpty() %}
                                                                                            {{ pimcore_textarea("CB_ProfileDesc_" ~ md5Key, {'placeholder' : 'Profile Description'}).setDataFromResource(child['ShortText']) | raw }}
                                                                                        {% else %}
                                                                                            {{ pimcore_textarea("CB_ProfileDesc_" ~ md5Key) }}
                                                                                        {% endif %}
                                                                                    {% else %}
                                                                                        {{ pimcore_textarea("CB_ProfileDesc_" ~ md5Key) }}
                                                                                    {% endif %}
                                                                                </td>
                                                                            </tr>
                                                                            <tr style="page-break-inside: avoid;">
                                                                                <td>
                                                                                    <table class="normal-cleated-product">
                                                                                        <tbody>
                                                                                            {% if child['CS_CleatHeightInch'] is defined %}
                                                                                                <tr>
                                                                                                    <th class="orange text-right" style="font-size: 10px;">
                                                                                                        {{ (child['CS_CleatHeightInch'])|trans }}
                                                                                                    </th>
                                                                                                    <td colspan="{{ child['maxColumnLenth'] }}">
                                                                                                        {{ child['CS_CleatHeightInchVal'] ~ " " ~ ('CS_Unit_in')|trans }}
                                                                                                    </td>
                                                                                                </tr>
                                                                                            {% endif %}

                                                                                            {% if child['CS_AvailableBeltWidthInch'] is defined %}
                                                                                                <tr>
                                                                                                    <th class="orange text-right" style="font-size: 10px;">
                                                                                                        {{ (child['CS_AvailableBeltWidthInch'])|trans }}
                                                                                                    </th>
                                                                                                    {% for key,value in child['CS_AvailableBeltWidthInchList'] %}
                                                                                                        <td colspan="{{ child['maxColumnLenth'] }}">
                                                                                                            {{ value ~ " " ~ ('CS_Unit_in')|trans }}
                                                                                                        </td>
                                                                                                    {% endfor %}
                                                                                                </tr>
                                                                                            {% endif %}

                                                                                            {% if child['CS_AvailableProfilePatternWidthsInch'] is defined %}
                                                                                                {% for key,rows in child['CS_AvailableProfilePatternWidthsInch'] %}
                                                                                                    <tr>
                                                                                                        <th class="orange text-right" style="font-size: 10px;">
                                                                                                            {{ ('CS_AvailableProfilePatternWidthsInch')|trans }}
                                                                                                        </th>
                                                                                                        {% set firstIndexData = [] %}
                                                                                                        {% for i in child['CS_AvailableProfilePatternWidthsInch'][0] %}
                                                                                                            {% if i not in firstIndexData %}
