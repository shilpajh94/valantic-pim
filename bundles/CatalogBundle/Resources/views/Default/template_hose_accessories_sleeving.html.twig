{% if not isParentContainerRequest %}
        {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
    {% if editmode %}
            {{ pimcore_relation("template_hose_accessories_sleeving",{
            "types": ["object"],
            "subtypes": {
                    "object": ["object"],
            },
            "classes": ["CatalogTables"]
            }) }}
    {% endif %}
    {% if data is defined %}
        {% set partNumbers = [] %}
        {% set productNumbers = [] %}
        <div class="template">
            <section class="segregate">
                    <div id="pageHeader"></div>
                    <span class="pageName">Hydraulic Hose</span>
                    <div class="footer">
                            <footer class="flex-center {{footer_class}}">
                                    <span class="logo">
                                            <b>
                                                    {% if editmode %} 
                                                            {% if pimcore_input("HHAS_Logo_Text1").isEmpty() %} 
                                                                    {{ pimcore_input("HHAS_Logo_Text1").setDataFromResource('Hose') | raw }}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAS_Logo_Text1") }}
                                                            {% endif %}
                                                    {% else %}
                                                            {{ pimcore_input("HHAS_Logo_Text1") }}
                                                    {% endif %}
                                            </b>
                                            <img src="{{footer_logo_src}}">
                                    </span>
                                    <div class="flex aligned">
                                            <h5>
                                                    {% if editmode %} 
                                                            {% if pimcore_input("HHAS_Footer_Title1").isEmpty() %} 
                                                                    {{ pimcore_input("HHAS_Footer_Title1").setDataFromResource('Hose Accessories') | raw }}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAS_Footer_Title1") }}
                                                            {% endif %}
                                                    {% else %}
                                                            {{ pimcore_input("HHAS_Footer_Title1") }}
                                                    {% endif %}

                                                    <span>
                                                            {% if editmode %} 
                                                                    {% if pimcore_input("HHAS_Footer_SubTitle1").isEmpty() %} 
                                                                            {{ pimcore_input("HHAS_Footer_SubTitle1").setDataFromResource('Protective Sleeving / Protective Wrap') | raw }}
                                                                    {% else %}
                                                                            {{ pimcore_input("HHAS_Footer_SubTitle1") }}
                                                                    {% endif %}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAS_Footer_SubTitle1") }}
                                                            {% endif %}
                                                    </span>
                                            </h5>
                                    </div>
                            </footer>
                    </div>

                    <div class="footer1">
                            <footer class="flex-center {{footer_class}}">

                                    <div class="flex aligned">
                                            <h5>
                                                    {% if editmode %} 
                                                            {% if pimcore_input("HHAS_Footer_Title2").isEmpty() %} 
                                                                    {{ pimcore_input("HHAS_Footer_Title2").setDataFromResource('Hose Accessories') | raw }}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAS_Footer_Title2") }}
                                                            {% endif %}
                                                    {% else %}
                                                            {{ pimcore_input("HHAS_Footer_Title2") }}
                                                    {% endif %}

                                                    <span>

                                                            {% if editmode %} 
                                                                    {% if pimcore_input("HHAS_Footer_SubTitle2").isEmpty() %} 
                                                                            {{ pimcore_input("HHAS_Footer_SubTitle2").setDataFromResource('Protective Sleeving / Protective Wrap') | raw }}
                                                                    {% else %}
                                                                            {{ pimcore_input("HHAS_Footer_SubTitle2") }}
                                                                    {% endif %}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAS_Footer_SubTitle2") }}
                                                            {% endif %}
                                                            
                                                    </span>
                                            </h5>
                                    </div>
                                    <span class="logo">
                                            <b>
                                                    {% if editmode %} 
                                                            {% if pimcore_input("HHAS_Logo_Text2").isEmpty() %} 
                                                                    {{ pimcore_input("HHAS_Logo_Text2").setDataFromResource('Hose') | raw }}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAS_Logo_Text2") }}
                                                            {% endif %}
                                                    {% else %}
                                                            {{ pimcore_input("HHAS_Logo_Text2") }}
                                                    {% endif %}

                                            </b>
                                            <img src="{{footer_logo_src}}">
                                    </span>

                            </footer>
                    </div>

                    <div class="wrapper">
                            <article class="container noBorder">
                                    <section class="content single">

                                            {% if data %}
                                                    {% set onlyOneTitle = false %}

                                                    {% for md5key, brand in data %}
                                                            <figure class="justify-between">
                                                                    <figcaption>
                                                                            {% if not onlyOneTitle %}
                                                                                    <h2>
                                                                                            {% if editmode %}
                                                                                                    {% if pimcore_input("HHAS_HeadingRight_"~md5key).isEmpty() %}
                                                                                                            {{ pimcore_input("HHAS_HeadingRight_"~md5key).setDataFromResource("Hose Accessories") | raw }}
                                                                                                    {% else %}
                                                                                                            {{ pimcore_input("HHAS_HeadingRight_"~md5key) }}
                                                                                                    {% endif %}
                                                                                            {% else %}
                                                                                                    {{ pimcore_input("HHAS_HeadingRight_"~md5key) }}
                                                                                            {% endif %}
                                                                                    
                                                                                    </h2>
                                                                                    {% set onlyOneTitle = true %}
                                                                            {% endif %}

                                                                            <h4 class="contitech-yellow">
                                                                                    {% if editmode %}
                                                                                            {% if pimcore_input("HHAS_BrandNameRight_"~md5key).isEmpty() %}
                                                                                                    {{ pimcore_input("HHAS_BrandNameRight_"~md5key).setDataFromResource(brand['brandName']) | raw}}
                                                                                            {% else %}
                                                                                                    {{ pimcore_input("HHAS_BrandNameRight_"~md5key) }}
                                                                                            {% endif %}
                                                                                    {% else %}
                                                                                            {{ pimcore_input("HHAS_BrandNameRight_"~md5key) }}
                                                                                    {% endif %}
                                                                            </h4>

                                                                            <span>
                                                                                    {% if editmode %}
                                                                                            {% if pimcore_wysiwyg("HHAS_LongDescriptionRight_"~md5key).isEmpty() %}
                                                                                                    {{ pimcore_wysiwyg("HHAS_LongDescriptionRight_"~md5key).setDataFromResource(brand['longDescription']) | raw}}
                                                                                            {% else %}
                                                                                                    {{ pimcore_wysiwyg("HHAS_LongDescriptionRight_"~md5key) }}
                                                                                            {% endif %}
                                                                                    {% else %}
                                                                                            {{ pimcore_wysiwyg("HHAS_LongDescriptionRight_"~md5key) }}
                                                                                    {% endif %}
                                                                            </span>
                                                                            {% if (brand['materialString']|trim is not empty or brand['colorString']|trim is not empty or brand['availableLengthString']|trim is not empty or brand['temperatureRangeFAndC']|trim is not empty) %}
                                                                                    <menu>
                                                                                            <div class="specs">
                                                                                                    <h6>{# $this->translate('specs') #}</h6>
                                                                                                    <div class="spec-requirement">
                                                                                                            {% if (brand['safetyFeatures'] or brand['materialString']|trim is not empty or brand['temperatureRangeFAndC']|trim is not empty) %}

                                                                                                                    {% if brand['safetyFeatures'] %}
                                                                                                                            <div>
                                                                                                                                    {% for key, feature in brand['safetyFeatures'] %}
                                                                                                                                    <p  class="flex">
                                                                                                                                    <font class="is-highlight"> {{feature['name'] }}</font>
                                                                                                                                    </p>
                                                                                                                                    {% endfor %}
                                                                                                                            </div>
                                                                                                                    {% endif %}

                                                                                                                    <div>
                                                                                                                            {% if brand['temperatureRangeFAndC']|trim is not empty %}
                                                                                                                            <p class="small">
                                                                                                                                    <b>{# $this->translate('Temperature Range') #}</b>
                                                                                                                                    {{brand['temperatureRangeFAndC']}}
                                                                                                                            </p>
                                                                                                                            {% endif %}

                                                                                                                            {% if brand['materialString']|trim is not empty %}
                                                                                                                                    <p class="small">
                                                                                                                                            <b>{# $this->translate('Material') #}</b>
                                                                                                                                            {{brand['materialString']}}
                                                                                                                                    </p>
                                                                                                                            {% endif %}
                                                                                                                    </div>
                                                                                                            {% endif %}

                                                                                                            {% if brand['colorString']|trim is not empty or brand['availableLengthString']|trim is not empty %}
                                                                                                                    <div>
                                                                                                                            {% if brand['colorString']|trim is not empty %}
                                                                                                                                    <p class="small">
                                                                                                                                            <b>{# $this->translate('Color') #}</b>
                                                                                                                                            {{brand['colorString']}}        
                                                                                                                                    </p>
                                                                                                                            {% endif %}

                                                                                                                            {% if brand['availableLengthString']|trim is not empty %}
                                                                                                                                    <p class="small">
                                                                                                                                            <b>{# $this->translate('Available Lengths') #}</b>
                                                                                                                                            {{"Continuous "~brand['colorString']~"' rolls"}}     
                                                                                                                                    </p>
                                                                                                                            {% endif %}
                                                                                                                    </div>
                                                                                                            {% endif %}
                                                                                                    </div>
                                                                                            </div>
                                                                                    </menu>
                                                                            {% endif %}
                                                                    
                                                                    </figcaption>

                                                                    {% if editmode %}
                                                                            {% if pimcore_image("HHAS_Image_"~md5key).isEmpty() %}
                                                                                    {{ pimcore_image("HHAS_Image_"~md5key,{"width":200, "height":200}) }}
                                                                            {% else %}
                                                                                    {{ pimcore_image("HHAS_Image_"~md5key,{"width":200, "height":200}).setImage(brand['imageObj']) | raw }}
                                                                            {% endif %}
                                                                    {% else %}
                                                                            {% set imgSrcObj =  pimcore_image("HHAS_Image_"~md5key) %}
                                                                            {% if imgSrcObj %}
                                                                                    <img src="{{ getImageThumbnail(imgSrcObj,imageWidth) }}" height="200" width="200"/>
                                                                            {% endif %}
                                                                    {% endif %}
                                                            </figure>
                                    
                                                            <table class="grid" cellspacing="0" cellpadding="0">
                                                                    <thead>
                                                                            {% if (brand['iconRequired'] == 'YES') %}
                                                                                    <tr class="sub-head">
                                                                                            {% for key, c1data in brand['columnsDataWithImages'] %}

                                                                                                    {% set columnWidth = '' %}
                                                                                                    {% set g1count = c1data|length %}
                                                                                                    {% set firstArray = c1data|first %}

                                                                                                    {% if (firstArray['columnWidth']) %}
                                                                                                            {% set columnWidth = "width="~firstArray['columnWidth'] %}
                                                                                                    {% endif %}

                                                                                                    <td colspan="{{g1count}}" {{columnWidth}}>
                                                                                                            {% if ( firstArray['columnIcon'] is defined and firstArray['columnIcon']) %}
                                                                                                                    <img src="{{firstArray['columnIcon']}}" width="45" height="45" />
                                                                                                            {% endif %}
                                                                                                    </td>
                                                                                            {% endfor %}
                                                                                    </tr>
                                                                            {% endif %}

                                                                            <tr class="head">
                                                                                    {% for key, c2data in brand['columnsDataWithImages'] %}

                                                                                            {% set columnWidth = '' %}
                                                                                            {% set g2count = c2data|length %}
                                                                                            {% set first2Array = c2data|first %}

                                                                                            {% if (first2Array['columnWidth']) %}
                                                                                                    {% set columnWidth = "width="~first2Array['columnWidth'] %}
                                                                                            {% endif %}
                                                                                            <td colspan="{{g2count}}" {{columnWidth}}>{{first2Array['columnLabel']}}</td>

                                                                                    {% endfor %}
                                                                            </tr>

                                                                            {% if (brand['subHeaderRequired'] == 'YES') %}
                                                                                    <tr class="sub-head">
                                                                                            {% for key, c3data in brand['columnsDataWithImages'] %}
                                                                                                    {% for c3key, c3value in c3data %}
                                                                                                            {% if (c3value['unitName']) %}
                                                                                                                    <td>{{c3value['unitName']}}</td>
                                                                                                            {% else %}
                                                                                                                    <td></td>
                                                                                                            {% endif %}
                                                                                                    {% endfor %}
                                                                                            {% endfor %}
                                                                                    </tr>
                                                                            {% endif %}

                                                                    </thead>
                                                                    <tbody>
                                                                            {% set incrRow = 1 %}
                                                                            {% for key, element in brand['articlesData'] %}
                                                                                    {% if (incrRow%2==0) %}
                                                                                            <tr>
                                                                                    {% else %}
                                                                                            <tr class="active">
                                                                                    {% endif %}

                                                                                    {% if element['Descriptive'] is defined %}
                                                                                            {% set descriptiveNumberText = element['Descriptive'] %}
                                                                                            {% set descriptiveNumberList = descriptiveNumberText | split('-') %}

                                                                                            {% if descriptiveNumberList[0] not in partNumbers %}
                                                                                                    {% set partNumbers = partNumbers|merge([descriptiveNumberList[0]]) %}
                                                                                            {% endif %}

                                                                                    {% endif %}

                                                                                    {% if element['industryStandard'] is defined %}
                                                                                            {% set industryStandardText = element['industryStandard'] %}
                                                                                            {% set industryStandardList = industryStandardText | split('-') %}

                                                                                            {% if industryStandardList[0] not in productNumbers %}
                                                                                                    {% set productNumbers = productNumbers|merge([industryStandardList[0]]) %}
                                                                                            {% endif %}

                                                                                    {% endif %}
                                                                                            
                                                                                    {% for ekey, value in element %}
                                                                                            <td>{{value}}</td>
                                                                                    {% endfor %}
                                                                                    </tr>
                                                                                    {% set incrRow = incrRow + 1 %}
                                                                            {% endfor %}
                                                                    </tbody>
                                                            </table>
                                                            <p class="small">
                                                                    {{ pimcore_input("HHAS_note_"~md5key, {placeholder:'Enter comment'}) }}
                                                            </p>
                                                    {% endfor %}
                                            {% endif %}
                                    </section>
                            </article>
                    </div>
            </section>
            <div class="hide">
                    {% if partNumbers|length > 0 %}
                            {% set partNumberString = partNumbers|join(',') %}
                            {{ pimcore_textarea('product_page_part_number').setDataFromResource(partNumberString) | raw}}
                    {% endif %}
                    
                    {% if productNumbers|length > 0 %}
                            {% set productNumbersString = productNumbers|join(',') %}
                            {{ pimcore_textarea('product_page_product_number').setDataFromResource(productNumbersString) | raw}}
                    {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}