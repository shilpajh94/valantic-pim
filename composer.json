{
  "name": "pimcore/skeleton",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "ocramius/package-versions": true
    }
  },
  "require": {
    "php": ">=8.0",
    "doctrine/doctrine-migrations-bundle": "^3.0.1",
    "elements/process-manager-bundle": "~3.0.0",
    "php-http/guzzle7-adapter": "^0.1.1",
    "pimcore/pimcore": "~10.6.0"
  },
  "conflict": {
    "doctrine/doctrine-migrations-bundle": "3.1.0"
  },
  "require-dev": {
    "cache/integration-tests": "dev-master",
    "codeception/codeception": "^4.1.12"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject",
      "Pimcore\\Model\\Object\\": "var/classes/Object",
      "Website\\": "legacy/website/lib",
      "ADAuthBundle\\": "bundles/ADAuthBundle",
      "AppBundle\\": "bundles/AppBundle",
      "B2BExportBundle\\": "bundles/B2BExportBundle",
      "B2BTranslationBundle\\": "bundles/B2BTranslationBundle",
      "CatalogBundle\\": "bundles/CatalogBundle",
      "ClassRelationBundle\\": "bundles/ClassRelationBundle",
      "DistributionHubBundle\\": "bundles/DistributionHubBundle",
      "EmailNotificationBundle\\": "bundles/EmailNotificationBundle",
      "ImportBundle\\": "bundles/ImportBundle",
      "PimDataPostBundle\\": "bundles/PimDataPostBundle",
      "RequiredAttributesBundle\\": "bundles/RequiredAttributesBundle",
      "RestApiBundle\\": "bundles/RestApiBundle",
      "S3CustomizationBundle\\": "bundles/S3CustomizationBundle",
      "PTGEU\\ImportBundle\\": "bundles/PTGEU/ImportBundle",
      "PTGEU\\ProductBundle\\": "bundles/PTGEU/ProductBundle",
      "PTGEU\\CatalogBundle\\": "bundles/PTGEU/CatalogBundle",
      "IFSEU\\ProductBundle\\": "bundles/IFSEU/ProductBundle",
      "IFSEU\\ImportBundle\\": "bundles/IFSEU/ImportBundle",
      "IFSEU\\RestApiBundle\\": "bundles/IFSEU/RestApiBundle",
      "ContitechCS\\CatalogBundle\\": "bundles/ContitechCS/CatalogBundle",
      "ContitechCS\\CatalogUIApiBundle\\": "bundles/ContitechCS/CatalogUIApiBundle",
      "ContitechCS\\ImportBundle\\": "bundles/ContitechCS/ImportBundle",
      "ContitechCS\\ProductBundle\\": "bundles/ContitechCS/ProductBundle"
    }
  },
  "scripts": {
    "post-create-project-cmd": "Pimcore\\Composer::postCreateProject",
    "post-install-cmd": [
      "Pimcore\\Composer::postInstall",
      "@pimcore-scripts"
    ],
    "post-update-cmd": [
      "Pimcore\\Composer::postUpdate",
      "@pimcore-scripts",
      "Pimcore\\Composer::executeMigrationsUp",
      "@pimcore-scripts"
    ],
    "pimcore-scripts": [
      "Pimcore\\Composer::clearCache",
      "Pimcore\\Composer::installAssets"
    ]
  },
  "extra": {
    "symfony-app-dir": "app",
    "symfony-bin-dir": "bin",
    "symfony-var-dir": "var",
    "symfony-web-dir": "web",
    "symfony-tests-dir": "tests",
    "symfony-assets-install": "relative",
    "merge-plugin": {
      "include": [
        "composer.local.json"
      ],
      "recurse": true,
      "replace": true,
      "merge-dev": true,
      "merge-extra": false,
      "merge-extra-deep": false,
      "merge-scripts": false
    }
  }
}
