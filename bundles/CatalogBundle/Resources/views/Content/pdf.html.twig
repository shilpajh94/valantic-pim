{% if parentContainer is not defined %}
        {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
<div class="template pdf-page coverPage1">
    <div class="">
        {% if editmode %}
            <div class="error" >Warning: a minimum 300 dpi is file is required.</div>
        {% endif %}
            <div class="template without-header areaPdf">
                {% if editmode %}
                    {{ pimcore_pdf("pdf", {'placeholder': 'PDF drop'})}}
                {% else %}
                    {% showPDFInput %}
                        {{ pimcore_pdf("pdf", {'placeholder': 'PDF drop'})}}
                    {% else %}
                        {% set element = pimcore_pdf("pdf").getElement() %}
                        {% if element %}
                            {% set path = getAssetFullPathCompatibleToS3(element) %}
                            <div id="pimcore-pdf" class="pimcore-pdfViewer">
                                <a href="{{path}}" target="_blank">
                                    <img alt="" src="{{path}}">
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>
    </div>
</div>

<style>

#pimcore-pdf img{ max-width:100%; height:auto;}

.coverPage1{
 page: title80;

break-after: avoid;
break-before: avoid;
}

 .coverPage1 .footer2 {
        display: none;
        text-align: left;
        position: running(footer2);

    }
.coverPage1 .footer3 {
        display: none;
        text-align: left;
        position: running(footer3);
    }

@page title80{
   
content: counter(0);
@top-right-corner{
 content: "";
}
@top-left-corner{
 content: "";

}
@top-right{content: "";}

}

@page title80:left {
        @bottom-center {
            content: element(footer2);
            z-index: 1;
        }
}

@page title80:right{
        @bottom-center {
            content: element(footer3);
            z-index: 1;
        }
}

</style>

{% endblock %}