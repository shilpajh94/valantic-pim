<html>
   <head>
      <meta charset="{{ _charset }}" />
      <title>An Error Occurred: {{ status_text }}</title>
   </head>
   <style>
body{
background-color: #E0E1E2 !important;
height: 100% !important;
text-align: center !important;
}
</style>
 <body>
   <div class="container">
      <div class="row">
         <div class="col-md-12">
            <div class="error-template">
               <h1>
                  Oops!</h1>
               <h2>
                  {{ status_code }} Not Found</h2>
               <div class="error-details">
                  Sorry, an error has occured, Requested page not found!
               </div>
               <div class="error-actions">
                  <a href="{{  app.request.getSchemeAndHttpHost()  }}" class="btn btn-primary btn-lg" target="_blank"><span class="glyphicon glyphicon-home"></span>Home </a>
               </div>
            </div>
         </div>
      </div>
   </div>
</body>
</html>
