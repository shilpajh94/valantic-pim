									{% set section_page_pts_belts_compatibility = section_page_pts_belts_compatibility .setDataFromResource('Compatible fittings')%}
								{% endif %} #}
								<b>
									{{section_page_pts_belts_compatibility|raw}}
								</b>
								{{section_page_pts_belts_export_details|raw}}

							</div>
						</div>
					</footer>
				</div>

				{% if not editmode %}
