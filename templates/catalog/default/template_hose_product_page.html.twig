{% if not isParentContainerRequest %}
	{% extends "catalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	{% if editmode %}
		{{ pimcore_relation("inh_template_hose_product_page", {
            "types": ["object"],
            "subtypes": {
                "object": ["object"]
            },
            "classes": ["CatalogTables"]
        })}}
	{% endif %}
		<style>
	    table.extreme_temperature__product_page > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height: 40px;
 }
	</style>

	{% if data is defined and data %}
		{% set partNumbers = [] %}
		{% set incr = 0 %}
		{% set incr2 = 0 %}

		{% for catalogGroupKey, catalogGroupData in data %}
			{% for md5key, brandData in catalogGroupData %}
				<div class="template">
					<section class="segregate">
						<div id="pageHeader"></div>
						<span class="pageName">
							{% if editmode %}
								{% if pimcore_input("HHPP_Header_" ~ md5key ~ "_" ~ incr).isEmpty() %}
									{{ pimcore_input("HHPP_Header_" ~ md5key ~ "_" ~ incr).setDataFromResource('Hydraulic Hose') | raw }}
								{% else %}
									{{ pimcore_input("HHPP_Header_" ~ md5key ~ "_" ~ incr) }}
								{% endif %}
							{% else %}
								{{ pimcore_input("HHPP_Header_" ~ md5key ~ "_" ~ incr) }}
							{% endif %}
						</span>

						<div class="footer">
							<footer class="flex-center {{ footer_class }}">
								<span class="logo">
									<b>
										{% if editmode %}
											{% if pimcore_input("HHPP_Logo_Text1_" ~ md5key ~ "_" ~ incr).isEmpty() %}
												{{ pimcore_input("HHPP_Logo_Text1_" ~ md5key ~ "_" ~ incr).setDataFromResource('Hose') | raw}}
											{% else %}
												{{ pimcore_input("HHPP_Logo_Text1_" ~ md5key ~ "_" ~ incr) }}
											{% endif %}
										{% else %}
											{{ pimcore_input("HHPP_Logo_Text1_" ~ md5key ~ "_" ~ incr) }}
										{% endif %}
									</b>
									<img src="{{ footer_logo_src }}">
								</span>
								<div class="flex aligned">
									<h5>
										{% if editmode %}
											{% if pimcore_input("HHPP_Footer_BrandName_" ~ md5key ~ "_" ~ incr).isEmpty() %}
                                                {% if brandData['brandName'][0] is defined %}
                                                    {{ pimcore_input("HHPP_Footer_BrandName_" ~ md5key ~ "_" ~ incr).setDataFromResource(brandData['brandName'][0]) | raw}}
                                                {% else %}
                                                    {{ pimcore_input("HHPP_Footer_BrandName_" ~ md5key ~ "_" ~ incr).setDataFromResource(brandData['brandName']) | raw}}
                                                {% endif %}
											{% else %}
												{{ pimcore_input("HHPP_Footer_BrandName_" ~ md5key ~ "_" ~ incr) }}
											{% endif %}
										{% else %}
											{{ pimcore_input("HHPP_Footer_BrandName_" ~ md5key ~ "_" ~ incr) }}
										{% endif %}

										<span>
											{% if editmode %}
												{% if pimcore_input("HHPP_Footer_HoseType_" ~ md5key ~ "_" ~ incr).isEmpty() %}
													{{ pimcore_input("HHPP_Footer_HoseType_" ~ md5key ~ "_" ~ incr).setDataFromResource(catalogGroupKey) | raw}}
												{% else %}
													{{ pimcore_input("HHPP_Footer_HoseType_" ~ md5key ~ "_" ~ incr) }}
												{% endif %}
											{% else %}
												{{ pimcore_input("HHPP_Footer_HoseType_" ~ md5key ~ "_" ~ incr).setDataFromResource(catalogGroupKey) | raw}}
											{% endif %}
										</span>
									</h5>

									<div class="compatible">
										<b>
											{% if editmode %}
												{% if pimcore_input("HHPP_Footer_Compatibility_" ~ md5key ~ "_" ~ incr).isEmpty() %}
													{{ pimcore_input("HHPP_Footer_Compatibility_" ~ md5key ~ "_" ~ incr).setDataFromResource('') | raw}}
												{% else %}
													{{ pimcore_input("HHPP_Footer_Compatibility_" ~ md5key ~ "_" ~ incr) }}
												{% endif %}
											{% else %}
												{{ pimcore_input("HHPP_Footer_Compatibility_" ~ md5key ~ "_" ~ incr) }}
											{% endif %}
										</b>

                                        {% if brandData['brandName'][0] is defined %}
                                            {% set compatibility_description = "" %}
                                        {% else %}
                                            {% set compatibility_description = "" %}
                                        {% endif %}
										{% if editmode %}
											{% if pimcore_wysiwyg("HHPP_Footer_Compatibility_Description_" ~ md5key ~ "_" ~ incr).isEmpty() %}
												{{ pimcore_wysiwyg("HHPP_Footer_Compatibility_Description_" ~ md5key ~ "_" ~ incr, {"width": 100,"placeholder" : "eg: Enter Text"}).setDataFromResource(compatibility_description) | raw}}
											{% else %}
												{{ pimcore_wysiwyg("HHPP_Footer_Compatibility_Description_" ~ md5key ~ "_" ~ incr) }}
											{% endif %}
										{% else %}
											{{ pimcore_wysiwyg("HHPP_Footer_Compatibility_Description_" ~ md5key ~ "_" ~ incr) }}
										{% endif %}
									</div>
								</div>
							</footer>
						</div>

						<div class="footer1">
							<footer class="flex-center {{ footer_class }}">
								<div class="flex aligned">
									<div class="compatible">
										<b>
											{% if editmode %}
												{% if pimcore_input("HHPP_Footer_Compatibility1_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
													{{ pimcore_input("HHPP_Footer_Compatibility1_" ~ md5key ~ "_" ~ incr2).setDataFromResource('') | raw}}
												{% else %}
													{{ pimcore_input("HHPP_Footer_Compatibility1_" ~ md5key ~ "_" ~ incr2) }}
												{% endif %}
											{% else %}
												{{ pimcore_input("HHPP_Footer_Compatibility1_" ~ md5key ~ "_" ~ incr2) }}
											{% endif %}
										</b>

										{% if editmode %}
											{% if pimcore_wysiwyg("HHPP_Footer_Compatibility_Description1_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
												{{ pimcore_wysiwyg("HHPP_Footer_Compatibility_Description1_" ~ md5key ~ "_" ~ incr2, {"width": 100,"placeholder" : "eg: Enter Text"}).setDataFromResource(compatibility_description) | raw}}
											{% else %}
												{{ pimcore_wysiwyg("HHPP_Footer_Compatibility_Description1_" ~ md5key ~ "_" ~ incr2) }}
											{% endif %}
										{% else %}
											{{ pimcore_wysiwyg("HHPP_Footer_Compatibility_Description1_" ~ md5key ~ "_" ~ incr2) }}
										{% endif %}
									</div>
									<h5>
										{% if editmode %}
											{% if pimcore_input("HHPP_Footer_BrandName1_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
                                                {% if brandData['brandName'][0] is defined %}
                                                    {{ pimcore_input("HHPP_Footer_BrandName1_" ~ md5key ~ "_" ~ incr2).setDataFromResource(brandData['brandName'][0]) | raw}}
                                                {% else %}
                                                    {{ pimcore_input("HHPP_Footer_BrandName1_" ~ md5key ~ "_" ~ incr2).setDataFromResource(brandData['brandName']) | raw}}
                                                {% endif %}								
											{% else %}
												{{ pimcore_input("HHPP_Footer_BrandName1_" ~ md5key ~ "_" ~ incr2) }}
											{% endif %}
										{% else %}
											{{ pimcore_input("HHPP_Footer_BrandName1_" ~ md5key ~ "_" ~ incr2) }}
										{% endif %}

										<span>
											{% if editmode %}
												{% if pimcore_input("HHPP_Footer_HoseType1_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
													{{ pimcore_input("HHPP_Footer_HoseType1_" ~ md5key ~ "_" ~ incr2).setDataFromResource(catalogGroupKey) | raw}}
												{% else %}
													{{ pimcore_input("HHPP_Footer_HoseType1_" ~ md5key ~ "_" ~ incr2) }}
												{% endif %}
											{% else %}
												{{ pimcore_input("HHPP_Footer_HoseType1_" ~ md5key ~ "_" ~ incr2).setDataFromResource(catalogGroupKey) | raw}}
											{% endif %}
										</span>
									</h5>
								</div>
								<span class="logo">
									<b>
										{% if editmode %}
											{% if pimcore_input("HHPP_Logo_Text2_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
												{{ pimcore_input("HHPP_Logo_Text2_" ~ md5key ~ "_" ~ incr2).setDataFromResource('Hose') | raw}}
											{% else %}
												{{ pimcore_input("HHPP_Logo_Text2_" ~ md5key ~ "_" ~ incr2) }}
											{% endif %}
										{% else %}
											{{ pimcore_input("HHPP_Logo_Text2_" ~ md5key ~ "_" ~ incr2) }}
										{% endif %}
									</b>
									<img src="{{ footer_logo_src }}">
								</span>
							</footer>
						</div>
						<header class="content white productHeadingProductPage">
							<h1>
								{% if editmode %}
									{% if pimcore_input("HHPP_Heading_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
                                        {% if brandData['brandName'][0] is defined %}
                                            {{ pimcore_input("HHPP_Heading_" ~ md5key ~ "_" ~ incr2).setDataFromResource(brandData['brandName'][0]) | raw}}
                                        {% else %}
                                            {{ pimcore_input("HHPP_Heading_" ~ md5key ~ "_" ~ incr2).setDataFromResource(brandData['brandName']) | raw}}
                                        {% endif %}
									{% else %}
										{{ pimcore_input("HHPP_Heading_" ~ md5key ~ "_" ~ incr2) }}
									{% endif %}
								{% else %}
									{{ pimcore_input("HHPP_Heading_" ~ md5key ~ "_" ~ incr2) }}
								{% endif %}
							</h1>
							<aside>
								<p>
									{{brandData['longDescription'] | striptags}}
								</p>
								{% if editmode %}
										<img src="{{ getImageThumbnail(brandData['LeftPrintCatalogImageObj'], imageWidth) }}" class="leftImg" width="600" height="200"/>
										<img src="{{ getImageThumbnail(brandData['RightPrintCatalogImageObj'], imageWidth) }}" class="rightImg" width="600" height="200"/>
								{% else %}
									{% set imgSrcObj1 = pimcore_image("HHPP_Image_Left_" ~ md5key ~ "_" ~ incr2, {"class": "leftImg", "width": 600, "height": 200}) %}
									{% if imgSrcObj1 %}
										<img src="{{ getImageThumbnail(brandData['LeftPrintCatalogImageObj'], imageWidth) }}" class="leftImg" width="600" height="200"/>
									{% endif %}

									{% set imgSrcObj2 = pimcore_image("HHPP_Image_Right_" ~ md5key ~ "_" ~ incr2, {"class": "rightImg", "width": 600, "height": 200}) %}
									{% if imgSrcObj2 %}
										<img src="{{ getImageThumbnail(brandData['RightPrintCatalogImageObj'], imageWidth) }}" class="rightImg" width="600" height="200"/>
									{% endif %}
								{% endif %}
							</aside>
						</header>
						<article class="fullcontainer">
							<section class="content single">
								{% if brandData['safetyFeatures'] or brandData['standardMetHoseListData'] or brandData['tubeMaterialAtrributeString'] or brandData['reinforcement'] or brandData['coverMaterialattributeString'] or brandData['temperatureRangeFAndC'] %}
									<menu class="flex">
										{% if brandData['standardMetHoseListData'] or brandData['tubeMaterialAtrributeString'] or brandData['reinforcement'] or brandData['coverMaterialattributeString'] or brandData['temperatureRangeFAndC'] %}
											<div class="specs">
												<h6>{{ 'specs'|trans }}</h6>
												<div class="spec-requirement">
													{% if brandData['standardMetHoseListData'] or brandData['standardMetHoseMeetFlameResistence'] %}
														<div class="col-6">
															<div class="standard-hose-met">
																{% if brandData['standardMetHoseListData']|length > 0 %}
																	{% if editmode %}
																		{% if pimcore_input("meetPerformanceRequirements_" ~ md5key ~ "_" ~ incr2).isEmpty() %}
																			{{ pimcore_input("meetPerformanceRequirements_" ~ md5key ~ "_" ~ incr2).setDataFromResource("Meets or exceeds the performance requirements of:") | raw}}
																		{% else %}
																			{{ pimcore_input("meetPerformanceRequirements_" ~ md5key ~ "_" ~ incr2) }}
																		{% endif %}
																	{% else %}
																		{{ pimcore_input("meetPerformanceRequirements_" ~ md5key ~ "_" ~ incr2) }}
																	{% endif %}
																{% endif %}
																<br/>
																{% set hoseMetCount = 0 %}
																{% for key, standard in brandData['standardMetHoseListData'] %}
																	<div class="is-highlight">
																		{{ pimcore_input("standardMetHose" ~ md5key ~ "_" ~ hoseMetCount ~ "_" ~ incr2).setDataFromResource(standard['name']) | raw}}
																	</div>
																	{% set hoseMetCount = hoseMetCount + 1 %}
																{% endfor %}
															</div>

															<div class="standard-hose-met-flame">
																{% set hoseMetFlameCount = 1 %}
																{% for key, standard2 in brandData['standardMetHoseMeetFlameResistence'] %}
																	{% if editmode %}
																		{% if pimcore_input("standardMetHoseFlameResistenceLabel" ~ md5key ~ "_" ~ hoseMetFlameCount).isEmpty() %}
																			{{ pimcore_input("standardMetHoseFlameResistenceLabel" ~ md5key ~ "_" ~ hoseMetFlameCount).setDataFromResource(standard2['CustomerFacingVersion']) | raw}}
																		{% else %}
																			{{ pimcore_input("standardMetHoseFlameResistenceLabel" ~ md5key ~ "_" ~ hoseMetFlameCount) }}
																		{% endif %}
																	{% else %}
																		{{ pimcore_input("standardMetHoseFlameResistenceLabel" ~ md5key ~ "_" ~ hoseMetFlameCount) }}
																	{% endif %}

																	<div class="is-highlight">
																		{{ pimcore_input("standardMetHoseFlameResistence" ~ md5key ~ "_" ~ hoseMetFlameCount).setDataFromResource(standard2['name']) | raw}}
																	</div>
																	{% set hoseMetFlameCount = hoseMetFlameCount + 1 %}
																{% endfor %}
															</div>

															<div class="custom-specs-text">
																{{ pimcore_wysiwyg("customSpecsText" ~ md5key ~ "_" ~ incr2) }}
															</div>
														</div>
													{% endif %}
													<div class="col-6">
														{% if brandData['tubeMaterialAtrributeString'] %}
															<div class="full">
																<b>{{ 'Inner Tube'|trans }}</b>
																{{ brandData['tubeMaterialAtrributeString'] | raw}}
															</div>
														{% endif %}

														{% if brandData['reinforcement'] %}
															<div class="full">
																<b>{{ 'Reinforcement'|trans }}</b>
																{{ brandData['reinforcement'] | raw}}
															</div>
														{% endif %}

														{% if brandData['coverMaterialattributeString'] %}
															<div class="full">
																<b>{{ 'Cover'|trans }}</b>
																{{ brandData['coverMaterialattributeString'] | raw}}
															</div>
														{% endif %}

														{% if brandData['temperatureRangeFAndC'] %}
															<div class="full">
																<b>{{ 'Temperature Range'|trans }}</b>
																{{ brandData['temperatureRangeFAndC'] | raw}}
															</div>
														{% endif %}
													</div>
												</div>
											</div>
										{% endif %}

										{% if brandData['safetyFeatures'] %}
											<div class="feature">
												<h6>{{ 'features'|trans }}</h6>
												<div>
													{% for key, feature in brandData['safetyFeatures'] %}
														<p class="flex">
															{% if feature['iconSrc'] %}
															{{feature['iconSrc']}}
																<img src="{{ feature['iconSrc'] }}"/>
															{% endif %}
															<font>{{ feature['name'] | raw}}</font>
														</p>
													{% endfor %}
												</div>
											</div>
										{% endif %}
									</menu>
								{% endif %}

								{% if brandData['BrandingLayline'] %}
									<menu>
										<h6>{{ 'branding'|trans }}</h6>
										<figure class="brandingLaylineStyle">
											<figcaption>{{ brandData['BrandingLayline'] | raw }}</figcaption>
										</figure>
									</menu>
								{% endif %}

								{% set columnList = [] %}
								<table cellpadding="0" cellspacing="0" class="grid continueLable  {{table_class}}">
									<thead>
										{% if brandData['iconRequired'] == 'YES' %}
											<tr class="sub-head">
												{% for key, c1data in brandData['columnsDataWithImages'] %}
													{% set columnWidth = '' %}
													{% set g1count = c1data|length %}
													{% set firstArray = c1data|first %}
													{% if firstArray['columnWidth'] %}
														{% set columnWidth = "width=" ~ firstArray['columnWidth'] %}
													{% endif %}
													<td colspan="{{ g1count }}" {{ columnWidth }}>
														{% if ( firstArray['columnIcon'] is defined and firstArray['columnIcon']) %}
															<img src="{{ firstArray['columnIcon'] }}" width="45" height="45"/>
														{% endif %}
													</td>
												{% endfor %}
											</tr>
										{% endif %}

										<tr class="head">
											{% for key, c2data in brandData['columnsDataWithImages'] %}
												{% set columnWidth = '' %}
												{% set g2count = c2data|length %}
												{% set first2Array = c2data|first %}
												{% if first2Array['columnWidth'] %}
													{% set columnWidth = "width=" ~ first2Array['columnWidth'] %}
												{% endif %}
												<td colspan="{{ g2count }}" {{ columnWidth }}>
													{{first2Array['columnLabel']}}
												</td>
											{% endfor %}
										</tr>

										{% if brandData['subHeaderRequired'] == 'YES' %}
											<tr class="sub-head">
												{% for key, c3data in brandData['columnsDataWithImages'] %}
													{% for c3key, c3value in c3data %}
														{% set columnList = columnList|merge([c3key]) %}
														{% if c3value['unitName'] %}
															<td>
																{{c3value['unitName']}}
															</td>
														{% else %}
															<td></td>
														{% endif %}
													{% endfor %}
												{% endfor %}
											</tr>
										{% endif %}
									</thead>

									{% set incrRow = 1 %}
									{% for key, element in brandData['articlesData'] %}
										{% set isEven = incrRow is even %}
										<tr class="{{ isEven ? 'tableNewFont' : 'active tableNewFont' }}">
											{% if 'descriptive' in columnList %}
												{% set columnKey = null %}
												{% for key, value in columnList %}
													{% if value == 'descriptive' %}
														{% set columnKey = key %}
													{% endif %}
												{% endfor %}
												{% set descriptiveNumberText = element[columnKey] %}
												{% set descriptiveNumberList = descriptiveNumberText | split('-') %}

												{% if descriptiveNumberList[0] not in partNumbers %}
													{% set partNumbers = partNumbers|merge([descriptiveNumberList[0]]) %}
												{% endif %}
											{% endif %}

											{% for ekey, value in element %}
												<td>{{ value }}</td>
											{% endfor %}
										</tr>
										{% set incrRow = incrRow + 1 %}
									{% endfor %}
								</table>

								<p class="small">{{ pimcore_input("customer_data_" ~ md5key ~ "_" ~ incr2, {'placeholder': 'Enter comment'}) }}</p>
							</section>
						</article>
					</section>
				</div>
			{% endfor %}
		{% endfor %}

		<div class="hide">
			{% if partNumbers|length > 0 %}
				{{ pimcore_textarea('product_page_part_number').setDataFromResource(partNumbers|join(',')) | raw}}
			{% endif %}
		</div>

		{% if not isParentContainerRequest %}
			<script type="text/javascript" src="/static/js/tableContinueLable.js"></script>
		{% endif %}
	{% endif %}
{% endblock %}