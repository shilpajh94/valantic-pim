{% if not isParentContainerRequest %}
	{% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	{% if editmode %}
		{{ pimcore_relation("inh_fitting_page", {
        "types": ["object"],
        "subtypes": {
            "object": ["object"]
        },
        "classes": ["CatalogTables"]
    }) }}
	{% endif %}

	{% if groupData is defined and groupData %}

		{% set industrial_hose_data = [] %}

		{% set industrial_hose_data = industrial_hose_data | merge({ (groupData.siop3Category ~ ": " ~ groupData.siop4Category): [groupData.brandName] }) %}

		<div class="template">
			<div class="segregate inh inhSettingFitting">
				<div id="pageHeader"></div>
				<span class="pageName">
					{{ groupData.siop3Category ~ " - " ~ groupData.siop4Category }}
				</span>

				<div class="footer">
					<footer class="flex-center {{ footer_class }}">
						<span class="logo">
							<img src="{{ footer_logo_src }}">
						</span>
						<div class="flex aligned">
							<h5>
								{% if editmode %}
									{% if pimcore_input("INH_FITTING_FOOTER_BRAND_", {'placeholder': 'Enter Brand'}).isEmpty() %}
										{{ pimcore_input("INH_FITTING_FOOTER_BRAND_", {'placeholder': 'Enter Brand'}).setDataFromResource(groupData.brandName) | raw }}
									{% else %}
										{{ pimcore_input("INH_FITTING_FOOTER_BRAND_", {'placeholder': 'Enter Brand'}) }}
									{% endif %}
								{% else %}
									{{ pimcore_input("INH_FITTING_FOOTER_BRAND_", {'placeholder': 'Enter Brand'}) }}
								{% endif %}
								<span>
									{% if editmode %}
										{% if pimcore_input("INH_FITTING_FOOTER_HP_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}).isEmpty() %}
											{{ pimcore_input("INH_FITTING_FOOTER_HP_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}).setDataFromResource(groupData.siop3Category ~ "/" ~ groupData.siop4Category) | raw }}
										{% else %}
											{{ pimcore_input("INH_FITTING_FOOTER_HP_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}) }}
										{% endif %}
									{% else %}
										{{ pimcore_input("INH_FITTING_FOOTER_HP_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}) }}
									{% endif %}
								</span>
							</h5>
						</div>
					</footer>
				</div>

				<div class="footer1">
					<footer class="flex-center {{ footer_class }}">
						<div class="flex aligned">
							<h5>
								{% if editmode %}
									{% if pimcore_input("INH_FITTING_FOOTER_BRAND1_", {'placeholder': 'Enter Brand'}).isEmpty() %}
										{{ pimcore_input("INH_FITTING_FOOTER_BRAND1_", {'placeholder': 'Enter Brand'}).setDataFromResource(groupData.brandName) | raw }}
									{% else %}
										{{ pimcore_input("INH_FITTING_FOOTER_BRAND1_", {'placeholder': 'Enter Brand'}) }}
									{% endif %}
								{% else %}
									{{ pimcore_input("INH_FITTING_FOOTER_BRAND1_", {'placeholder': 'Enter Brand'}) }}
								{% endif %}
								<span>
									{% if editmode %}
										{% if pimcore_input("INH_FITTING_FOOTER_HP1_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}).isEmpty() %}
											{{ pimcore_input("INH_FITTING_FOOTER_HP1_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}).setDataFromResource(groupData.siop3Category ~ "/" ~ groupData.siop4Category) | raw }}
										{% else %}
											{{ pimcore_input("INH_FITTING_FOOTER_HP1_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}) }}
										{% endif %}
									{% else %}
										{{ pimcore_input("INH_FITTING_FOOTER_HP1_", {'placeholder': 'SIOP 3 Category / SIOP 4 Category'}) }}
									{% endif %}
								</span>
							</h5>
						</div>
						<span class="logo">
							<img src="{{ footer_logo_src }}">
						</span>
					</footer>
				</div>

				<article class="fullcontainer single">
					<div class="inhsetting1">
						<div class="inhsetting-sidebar40">
							<div class=" sidebar">
								<ul>
									{% if groupData.categories is iterable %}
										{% for category in groupData.categories %}
											{% set first = "" %}
											{% if groupData.selectedCategory == category.mainCategory[0].name %}
												{% set first = "first" %}
											{% endif %}

											<li class="{{ first }}">
												{% if category.mainCategory[0].name is defined %}
													<p>
														<b>{{ category.mainCategory[0].name }}</b>
													</p>
												{% else %}
													<p></p>
												{% endif %}

												{% if category['subCategory'] is defined and category['subCategory'] is iterable and category['subCategory'] is not empty %}
													{% for k, cat in category['subCategory'] %}
														{% if cat['printable'] == 1 %}
															<p>{{cat['name']}}</p>
														{% endif %}
													{% endfor %}
												{% endif %}
											</li>
										{% endfor %}
									{% endif %}
								</ul>
							</div>
						</div>
					</div>

					<div class="inhRight">
						<header class="white">
							<h1 class="contitech-yellow">
								{% if editmode %}
									{% if pimcore_input("INH_Fitting_brandName", {'placeholder': 'Enter Brand'}).isEmpty() %}
										{{ pimcore_input("INH_Fitting_brandName", {'placeholder': 'Enter Brand'}).setDataFromResource(groupData['brandName']) | raw }}
									{% else %}
										{{ pimcore_input("INH_Fitting_brandName", {'placeholder': 'Enter Brand'}) }}
									{% endif %}
								{% else %}
									{{ pimcore_input("INH_Fitting_brandName", {'placeholder': 'Enter Brand'}) }}
								{% endif %}
							</h1>
							<aside class="ptgHead">
								<div>
									{% if editmode %}
										{% if pimcore_wysiwyg("INH_Fitting_LongDescription", {'placeholder': 'Enter Marketting Description'}).isEmpty() %}
											{{ pimcore_wysiwyg("INH_Fitting_LongDescription", {'placeholder': 'Enter Marketting Description'}).setDataFromResource(groupData['longDescription']) | raw }}
										{% else %}
											{{ pimcore_wysiwyg("INH_Fitting_LongDescription", {'placeholder': 'Enter Marketting Description'}) }}
										{% endif %}
									{% else %}
										{{ pimcore_wysiwyg("INH_Fitting_LongDescription", {'placeholder': 'Enter Marketting Description'}) }}
									{% endif %}
								</div>
								<span class="imageHolder">

									{% if editmode %}
										{% if not pimcore_image("INH_Fitting_MainImage").isEmpty() %}
											{{ pimcore_image("INH_Fitting_MainImage", {'width' : 400, 'height' : 200}) }}
										{% else %}
											{{ pimcore_image("INH_Fitting_MainImage", {"width" : 400, "height" : 200}).setImage(groupData['mainImageObj']) | raw }}
										{% endif %}
									{% else %}
										{% if not pimcore_image("INH_Fitting_MainImage").isEmpty() %}
											{% set imgSrcObj1 = pimcore_image("INH_Fitting_MainImage") %}
											{% if imgSrcObj1 %}
												<img src="{{getImageThumbnail(imgSrcObj1, imageWidth)}}" width="400" height="200"/>
											{% endif %}
										{% endif %}
									{% endif %}

									{% if editmode %}
										{% if not pimcore_image("INH_Fitting_ProfileDimension").isEmpty() %}
											{{ pimcore_image("INH_Fitting_ProfileDimension", {"width" : 400, "height" : 200}) }}
										{% else %}
											{{ pimcore_image("INH_Fitting_ProfileDimension", {"width" : 400, "height" : 200}).setImage(groupData['ProfileDimensionImageObj']) | raw }}
										{% endif %}
									{% else %}
										{% if not pimcore_image("INH_Fitting_ProfileDimension").isEmpty() %}
											{% set imgSrcObj2 = pimcore_image("INH_Fitting_ProfileDimension") %}
											{% if imgSrcObj2 %}
												<img src="{{getImageThumbnail(imgSrcObj2, imageWidth)}}" width="400" height="200"/>
											{% endif %}
										{% endif %}
									{% endif %}
								</span>
							</aside>
						</header>
						<section class="content">
							{% if groupData['safetyFeatures'] or groupData['material'] or groupData['pressureRating'] or groupData['brandingLayline'] or groupData['orderCodes'] %}
								<menu class="flex">
									{% if groupData['material'] or groupData['pressureRating'] or groupData['brandingLayline'] or groupData['orderCodes'] %}
										<div class="specs col-6">
											<h6>{{ 'specs'|trans }}</h6>
											<div class="spec-requirement">
												<div>
													{% if groupData['material'] %}
														<div class="full">
															<b>{{ 'Materials'|trans }}</b>
															{{ groupData['material'] }}
														</div>
													{% endif %}

													{% if groupData['pressureRating'] %}
														<div class="full">
															<b>{{ 'Pressure Rating'|trans }}</b>
															{{ groupData['pressureRating'] }}
														</div>
													{% endif %}

													{% if groupData['brandingLayline'] %}
														<div class="full">
															<b>{{ 'Branding'|trans }}</b>
															{{ groupData['brandingLayline'] }}
														</div>
													{% endif %}

													{% if groupData['orderCodes'] %}
														<div class="full">
															<b>{{ 'Order Codes'|trans }}</b>
															{{ groupData['orderCodes'] }}
														</div>
													{% endif %}
												</div>
											</div>
										</div>
									{% endif %}

									{% if groupData['safetyFeatures'] %}
										<div class="feature col-6">
											<h6>{{ 'features'|trans }}</h6>
											<div>
												{% for key, feature in groupData['safetyFeatures'] %}
													<p class="flex">
														{% if feature['iconSrc'] %}
															<img src="{{ feature['iconSrc'] }}"/>
														{% endif %}
														<font>{{ feature['name'] }}</font>
													</p>
												{% endfor %}
											</div>
										</div>
									{% endif %}
								</menu>
							{% endif %}

							{% if groupData['data'] %}
								<table class="grid special inh continueLable" cellspacing="0" cellpadding="0">
									<thead>
										{% if groupData['iconRequired'] == 'YES' %}
											<tr class="sub-head">
												{% for key, c1data in groupData['columnsDataWithImages'] %}
													{% set columnWidth = '' %}
													{% set firstArray = c1data|first %}
													{% if firstArray['columnWidth'] %}
														{% set columnWidth = 'width=' ~ firstArray['columnWidth'] %}
													{% endif %}
													<td colspan="{{ c1data|length }}" {{ columnWidth }}><img src="{{ firstArray['columnIcon'] }}" width="45" height="45"/></td>
												{% endfor %}
											</tr>
										{% endif %}

										<tr class="head">
											{% for key, c2data in groupData['columnsDataWithImages'] %}
												{% set columnWidth = '' %}
												{% set first2Array = c2data|first %}
												{% if first2Array['columnWidth'] %}
													{% set columnWidth = 'width=' ~ first2Array['columnWidth'] %}
												{% endif %}
												<td colspan="{{ c2data|length }}" {{ columnWidth }}>{{ first2Array['columnLabel'] }}</td>
											{% endfor %}
										</tr>

										{% if groupData['subHeaderRequired'] == 'YES' %}
											<tr class="sub-head">
												{% for key, c3data in groupData['columnsDataWithImages'] %}
													{% for c3key, c3value in c3data %}
														{% if c3value['unitName'] %}
															<td>{{ c3value['unitName'] }}</td>
														{% else %}
															<td></td>
														{% endif %}
													{% endfor %}
												{% endfor %}
											</tr>
										{% endif %}
									</thead>
									<tbody>
										{% if groupData['data'] is defined and groupData['data'] is iterable %}
											{% set incrRow = 1 %}
											{% for key, element in groupData['data'] %}
												{% if incrRow % 2 == 0 %}
													<tr class='tableNewFont'>
													{% else %}
														<tr class="active tableNewFont">
														{% endif %}
														{% for ekey, value in element %}
															<td>{{ value }}</td>
														{% endfor %}
													</tr>
													{% set incrRow = incrRow + 1 %}
												{% endfor %}
											{% endif %}
										</tbody>
									</tbody>
								</table>
							{% endif %}
							<p class="small">{{ pimcore_input('INH_Fitting_Comment', {'placeholder': 'Enter comment'}) }}</p>
						</section>
					</div>
				</article>
			</div>

			<div class="hide">

				{% set industrial_hose_data_list = [] %}
				{% if industrial_hose_data %}
					{% for key, value in industrial_hose_data %}
						{% set mergeData = key ~ '$$' ~ value|join(',') %}
						{% set industrial_hose_data_list = industrial_hose_data_list|merge([mergeData]) %}
					{% endfor %}

					{% if industrial_hose_data_list %}
						{% set industrial_hose_details_text = implodePHP_EOL(industrial_hose_data_list) %}
						{{ pimcore_textarea('industrial_hose_details').setDataFromResource(industrial_hose_details_text)| raw }}
					{% endif %}
				{% endif %}

			</div>
		</div>
		{% if not isParentContainerRequest %}
			<script type="text/javascript" src="/static/js/tableContinueLable.js"></script>
		{% endif %}
	{% endif %}
{% endblock %}