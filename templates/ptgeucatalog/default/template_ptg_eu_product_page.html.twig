{% if not isParentContainerRequest %}
	{% extends "ptgeucatalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

    {% if editmode %}
		{{ pimcore_relation("ptg_eu_product_page", {
                "types" : ["object"],
                "subtypes" : {
                "object" : ["object"]
                },
                "classes" : ["PTGEUCatalogCategory"],
        }) }}
	{% endif %}

    {% if groupData is defined and groupData %}
        <article class="template page-break-after-always">
            <span  class="pageName">
                {{ groupData['siop5Category'] }}
            </span>
            <div class="footer">
                <footer class="flex-center {{footer_class}}">
                    <span class="logo">
                            <img src="{{footer_logo_src}}" alt="footer image">
                    </span>
                    <div class="flex aligned ">
                        <h5>
                            {% if editmode %}
                                {% if pimcore_input("PTG_Footer_BrandName").isEmpty() %}
                                    {% if groupData['brandName'] %}
                                        {{ pimcore_input("PTG_Footer_BrandName").setDataFromResource(groupData['brandName']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_BrandName") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_BrandName") }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("PTG_Footer_BrandName") }}
                            {% endif %}
                    
                            <span>
                                {% if editmode %}
                                    {% if pimcore_input("PTG_Footer_HoseType").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_HoseType").setDataFromResource(groupData['siop5Category']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_HoseType") }}
                                    {% endif %}

                                    /
                                    
                                    {% if pimcore_input("PTG_Footer_HoseType2").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_HoseType2").setDataFromResource(groupData['siop6siop7Category']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_HoseType2") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_HoseType") }} / {{ pimcore_input("PTG_Footer_HoseType2") }}
                                {% endif %}
                            </span>
                        </h5>
                        <div class="sets">
                            <strong>
                                {% if editmode %}
                                    {% if pimcore_input("PTG_Footer_Compatibility").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_Compatibility").setDataFromResource('Compatible fittings') | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_Compatibility") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_Compatibility") }}
                                {% endif %}
                            </strong>
                                {% set  compatibility_description = "All fittings compatible with " ~ groupData['brandName'] ~ " are listed in Section 1 (starting on page 131)." %}
                                {% if editmode %}
                                    {% if pimcore_input("PTG_Footer_Compatibility_Description").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_Compatibility_Description").setDataFromResource(compatibility_description) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_Compatibility_Description") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_Compatibility_Description") }}
                                {% endif %}
                        </div>
                    </div>
                </footer>
            </div>

            <div class="footer1">
                <footer class="flex-center {{footer_class}}">
                    <div class="flex aligned ">
                        <div class="sets">
                            <strong>
                                {% if editmode %}
                                    {% if pimcore_input("PTG_Footer_Compatibility1").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_Compatibility1").setDataFromResource('Compatible fittings') | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_Compatibility1") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_Compatibility1") }}
                                {% endif %}
                            </strong>

                            {% set  compatibility_description = "All fittings compatible with " ~ groupData['brandName'] ~ " are listed in Section 1 (starting on page 131)." %}
                            {% if editmode %}
                                {% if pimcore_input("PTG_Footer_Compatibility1_Description").isEmpty() %}
                                    {{ pimcore_input("PTG_Footer_Compatibility1_Description").setDataFromResource(compatibility_description) | raw }}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_Compatibility1_Description") }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("PTG_Footer_Compatibility1_Description") }}
                            {% endif %}
                        </div>
                        <h5>
                            {% if editmode %}
                                {% if pimcore_input("PTG_Footer_BrandName1").isEmpty() %}
                                    {% if groupData['brandName'] %}
                                        {{ pimcore_input("PTG_Footer_BrandName1").setDataFromResource(groupData['brandName']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_BrandName1") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_BrandName1") }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("PTG_Footer_BrandName1") }}
                            {% endif %}

                            <span>
                                {% if editmode %}
                                    {% if pimcore_input("PTG_Footer_HoseType1").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_HoseType1").setDataFromResource(groupData['siop5Category']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_HoseType1") }}
                                    {% endif %}

                                    /
                                    
                                    {% if pimcore_input("PTG_Footer_HoseType3").isEmpty() %}
                                        {{ pimcore_input("PTG_Footer_HoseType3").setDataFromResource(groupData['siop6siop7Category']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("PTG_Footer_HoseType3") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("PTG_Footer_HoseType1") }} / {{ pimcore_input("PTG_Footer_HoseType3") }}
                                {% endif %}
                            </span>
                        </h5>
                    </div>

                    <span class="logo">
                            <img src="{{footer_logo_src}}" alt="footer image">
                    </span>
                </footer>
            </div>
                        
            <header class="content white">
                <h1>
                    {% if editmode %}
                        {% if pimcore_input("PTG_Heading").isEmpty() %}
                            {% if groupData['brandName'] %}
                                {{ pimcore_input("PTG_Heading").setDataFromResource(groupData['brandName']) | raw }}
                            {% else %}
                                {{ pimcore_input("PTG_Heading") }}
                            {% endif %}
                        {% else %}
                            {{ pimcore_input("PTG_Heading") }}
                        {% endif %}
                    {% else %}
                        {{ pimcore_input("PTG_Heading") }}
                    {% endif %}
                </h1>

                <aside class="row justify-between ">
                    <div class="col-8">
                        <p>{{groupData['longDescription'] | striptags}}</p>
                    </div>
                    <div class="col-4 d-flex flex-column">
                        <img src="{{getImageThumbnail(groupData['mainImageObj'], imageWidth)}}" width="200" height="200"/>
						<img src="{{getImageThumbnail(groupData['technicalDrawing1Obj'], imageWidth)}}" width="200" height="200"/>
                    </div>
                </aside>
            </header>

            <section class="content">
                {% if (groupData['safetyFeatures']) or (groupData['material']|trim is not empty) or (groupData['reinforcement']|trim is not empty) or (groupData['temperatureRange']|trim is not empty)%}
                    <menu class="flex">
                        {% if groupData['safetyFeatures'] is defined and groupData['safetyFeatures'] %}
                            <div class="feature mr-4">
                                <h6>{{'PTGEU_features'|trans}}</h6>
                                <div >
                                    {% for key, feature in groupData['safetyFeatures'] %}
                                        <p  class="flex center">
                                            {% if groupData['isAnyIconFeatureAvailable'] %}
                                                    {% if feature['iconSrc'] %}
                                                    <img src="{{feature['iconSrc']}}" alt=""/>
                                                    {% else %}
                                                            <span class="mr-40"></span>
                                                    {% endif %}
                                            {% endif %}
                                            <span class="ptb-5">{{feature['name']}}</span>
                                        </p>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {% if (groupData['material']|trim is not empty) or (groupData['reinforcement']|trim is not empty) or (groupData['temperatureRange']|trim is not empty) %}
                            <div class="specs">
                                <h6>{{'PTGEU_specs'|trans}}</h6>
                                <div>
                                    {% if groupData['material']|trim is not empty %}
                                            <p>
                                                    <strong>{{'PTGEU_Material'|trans}}</strong>
                                                    {{groupData['material']}}
                                            </p>
                                    {% endif %}
                                    
                                    {% if groupData['reinforcement']|trim is not empty %}
                                            <p>
                                                    <strong>{{'PTGEU_Reinforcement'|trans}}</strong>
                                                    {{groupData['reinforcement']}}
                                            </p>
                                    {% endif %}

                                    {% if groupData['temperatureRange']|trim is not empty %}
                                            <p>
                                                    <strong>{{'PTGEU_Temperature_Range'|trans}}</strong>
                                                    {{groupData['temperatureRange']}}
                                            </p>
                                    {% endif %}

                                    {% if groupData['heatAndOilResistant']|trim is not empty %}
                                            <p>
                                                    <strong>{{'PTGEU_HeatAndOilResistant'|trans}}</strong>
                                                    {{groupData['heatAndOilResistant']}}
                                            </p>
                                    {% endif %}

                                    {% if groupData['staticConductive']|trim is not empty %}
                                            <p>
                                                    <strong>{{'PTGEU_StaticConductivity'|trans}}</strong>
                                                    {{groupData['staticConductive']}}
                                            </p>
                                    {% endif %}

                                    {% if groupData['performance']|trim is not empty %}
                                            <p>
                                                    <strong>{{'PTGEU_Performance'|trans}}</strong>
                                                    {{groupData['performance']}}
                                            </p>
                                    {% endif %}
                                </div>
                            </div> 
                        {% endif %}
                    </menu>
                {% endif %}
                
                <div class="page-break-after-always"></div>
                {% for articleGroupKey, articleGroupData in groupData['data'] %}

                    <table aria-describedby="articleTable" class="table page-break-inside-always continueLable  {{table_class}}">
                        <thead>
                            {% if groupData['iconRequired'] == 'YES' %}
                                <tr>
                                    {% for key, c1data in groupData['columnsDataWithImages'] %}
                                        {% set columnWidth = '' %}
                                        {% set g1count = c1data|length %}
                                        {% set firstArray = c1data|first %}
                                        {% if firstArray['columnWidth'] %}
                                            {% set columnWidth = "width=" ~ firstArray['columnWidth'] %}
                                        {% endif %}
                                        <th scope="outer" colspan="{{g1count}}" {{columnWidth}}>
                                            {% if ( firstArray['columnIcon'] is defined and firstArray['columnIcon']) %}
                                                <img src="{{ firstArray['columnIcon'] }}" width="45" height="45" alt="icon image"/>
                                            {% endif %}
                                        </th>
                                    {% endfor %}
                                </tr>
                            {% endif %}

                            <tr class="border-bottom">
                                {% for key, c2data in groupData['columnsDataWithImages'] %}
                                    {% set columnWidth = '' %}
                                    {% set g2count = c2data|length %}
                                    {% set first2Array = c2data|first %}
                                    {% if first2Array['columnWidth'] %}
                                        {% set columnWidth = "width=" ~ first2Array['columnWidth'] %}
                                    {% endif %}
                                    <th scope="outer" colspan="{{ g2count }}" {{ columnWidth }}>
                                        {{first2Array['columnLabel']}}
                                    </th>
                                {% endfor %}
                            </tr>

                            {% if groupData['subHeaderRequired'] == 'YES' %}
                                <tr class="sub-head">
                                    {% for key, c3data in groupData['columnsDataWithImages'] %}
                                        {% for c3key, c3value in c3data %}
                                            {% if c3value['unitName'] %}
                                                <th scope="outer">
                                                    {{c3value['unitName']}}
                                                </th>
                                            {% else %}
                                                <th scope="outer"></th>
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}
                                </tr>
                            {% endif %}
                        </thead>

                        <tbody>
                            {% set incrRow = 1 %}
                            {% for key, element in articleGroupData %}
                                    {% if incrRow%2 == 0 %}
                                    <tr class = "tableNewFont">
                                    {% else %}
                                    <tr class="active tableNewFont">
                                    {% endif %}

                                            {% for ekey, value in element %}
                                                <td>{{ value }}</td>
                                            {% endfor %}
                                    </tr>
                                    {% set incrRow = incrRow + 1 %}
                            {% endfor %}
                        </tbody>
                    </table>
                {% endfor %}
            </section>
        </article>

        {% if not isParentContainerRequest %}
            <script type="text/javascript" src="/static/ptgeu/js/tableContinueLable.js"></script>
        {% endif %}
    {% endif %}     
{% endblock %}