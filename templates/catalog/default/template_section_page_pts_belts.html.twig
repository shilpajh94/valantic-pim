{% if not isParentContainerRequest %}
	{% extends "catalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
	<style>
		.cellAttributes table {
			padding: 0;
			border-spacing: 0;
		}
		.section-page-pts-belts-features {
			display: flex !important;
			padding-top: 15px;
			padding-left: 5px !important;
		}
		.section-page-pts-belts-features .full,
		.section-page-pts-belts-features b {
			font-size: 12px;
		}
		.section-page-pts-belts-features .features p {
			padding-left: 0 !important;
		}
		.section-page-pts-belts-features b {
			;
			/* padding-bottom: 5px; */
		}
		.features .center::before {
			color: transparent;
			content: ">";
			margin-right: 0;
			padding: 0 10px 10px;
			width: 10px;
			height: 10px;
			color: #ffa500;
		}
		.section-page-pts-belts-LongDescription {
			background-color: #f0f0f0;
			padding: 10px 30px;
		}
		.imageHolder.section-page-pts-belts-images,
		.belts-Identification-and-profile-dimension-container {
			display: flex !important;
			height: 100%;
			height: 200px;
		}
		.belts-Identification-and-profile-dimension-container {
			width: 70%;
		}
		.belts-Identification-and-profile-dimension-container,
		.section_page_pts_belts_table_container {

			margin-left: 15px;
		}
		.belts-Identification-and-profile-dimension-container img {
			height: 100px;
			width: 300px;
			display: inline-block;
			align-self: flex-end;
		}
		.section_page_pts_belts_Profile_Dimension_image {
			margin-left: 10px;
		}

		header aside.feature-benefits-and-images {
			background-color: transparent;
			margin-bottom: 20px;
		}
		thead .section-page-pts-belts-table-head {
			background-color: orange;
		}
		.section-page-pts-belts-table-body tr td {
			border: none;
			padding: 5px;
			text-align: center;
		}
		.section-page-pts-belts-table-head th {
			padding: 5px;
			word-break: break-word;
			font-size: 12px;
			text-align: center;
			font-weight: bold;
			word-wrap: break-all;
			text-wrap: normal;
			white-space: normal;
			border-bottom: 1px solid #737373;
			height: 30px;
		}
		.content-section table {
			border: 2px solid black;
			width: 70%;
			padding-bottom: 10px;
		}

		.section-page-pts-belts-page {
			position: relative;
		}
		.feature-benefits-and-images .content .flex {
			margin-top: 5px;
		}
		.feature-benefits-and-images .content .flex .specs h6 {
			padding-left: 0;
			font-size: 18px;
		}
		.section_page_pts_belts_Catalog_Asset_Right_Image {
			position: absolute;
			width: 350px;
			height: 300px;
			max-height: 400px;
			top: 380px;
			right: 30px;
		}
		#section_page_pts_belts_Catalog_Asset_Image {
			min-height: 100%;
			min-width: 100%;
		}
		.all-child-taxonomy {
			min-width: 100%;
			height: 50px;
			display: flex;
			align-items: center;
			/* justify-content: space-around; */
			transform: rotate(90deg) translate(50%, 460px);
		}
		.all-child-taxonomy p {
			border-bottom: 1px solid;
			border-left: 1px solid;
			border-right: none;
			border-top: 1px solid;
			padding: 10px;
			font-size: 12px;
			font-weight: bold;
		}
		.all-child-taxonomy p:last-child {

			border-right: 1px solid;
		}
		.all-child-taxonomy p {
			padding: 10px;
			letter-spacing: 1px;
		}
		.all-child-taxonomy .selected {
			background-color: black;
			color: #ffa500;
		}
		.section-page-pts-belts-page .segregate .content-section {
			margin-left: 35px;
		}
		.section-page-pts-belts-page .footer1 footer .aligned > * {
			text-align: left;
			justify-content: flex-start;
		}
		.pageName {
			/* string-set: pageName content(); */
			string-set: pageName self;
			font-size: 10px;
			font-family: 'ContinentalStagSansLCG-Book';
			letter-spacing: 0.05em;
			margin-left: 10px;
			left: 100px;
		}
		@page {
			margin: 50px 0 75px;
		}


		@page:right {
			@top-right-corner {
				padding-right: 50px;
				/* content: string(pageName); */
			}

			@top-left {
				content: counter(page);
				font-family: 'ContinentalStagSansLCG-Light';
				float: left;
				font-size: 10px;
				margin-left: 65px;
				z-index: 10;
				color: #000;
			}
			@top-right {
				content: string(pageName);
				font-family: 'ContinentalStagSansLCG-Light';
				float: right;
				font-size: 10px;
				margin-right: 50px;
				z-index: 10;
				color: #000;
			}
		}

		@page:left {

			@top-left-corner {
				content: counter(page);
				padding-left: 50px;
			}


		}

		@media print {
			.belts-Identification-and-profile-dimension-container img {
				height: 80px;
				width: 100px !important;
				display: inline-block;
				align-self: flex-end;
			}

			.section_page_pts_belts_Catalog_Asset_Right_Image {
				position: absolute;
				width: 350px;
				height: 300px;
				max-height: 400px;
				top: 450px;
				right: 10px;


			}
			.all-child-taxonomy {
				transform: rotate(90deg) translate(38%, 380px);
			}
			.section-page-pts-belts-page .segregate .content-section {
				margin-top: -50px;
			}
		}
	</style>
	{% if editmode %}
		{{ pimcore_relation("section_page_pts_belts", {
            "types": ["object"],
            "subtypes": {
                "object": ["object"]
            },
            "classes": ["CatalogPTS"],
			"reload": true
        }) }}
	{% endif %}
	{% if data is not empty %}
		<div class="template section-page-pts-belts-page">
			<section class="segregate">
				<div id="pageHeader"></div>
				<span class="pageName">
					{{ data.SIOPLEVEL3 }}
				</span>

				<div class="footer ">
					<footer class="flex-center {{ data.footer_class }}">
						<span class="logo">
							<img src="{{ data.footer_logo_src }}" alt="footer log">
						</span>
						<div class="flex aligned">
							{% set section_page_pts_belts_footer_brandName = pimcore_input("section_page_pts_belts_footer_brandName") %}
							{% if  section_page_pts_belts_footer_brandName.isEmpty() %}
								{% set section_page_pts_belts_footer_brandName = section_page_pts_belts_footer_brandName.setDataFromResource(data.brandName) %}
							{% endif %}
							<h5>
								{% if editmode %}
									#{{section_page_pts_belts_footer_brandName|raw }}
								{% else %}
									#{{section_page_pts_belts_footer_brandName|raw }}
								{% endif %}

								<span>
									{% set section_page_pts_belts_SIOP_level_3 = pimcore_input("section_page_pts_belts_SIOP_level_3") %}
									{% if  section_page_pts_belts_SIOP_level_3.isEmpty() %}
										{% set section_page_pts_belts_SIOP_level_3 = section_page_pts_belts_SIOP_level_3.setDataFromResource(data.SIOPLEVEL3) %}
									{% endif %}


									{% set section_page_pts_belts_SIOP_level_4 = pimcore_input("section_page_pts_belts_SIOP_level_4") %}
									{% if  section_page_pts_belts_SIOP_level_4.isEmpty() %}
										{% set section_page_pts_belts_SIOP_level_4 = section_page_pts_belts_SIOP_level_4.setDataFromResource(data.SIOPLEVEL4) %}

									{% endif %}
									{% if editmode %}
										#{{ section_page_pts_belts_SIOP_level_3 | raw}}
										#{{section_page_pts_belts_SIOP_level_4|raw}}
									{% else %}
										#{{ section_page_pts_belts_SIOP_level_3|raw }}
										#{{ section_page_pts_belts_SIOP_level_4|raw }}
									{% endif %}
								</span>
							</h5>

							<div class="compatible">
								{% set section_page_pts_belts_compatibility = pimcore_input("section_page_pts_belts_compatibility") %}
								{% if section_page_pts_belts_compatibility.isEmpty() %}
									{% set section_page_pts_belts_compatibility = section_page_pts_belts_compatibility .setDataFromResource('Compatible fittings')%}
								{% endif %}
								<b>
									Compatible #{{section_page_pts_belts_compatibility|raw}}
								</b>
								Details based on export?

							</div>
						</div>
					</footer>
				</div>


				{% if not editmode %}
					<div class="footer1 ">
						<footer class="flex-center {{ data.footer_class }}">
							<span class="logo">
								<img src="{{ data.footer_logo_src }}" alt="">
							</span>
							<div class="flex aligned">
								<h5>{{section_page_pts_belts_footer_brandName|raw }}
									<span>
										#{{ section_page_pts_belts_SIOP_level_3|raw}}
										{{section_page_pts_belts_SIOP_level_4|raw}}
									</span>
								</h5>

								<div class="compatible">
									{% set section_page_pts_belts_compatibility = pimcore_input("section_page_pts_belts_compatibility") %}
									{% if section_page_pts_belts_compatibility.isEmpty() %}
										{% set section_page_pts_belts_compatibility = section_page_pts_belts_compatibility .setDataFromResource('Compatible fittings')%}
									{% endif %}
									<b>
										Compatible #{{section_page_pts_belts_compatibility|raw}}
									</b>
									Details based on export?

								</div>
							</div>
						</footer>
					</div>
				{% endif %}
				<div class="content-container right-side-container">
					{% if data.SIOPCategories is not empty %}
						<div class="all-child-taxonomy">
							{% for SIOPCategory,selected in data.SIOPCategories %}
								<p class="{{selected}}">{{SIOPCategory}}</p>
							{% endfor %}
						</div>
					{% endif %}

					<div class="content-section">
						<header class="content white">
							<h1>
								{% set section_page_pts_belts_BrandName = pimcore_input("section_page_pts_belts_BrandName") %}

								{% if section_page_pts_belts_BrandName.isEmpty() %}
									{% set section_page_pts_belts_BrandName = section_page_pts_belts_BrandName.setDataFromResource(data.brandName) %}
								{% endif %}
								{% if editmode %}
									{{section_page_pts_belts_BrandName|raw}}
								{% else %}
									{{section_page_pts_belts_BrandName|raw}}
								{% endif %}
							</h1>
							<div class="section-page-pts-belts-LongDescription">
								{% set section_page_pts_belts_LongDescription = pimcore_wysiwyg("section_page_pts_belts_LongDescription") %}
								{% if  section_page_pts_belts_LongDescription.isEmpty() %}
									{% set section_page_pts_belts_LongDescription = section_page_pts_belts_LongDescription.setDataFromResource(data.longDescription) %}
								{% endif %}
								{% if editmode %}
									{{section_page_pts_belts_LongDescription|raw}}
								{% else %}
									{{section_page_pts_belts_LongDescription|raw}}
								{% endif %}
							</div>
							<aside
								class="feature-benefits-and-images">
								{# key feature and benifit start #}
								<section class="content single ptg">
									{% if data.FeaturesBenefitsBulletPoint or ((data.material)|trim is not empty) or ((data.reinforcement)|trim is not empty) or ((data.temperatureRangeFAndC)|trim is not empty) %}
										<menu
											class="flex">
											{# {% if groupData['safetyFeatures'] %} #}
											<div class="specs">
												<h6>{{ 'section_page_pts_belts_features'|trans }}</h6>
												<div class="section-page-pts-belts-features ">
													<div class="features">
														{% for key, feature in data.FeaturesBenefitsBulletPoint %}
															<p class="flex center">
																{{ feature['name'] }}
															</p>
														{% endfor %}
													</div>
													{% if ((data.material)|trim is not empty) or ((data.reinforcement)|trim is not empty) or ((data.temperatureRangeFAndC)|trim is not empty) %}
														<div>
															{% if data.material %}
																<p class="full">
																	<b>{{ 'Material'|trans }}:</b>
																	{{ data.material }}
																</p>
															{% endif %}
															{% if data.reinforcement %}
																<p class="full">
																	<b>{{ 'Reinforcement'|trans }}:</b>
																	{{ data.reinforcement }}
																</p>
															{% endif %}
															{% if data.temperatureRangeFAndC %}
																<p class="full">
																	<b>{{ 'Temperature Range'|trans }}:</b>
																	{{ data.temperatureRangeFAndC }}
																</p>
															{% endif %}
														</div>
													{% endif %}
												</div>
											</div>

										</menu>
									{% endif %}
								</section>

								{# key feature and benifit end #}
								<div class="imageHolder section-page-pts-belts-images">
									<div class="left-image-and-table">

										<div class="belts-Identification-and-profile-dimension-container">
											{% set section_page_pts_belts_Identification_Image = pimcore_image("section_page_pts_belts_Identification_Image", {"width": 400, "height": 100}) %}
											{% set section_page_pts_belts_Profile_Dimension_image  = pimcore_image("section_page_pts_belts_Profile_Dimension_image", {"width": 400, "height": 100}) %}

											{% if data.beltIdentificationImage %}
												{% set section_page_pts_belts_Identification_Image = section_page_pts_belts_Identification_Image.setImage(data.beltIdentificationImage) %}
											{% endif %}

											{% if data.profileDimensionPtsBelts %}
												{% set section_page_pts_belts_Profile_Dimension_image = section_page_pts_belts_Profile_Dimension_image.setImage(data.profileDimensionPtsBelts) %}
											{% endif %}
											{% if editmode %}
												{{section_page_pts_belts_Identification_Image|raw}}
												{{section_page_pts_belts_Profile_Dimension_image|raw}}
											{% else %}

												{% if section_page_pts_belts_Identification_Image %}
													<img class="section_page_pts_belts_Identification_Image" src="{{getImageThumbnail(section_page_pts_belts_Identification_Image, imageWidth)}}" alt=""/>
												{% endif %}
												{% if section_page_pts_belts_Profile_Dimension_image %}
													<img class="section_page_pts_belts_Profile_Dimension_image" src="{{getImageThumbnail(section_page_pts_belts_Profile_Dimension_image, imageWidth)}}" alt=""/>
												{% endif %}
											{% endif %}
										</div>
									</div>


									{% set section_page_pts_belts_Catalog_Asset_Right_Image = pimcore_image("section_page_pts_belts_Catalog_Asset_Right_Image", {"width": 400, "height": 200}) %}
									{% if data.mainImage %}
										{% set section_page_pts_belts_Catalog_Asset_Right_Image = section_page_pts_belts_Catalog_Asset_Right_Image.setImage(data.mainImage) %}
									{% endif %}
									{% if editmode %}
										{{section_page_pts_belts_Catalog_Asset_Right_Image|raw}}
									{% else %}

										{% if section_page_pts_belts_Catalog_Asset_Right_Image %}
											<div class="section_page_pts_belts_Catalog_Asset_Right_Image">
												<img id="section_page_pts_belts_Catalog_Asset_Image" src="{{getImageThumbnail(section_page_pts_belts_Catalog_Asset_Right_Image, imageWidth)}}" alt="section_page_pts_belts_Catalog_Asset_Right_Image"/>
											</div>
										{% endif %}
									{% endif %}
								</div>
							</aside>
						</header>
						<article class="fullcontainer">
							<section class="section_page_pts_belts_table_container">

								<table class="cellAttributes" aria-hidden="true" cellpadding="0" cellspacing="0" border="0">
									<thead>

										<tr class="section-page-pts-belts-table-head">
											<th>
												<b>Pitch</b>
											</th>
											<th>
												<b>Standard Width (mm)</b>
											</th>
											<th>
												<b>Pitch Length (mm)</b>
											</th>
											<th>
												<b>A</b>
											</th>
											<th>
												<b>B</b>
											</th>
											<th>
												<b>C</b>
											</th>
										</tr>

									</thead>
									<tbody class="section-page-pts-belts-table-body">
										{% for key, products in data.groupData %}
											<tr class="">

												<td>{{key}}</td>
												<td>{{products.standardWidthmm}}</td>
												<td>{{products.pitchLengthMM}}</td>
												<td>{{products.A}}</td>
												<td>{{products.B}}</td>
												<td>{{products.C}}</td>
											</tr>
										{% endfor %}
									</tbody>

								</table>
								</section>
						</article>
					</div>
				</div>

			</section>
		</div>
		{% if not isParentContainerRequest %}
			<script type="text/javascript" src="/static/js/tableContinueLable.js"></script>
		{% endif %}
	{% endif %}
{% endblock %}
