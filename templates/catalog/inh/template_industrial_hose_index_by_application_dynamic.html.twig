{% if not isParentContainerRequest %}
	{% extends "catalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
	{% if data is defined and data %}
		<div class="template">
			<div id="descriptive">
				<div id="pageHeader"></div>
				<span class="pageName">Index</span>

				<div class="numberTitle">
					{% if (editmode) %}
						{% if pimcore_input("HHIDN_Heading").isEmpty() %}
							<h2>{{ pimcore_input("HHIDN_Heading", {'placeholder':'Index Page Title'}).setDataFromResource('Industrial Hose Index By Application') |raw }}</h2>
						{% else %}
							<h2>{{ pimcore_input("HHIDN_Heading") }}</h2>
						{% endif %}
					{% else %}
						<h2>{{ pimcore_input("HHIDN_Heading") }}</h2>
					{% endif %}
				</div>
				<div id="amortizationTable" class=" {% if not editmode %} {{'content_double'}} {% endif %} single">
					{% if (editmode) %}
						<div class="flex">
							<div class="inh-upper">
								{% if (editmode) %}
									{% if pimcore_input("HHIDN_th_col_1").isEmpty() %}
										{{ pimcore_input("HHIDN_th_col_1", {'placeholder':'Column 1'}).setDataFromResource('Name') |raw }}
									{% else %}
										{{ pimcore_input("HHIDN_th_col_1", {'placeholder':'Column 1'}) }}
									{% endif %}
								{% else %}
									{{ pimcore_input("HHIDN_th_col_1", {'placeholder':'Column 1'}) }}
								{% endif %}
							</div>
							<div class="inh-upper">

								{% if (editmode) %}
									{% if pimcore_input("HHIDN_th_col_2").isEmpty() %}
										{{ pimcore_input("HHIDN_th_col_2", {'placeholder':'Column 2'}).setDataFromResource('Page #') |raw }}
									{% else %}
										{{ pimcore_input("HHIDN_th_col_2", {'placeholder':'Column 2'}) }}
									{% endif %}
								{% else %}
									{{ pimcore_input("HHIDN_th_col_2", {'placeholder':'Column 2'}) }}
								{% endif %}

							</div>
						</div>
						{% set dataCount = data | length %}

						{% set INH_Index_ContentBlock = pimcore_block('INH_Index_Content') %}
						{% set INH_Index_ContentBlockLength = INH_Index_ContentBlock | length %}

						{% if INH_Index_ContentBlockLength %}

							{% for iincr in INH_Index_ContentBlock.iterator %}
								<div class="inh-subcategory">
									{{ pimcore_input("TOC_HeadingName", {'placeholder' : 'Enter Heading here.'}) }}
								</div>

								{% for incr in pimcore_block('INH_Index_Inner_Content').iterator %}

									<div class="paging">
										<span class="pageTitle">{{ pimcore_input("HHIDN_td1",{'placeholder' : "Page Title"}) }}</span>
										<span class="pageNo">{{ pimcore_input("HHIDN_td2",{'placeholder' : "Page No"}) }}</span>
									</div>

								{% endfor %}
							{% endfor %}
						{% else %}

							{% set i = 0 %}

							{% set INH_Index_ContentBlock = pimcore_block('INH_Index_Content', {'default':dataCount}) %}

							{% for incr in INH_Index_ContentBlock.iterator %}

								{% set heading = '' %}

								{% if data[i][0] is defined %}

									{% set heading = data[i][0] %}
									{# {% set innerDataCount = innerData | length %} #}

								{% endif %}

								<div class="inh-subcategory">
									{{ pimcore_input("TOC_HeadingName", {'placeholder' : 'Enter Heading here.'}).setDataFromResource(heading) | raw}}
								</div>

								{% set j = 0 %}
								{# {% set innerData = 0 %} #}
								{% set innerDataCount = 0 %}

								{% if data[i][1] is defined %}

									{% set innerData = data[i][1] | split(',') %}
									{% set innerDataCount = innerData | length %}

								{% endif %}


								{% set INH_Index_Inner_ContentBlock = pimcore_block('INH_Index_Inner_Content', {'default':innerDataCount}) %}

								{% for incr in INH_Index_Inner_ContentBlock.iterator %}
									{% set title = '' %}

									{% if innerData[j] is defined %}

										{% set title = innerData[j] %}

									{% endif %}

									<div class="paging">
										<span class="pageTitle">{{ pimcore_input("HHIDN_td1",{'placeholder':"Page Title"}).setDataFromResource(title) | raw }}</span>
										<span class="pageNo">{{ pimcore_input("HHIDN_td2",{'placeholder':"Page No"}) }}</span>
									</div>
									{% set j = j + 1 %}
								{% endfor %}

								{% set i = i + 1 %}
							{% endfor %}
						{% endif %}
					{% else %}
						<table cellpadding="0" cellspacing="0" class="grid">
							<thead>
								<tr>
									<td>
										<span class="inh-upper">{{ pimcore_input("HHIDN_th_col_1") }}</span>
									</td>
									<td align="right">
										<span class="inh-upper">{{ pimcore_input("HHIDN_th_col_2") }}</span>
									</td>
								</tr>
							</thead>
							<tbody>
								{% for incr in pimcore_block("INH_Index_Content").iterator %}
									<tr>
										<td colspan="2">
											<div class="inh-subcategory">{{ pimcore_input("TOC_HeadingName") }}</div>
										</td>
									</tr>

									{% for incr in pimcore_block("INH_Index_Inner_Content").iterator %}
										<tr>
											<td colspan="2">
												<div class="paging">
													<span class="pageTitle">{{ pimcore_input("HHIDN_td1") }}</span>
													<span class="pageNo">{{ pimcore_input("HHIDN_td2") }}</span>
												</div>
											</td>
										</tr>
									{% endfor %}
								{% endfor %}
							</tbody>
						</table>
					{% endif %}
				</div>
			</div>
		</div>
	{% else %}
		<h6>No data found
		</h6>
	{% endif %}
{% endblock %}