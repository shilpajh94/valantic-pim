																	<b>{{ 'Reinforcement'|trans }}:</b>
																	{{ data.reinforcement }}
																</p>
															{% endif %}
															{% if data.temperatureRangeFAndC %}
																<p class="full">
																	<b>{{ 'Temperature Range'|trans }}:</b>
																	{{ data.minimumTemperatureF }}&deg;F to {{ data.maximumTemperatureF }}&deg;F
																</p>
															{% endif %}
