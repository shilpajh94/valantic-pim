{% if not isParentContainerRequest %}
	{% extends "catalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

{% if editmode %}
	{{ pimcore_relation("ptg_product_page", {
        "types": ["object"],
        "subtypes": {
            "object": ["object"]
        },
        "classes": ["CatalogTables"]
    }) }}
{% endif %}
<style>
 table.silentsync > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:20px;
 }
  table.wedge_tlp > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:20px;
 }
   table.hyt_wedge > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
      table.hyt_plus > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 } 
 
       table.torque_flex > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
 
        table.metric > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
 
         table.hex > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 } 
          table.instapower > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
 
                table.fhp > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
                 table.hyt_torque_team > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
                  table.polyv > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 } 
                   table.hyt_wedge_torque_team > tbody > tr>td{
     margin:0px !important;
	padding:0px !important;
	height:37px;
 }
    
</style>
{% if groupData %}
	<div class="template">
		<section class="segregate">
			<div id="pageHeader"></div>
			<span class="pageName">
				{{ groupData['siop3Category'] }}
			</span>

			<div class="footer">
				<footer class="flex-center {{ footer_class }}">
					<span class="logo">
						<img src="{{ footer_logo_src }}">
					</span>
					<div class="flex aligned">
						<h5>
							{% if editmode %}
								{% if not pimcore_input("PTG_Footer_BrandName").isEmpty() %}
									{{ pimcore_input("PTG_Footer_BrandName") }}
								{% else %}
									{{ pimcore_input("PTG_Footer_BrandName").setDataFromResource(groupData['brandName']) | raw}}
								{% endif %}
							{% else %}
								{{ pimcore_input("PTG_Footer_BrandName") }}
							{% endif %}

							<span>
								{% if editmode %}
									{% if not pimcore_input("PTG_Footer_HoseType").isEmpty() %}
										{{ pimcore_input("PTG_Footer_HoseType") }}
									{% else %}
										{{ pimcore_input("PTG_Footer_HoseType").setDataFromResource(groupData['siop3Category']) | raw}}
									{% endif %}

									/

									{% if not pimcore_input("PTG_Footer_HoseType2").isEmpty() %}
										{{ pimcore_input("PTG_Footer_HoseType2") }}
									{% else %}
										{{ pimcore_input("PTG_Footer_HoseType2").setDataFromResource(groupData['siop4Category']) | raw}}
									{% endif %}
								{% else %}
									{{ pimcore_input("PTG_Footer_HoseType") }}/{{ pimcore_input("PTG_Footer_HoseType2") }}
								{% endif %}
							</span>
						</h5>

						<div class="compatible">
							<b>
								{% if editmode %}
									{% if not pimcore_input("PTG_Footer_Compatibility").isEmpty() %}
										{{ pimcore_input("PTG_Footer_Compatibility") }}
									{% else %}
										{{ pimcore_input("PTG_Footer_Compatibility").setDataFromResource('') | raw}}
									{% endif %}
								{% else %}
									{{ pimcore_input("PTG_Footer_Compatibility") }}
								{% endif %}
							</b>

							{% set compatibility_description = "" %}
							{% if editmode %}
								{% if not pimcore_wysiwyg("PTG_Footer_Compatibility_Description").isEmpty() %}
									{{ pimcore_wysiwyg("PTG_Footer_Compatibility_Description") }}
								{% else %}
									{{ pimcore_wysiwyg("PTG_Footer_Compatibility_Description", {"width": 100,"placeholder" : "eg: Enter Text"}).setDataFromResource(compatibility_description) | raw}}
								{% endif %}
							{% else %}
								{{ pimcore_wysiwyg("PTG_Footer_Compatibility_Description") }}
							{% endif %}

						</div>
					</div>
				</footer>
			</div>

			<div class="footer1">
				<footer class="flex-center {{ footer_class }}">
					<div class="flex aligned">
						<div class="compatible">
							<b>
								{% if editmode %}
									{% if not pimcore_input("PTG_Footer_Compatibility1").isEmpty() %}
										{{ pimcore_input("PTG_Footer_Compatibility1") }}
									{% else %}
										{{ pimcore_input("PTG_Footer_Compatibility1").setDataFromResource('') | raw}}
									{% endif %}
								{% else %}
									{{ pimcore_input("PTG_Footer_Compatibility1") }}
								{% endif %}
							</b>

							{% set compatibility_description = "" %}
							{% if editmode %}
								{% if not pimcore_wysiwyg("PTG_Footer_Compatibility1_Description").isEmpty() %}
									{{ pimcore_wysiwyg("PTG_Footer_Compatibility1_Description") }}
								{% else %}
									{{ pimcore_wysiwyg("PTG_Footer_Compatibility1_Description", {"width": 100,"placeholder" : "eg: Enter Text"}).setDataFromResource(compatibility_description) | raw}}
								{% endif %}
							{% else %}
								{{ pimcore_wysiwyg("PTG_Footer_Compatibility1_Description") }}
							{% endif %}
						</div>
						<h5>
							{% if editmode %}
								{% if not pimcore_input("PTG_Footer_BrandName1").isEmpty() %}
									{{ pimcore_input("PTG_Footer_BrandName1") }}
								{% else %}
									{{ pimcore_input("PTG_Footer_BrandName1").setDataFromResource(groupData['brandName']) | raw}}
								{% endif %}
							{% else %}
								{{ pimcore_input("PTG_Footer_BrandName1") }}
							{% endif %}

							<span>
								{% if editmode %}
									{% if not pimcore_input("PTG_Footer_HoseType1").isEmpty() %}
										{{ pimcore_input("PTG_Footer_HoseType1") }}
									{% else %}
										{{ pimcore_input("PTG_Footer_HoseType1").setDataFromResource(groupData['siop3Category']) | raw}}
									{% endif %}

									/

									{% if not pimcore_input("PTG_Footer_HoseType3").isEmpty() %}
										{{ pimcore_input("PTG_Footer_HoseType3") }}
									{% else %}
										{{ pimcore_input("PTG_Footer_HoseType3").setDataFromResource(groupData['siop4Category']) | raw}}
									{% endif %}
								{% else %}
									{{ pimcore_input("PTG_Footer_HoseType1") }}/{{ pimcore_input("PTG_Footer_HoseType3") }}
								{% endif %}
							</span>
						</h5>
					</div>
					<span class="logo">
						<img src="{{ footer_logo_src }}">
					</span>
				</footer>
			</div>

			<header class="content white">
				<h1>
					{% if editmode %}
						{% if not pimcore_input("PTG_Heading").isEmpty() %}
							{{ pimcore_input("PTG_Heading") }}
						{% else %}
							{{ pimcore_input("PTG_Heading").setDataFromResource(groupData['brandName']) | raw}}
						{% endif %}
					{% else %}
						{{ pimcore_input("PTG_Heading") }}
					{% endif %}
				</h1>
				<aside class="ptgHead">
					<div>
						{% if editmode %}
							{% if not pimcore_wysiwyg("PTG_LongDescription").isEmpty() %}
								{{ pimcore_wysiwyg("PTG_LongDescription") }}
							{% else %}
								{{ pimcore_wysiwyg("PTG_LongDescription").setDataFromResource(groupData['longDescription']) | raw}}
							{% endif %}
						{% else %}
							{{ pimcore_wysiwyg("PTG_LongDescription") }}
						{% endif %}
					</div>
					<span class="imageHolder">
						{% if editmode %}
							{% if not pimcore_image("HHPP_Image_Left").isEmpty() %}
								{{ pimcore_image("HHPP_Image_Left", {"width": 400, "height": 200}) }}
							{% else %}

								{% if groupData['mainImageObj'] %}
									{{ pimcore_image("HHPP_Image_Left", {"width": 400, "height": 200}).setImage(groupData['mainImageObj']) | raw}}
								{% else %}
									{{ pimcore_image("HHPP_Image_Left", {"width": 400, "height": 200}) }}
								{% endif %}

							{% endif %}
						{% else %}
							{% set imgSrcObj1 = pimcore_image("HHPP_Image_Left") %}

							{% if imgSrcObj1 %}
								<img src="{{getImageThumbnail(imgSrcObj1, imageWidth)}}" width="400" height="200"/>
							{% endif %}
						{% endif %}

						{% if editmode %}
							{% if not pimcore_image("Drawing_Picture").isEmpty() %}
								{{ pimcore_image("Drawing_Picture", {"width": 400, "height": 200}) }}
							{% else %}

								{% if groupData['ProfileDimensionImageObj'] %}
									{{ pimcore_image("Drawing_Picture", {"width": 400, "height": 200}).setImage(groupData['ProfileDimensionImageObj']) | raw}}
								{% else %}
									{{ pimcore_image("Drawing_Picture", {"width": 400, "height": 200}) }}
								{% endif %}

							{% endif %}
						{% else %}
							{% set imgSrcObj2 = pimcore_image("Drawing_Picture") %}

							{% if imgSrcObj2 %}
								<img src="{{getImageThumbnail(imgSrcObj2, imageWidth)}}" width="400" height="200"/>
							{% endif %}
						{% endif %}
					</span>
				</aside>
			</header>

			<article class="fullcontainer">
				<section class="content single ptg">
					{% if groupData.safetyFeatures or ((groupData['material'])|trim is not empty) or ((groupData['reinforcement'])|trim is not empty) or ((groupData['temperatureRange'])|trim is not empty) %}
						<menu class="flex">
							{% if groupData['safetyFeatures'] %}
								<div class="specs">
									<h6>{{ 'features'|trans }}</h6>
									<div>
										{% for key, feature in groupData['safetyFeatures'] %}
											<p class="flex center">
												{% if feature['iconSrc'] %}
													<img src="{{ feature['iconSrc'] }}"/>
												{% endif %}
												{{ feature['name'] }}
											</p>
										</font>
									</p>
								{% endfor %}
							</div>
						</div>
					{% endif %}

					{% if ((groupData['material'])|trim is not empty) or ((groupData['reinforcement'])|trim is not empty) or ((groupData['temperatureRange'])|trim is not empty) %}
						<div class="specs">
							<h6>{{ 'specs'|trans }}</h6>
							<div class="spec-requirement">
								<div>
									{% if groupData['material'] %}
										<div class="full">
											<b>{{ 'Material'|trans }}</b>
											{{ groupData['material'] }}
										</div>
									{% endif %}
									{% if groupData['reinforcement'] %}
										<div class="full">
											<b>{{ 'Reinforcement'|trans }}</b>
											{{ groupData['reinforcement'] }}
										</div>
									{% endif %}
									{% if groupData['temperatureRange'] %}
										<div class="full">
											<b>{{ 'Temperature Range'|trans }}</b>
											{{ groupData['temperatureRange'] }}
										</div>
									{% endif %}
								</div>
							</div>
						</div>
					{% endif %}
				</menu>
			{% endif %}

			{% set tableNoteCount = 0 %}
			{% for articleGroupKey, articleGroupData in groupData['data'] %}
				<table class="grid continueLable  {{table_class}}" cellpadding="0" cellspacing="0">
					<thead>
						{% if groupData.iconRequired == 'YES' %}
							<tr class="sub-head">
								{% for key, c1data in groupData['columnsDataWithImages'] %}
									{% set columnWidth = '' %}
									{% set g1count = c1data|length %}
									{% set firstArray = c1data|first %}
									{% if firstArray['columnWidth'] %}
										{% set columnWidth = "width=" ~ firstArray['columnWidth'] %}
									{% endif %}
									<td colspan="{{ g1count }}" {{ columnWidth }}>
										{% if ( firstArray['columnIcon'] is defined and firstArray['columnIcon']) %}
											<img src="{{ firstArray['columnIcon'] }}" width="45" height="45"/>
										{% endif %}
									</td>
								{% endfor %}
							</tr>
						{% endif %}

						<tr class="head">
							{% for key, c2data in groupData['columnsDataWithImages'] %}
								{% set columnWidth = '' %}
								{% set g2count = c2data|length %}
								{% set first2Array = c2data|first %}
								{% if first2Array['columnWidth'] %}
									{% set columnWidth = "width=" ~ first2Array['columnWidth'] %}
								{% endif %}
								<td colspan="{{ g2count }}" {{ columnWidth }}>
									{{first2Array['columnLabel']}}
								</td>
							{% endfor %}
						</tr>

						{% if groupData['subHeaderRequired'] == 'YES' %}
							<tr class="sub-head">
								{% for key, c3data in groupData['columnsDataWithImages'] %}
									{% for c3key, c3value in c3data %}
										{% if c3value['unitName'] %}
											<td>{{ c3value['unitName'] }}</td>
										{% else %}
											<td></td>
										{% endif %}
									{% endfor %}
								{% endfor %}
							</tr>
						{% endif %}
					</thead>
					<tbody>
						{% set incrRow = 1 %}
						{% for key, element in articleGroupData %}
							{% if incrRow is even %}
								<tr class="tableNewFont">
								{% else %}
									<tr class="active tableNewFont">
									{% endif %}
									{% for ekey, value in element %}
										<td>{{ value }}</td>
									{% endfor %}
								</tr>
								{% set incrRow = incrRow + 1 %}
							{% endfor %}
						</tbody>
					</tbody>
				</table>
				<div class="small relative">{{ pimcore_input('PTG_Note_' ~ tableNoteCount, {'placeholder': 'Enter comment'}) }}</div>
				{% set tableNoteCount = tableNoteCount + 1 %}
			{% endfor %}
		</section>
	</article>
</section></div>{% if not isParentContainerRequest %}
<script type="text/javascript" src="/static/js/tableContinueLable.js"></script>{% endif %}{% endif %}{% endblock %}