{% if editmode %}
    <h3>Select Column</h3>
{% endif %}

{% set columns = [] %}
{% set tds = [] %}
{% set total_rows = 0 %}


{% for i in pimcore_block('headingblock').iterator %}
    {% set columns = columns | merge([pimcore_wysiwyg("heading")]) %}
{% endfor %}

{% if editmode %}
    <h3>Select Rows</h3>
{% endif %}

{% for j in pimcore_block('contentblock').iterator %}
    {% set total_rows = j-1 %}
    {% for key, col in columns %}
        {% if tds['row_'~total_rows] is defined %}
            {% set tds = tds['row_'~total_rows] | merge([pimcore_input("data_"~total_rows~"_"~key,{'width': 200})]) %}
        {% endif %}
    {% endfor %}
{% endfor %}

<div class="table process-table">
    <table width="100%">
        <thead>
            <tr align="right">
                <th colspan="4" class="p-0" >
                    {% if editmode %}
                        {% if pimcore_image('fieldPhoto').isEmpty() %}
                            {{ pimcore_image('fieldPhoto').setImage(data['fieldPhoto']) | raw}}
                        {% else %}
                            {{ pimcore_image('fieldPhoto')}}
                        {% endif %}
                    {% else %}
                        {% set CSSImgSrcObj = pimcore_image('fieldPhoto').setImage(data['fieldPhoto']) %}
                        {% if CSSImgSrcObj.getThumbnail('catalog_thumb') %}
                            <div class="process-image">
                                <img src="{{ CSSImgSrcObj.getThumbnail('catalog_thumb') }}" alt=""  class="w-100" />
                            </div>
                        {% endif %}
                    {% endif %}
                </th>
            </tr>
            <tr valign="bottom">
                {% for ckey, col_name in columns %}
                    <th width="25%">{{col_name | raw}}</th>
                {% endfor %}
            </tr>
        <thead>

        <tbody>
            {% for i in 0..(total_rows-1) %}
                <tr align="left">
                    {% if tds["row_"~i] is defined and tds["row_"~i] %}
                        {% for key, td in tds["row_"~i] %}
                            <td>{{td}}</td>
                        {% endfor %}
                    {% endif %} 
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
