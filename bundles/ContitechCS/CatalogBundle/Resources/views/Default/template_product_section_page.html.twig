{% if parentContainer is defined %}
	{% extends "@ContitechCSCatalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

<div class="innercoverpage">
    <div class="black-bg">
        <h1>{{ pimcore_input("TOC_Section_Title") }}</h1>
    </div>
    <div class="bannersec">
        {% if editmode %}
            {{ pimcore_image("TOC_Section_Image") }}
        {% else %}
            {% set imgSrcObj = pimcore_image("TOC_Section_Image") %}
            {% if imgSrcObj.getId() is not empty %}
                <img src="{{ getImageThumbnail(imgSrcObj, imageWidth) }}" alt=""/>
            {% endif %}
        {% endif %}
    </div>
</div>

{% endblock %}