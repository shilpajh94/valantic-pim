{% if parentContainer is not defined %}
        {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

    {% if editmode %}
        {{ pimcore_relation("inh-printcatalogproduct") }}
    {% endif %}


    {% if info['brandsData'] is defined %}
        {% set industrial_hose_data = [] %}

        {% if info['brandsData'] is iterable %}
            {% set pg = 0 %}

            {% for brandKey, brand in info['brandsData'] %}
                {% set uniqueId = md5Twig(brandKey) %}
                {% set categoryForCatalog = brand['brandData']['SIOP3Description']~": "~brand['brandData']['SIOP4Description'] %}
                
                <div class="template">
                    <div class="segregate inh  inhSettingProductPage">

                        <div id="pageHeader"></div>
                        <span class="pageName">
                            {{ brand['brandData']['SIOP3Description']~" - "~brand['brandData']['SIOP4Description'] }}
                        </span>

                        <div class="footer">
                            <footer class="flex-center {{info['footer_class']}}">
                                <span class="logo">
                                    <img src="{{info['footer_logo_src']}}">
                                </span>
                                <div class="flex aligned">
                                    <h5 class="marginTop2">
                                        {% if editmode %} 
                                                {% if pimcore_input("INH_PP_FOOTER_BRAND_"~uniqueId).isEmpty() %} 
                                                        {{ pimcore_input("INH_PP_FOOTER_BRAND_"~uniqueId, {"placeholder" : "Brand"}).setDataFromResource(brandKey) | raw }}
                                                {% else %}
                                                        {{ pimcore_input("INH_PP_FOOTER_BRAND_"~uniqueId, {"placeholder" : "Brand"}) }}
                                                {% endif %}
                                        {% else %}
                                                {{ pimcore_input("INH_PP_FOOTER_BRAND_"~uniqueId, {"placeholder" : "Brand"}) }}
                                        {% endif %}

                                        <span>
                                            {% if editmode %} 
                                                    {% if pimcore_input("INH_PP_FOOTER_HP_"~uniqueId).isEmpty() %} 
                                                            {{ pimcore_input("INH_PP_FOOTER_HP_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}).setDataFromResource(info['selectedCategory']) | raw }}
                                                    {% else %}
                                                            {{ pimcore_input("INH_PP_FOOTER_HP_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                                    {% endif %}
                                            {% else %}
                                                    {{ pimcore_input("INH_PP_FOOTER_HP_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                            {% endif %}
                                        </span>
                                    </h5>

                                    <div class="compatible">
                                        {% if editmode %} 
                                                {% if pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING_"~uniqueId).isEmpty() %} 
                                                        {{ pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}).setDataFromResource("<b>Compatible Fitting</b><p>Meets or exceeds the performance requirements of</p>") | raw }}
                                                {% else %}
                                                        {{ pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                                {% endif %}
                                        {% else %}
                                                {{ pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                        {% endif %}
                                    </div>
                                </div>
                            </footer>
                        </div>

                        <div class="footer1">
                            <footer class="flex-center {{info['footer_class']}}">
                                <div class="flex aligned">

                                    <div class="compatible">
                                        {% if editmode %} 
                                                {% if pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING1_"~uniqueId).isEmpty() %} 
                                                        {{ pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING1_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}).setDataFromResource("<b>Compatible Fitting</b><p>Meets or exceeds the performance requirements of</p>") | raw }}
                                                {% else %}
                                                        {{ pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING1_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                                {% endif %}
                                        {% else %}
                                                {{ pimcore_wysiwyg("INH_PP_FOOTER_COMP_FITTING1_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                        {% endif %}
                                    </div>

                                    <h5 class="marginTop2">
                                        {% if editmode %} 
                                                {% if pimcore_input("INH_PP_FOOTER_BRAND1_"~uniqueId).isEmpty() %} 
                                                        {{ pimcore_input("INH_PP_FOOTER_BRAND1_"~uniqueId, {"placeholder" : "Brand"}).setDataFromResource(brandKey) | raw }}
                                                {% else %}
                                                        {{ pimcore_input("INH_PP_FOOTER_BRAND1_"~uniqueId, {"placeholder" : "Brand"}) }}
                                                {% endif %}
                                        {% else %}
                                                {{ pimcore_input("INH_PP_FOOTER_BRAND1_"~uniqueId, {"placeholder" : "Brand"}) }}
                                        {% endif %}

                                        <span>
                                            {% if editmode %} 
                                                    {% if pimcore_input("INH_PP_FOOTER_HP1_"~uniqueId).isEmpty() %} 
                                                            {{ pimcore_input("INH_PP_FOOTER_HP1_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}).setDataFromResource(info['selectedCategory']) | raw }}
                                                    {% else %}
                                                            {{ pimcore_input("INH_PP_FOOTER_HP1_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                                    {% endif %}
                                            {% else %}
                                                    {{ pimcore_input("INH_PP_FOOTER_HP1_"~uniqueId, {"placeholder" : "eg: Enter Product Category"}) }}
                                            {% endif %}
                                        </span>
                                    </h5>

                                </div>
                                <span class="logo">
                                    <img src="{{ info['footer_logo_src']}}">
                                </span>
                            </footer>
                        </div>

                        <article class="fullcontainer single">
                            <div class="inhsetting1">
                                <div class="inhsetting-sidebar">
                                    <div class=" sidebar">
                                        <ul>
                                            {% if info['categories'] is iterable %}
                                                {% for category in info['categories'] %}
                                                    {% set first = '' %}
                                                    {% if (info['selectedCategory'] == category['mainCategory'][0]['name']) %}
                                                        {% set first = 'first' %}
                                                    {% endif %}

                                                    <li class='{{first}}'>
                                                        {% if category['mainCategory'][0]['name'] is defined %}
                                                            <p><b>{{category['mainCategory'][0]['name']}}</b></p>
                                                        {% else %}
                                                            <p></p>
                                                        {% endif %}

                                                        {% if category['subCategory'] is defined and category['subCategory'] is iterable and category['subCategory'] is not empty %}
                                                            {% for k, cat in category['subCategory'] %}
                                                                {% if cat['printable'] == 1 %} 
                                                                    <p>{{cat['name']}}</p>
                                                                {% endif %}
                                                            {% endfor %}
                                                        {% endif %}
                                                    </li>
                                                {% endfor %}
                                            {% endif %}
                                        </ul>
                                    </div>
                                </div>
                                <div class="inhRight">
                                    <header class=" white">
                                            <h1>
                                                {% if editmode %} 
                                                        {% if pimcore_input("INH_PRODUCT_BRANDNAME_"~uniqueId).isEmpty() %} 
                                                                {{ pimcore_input("INH_PRODUCT_BRANDNAME_"~uniqueId, {"placeholder" : "eg: Enter Brand"}).setDataFromResource(brandKey) | raw }}
                                                        {% else %}
                                                                {{ pimcore_input("INH_PRODUCT_BRANDNAME_"~uniqueId, {"placeholder" : "eg: Enter Brand"}) }}
                                                        {% endif %}
                                                {% else %}
                                                        {{ pimcore_input("INH_PRODUCT_BRANDNAME_"~uniqueId, {"placeholder" : "eg: Enter Brand"}) }}
                                                {% endif %}
                                            </h1>
                                        <aside>
                                            <div>
                                                {% if editmode %} 
                                                        {% if pimcore_input("INH_LONG_DESCRIPTION_"~uniqueId).isEmpty() %} 
                                                                {{ pimcore_input("INH_LONG_DESCRIPTION_"~uniqueId, {"placeholder" : "eg: Enter Brand Description"}).setDataFromResource(brand['brandData']['longDescription']) | raw }}
                                                        {% else %}
                                                                {{ pimcore_input("INH_LONG_DESCRIPTION_"~uniqueId, {"placeholder" : "eg: Enter Brand Description"}) }}
                                                        {% endif %}
                                                {% else %}
                                                        {{ pimcore_input("INH_LONG_DESCRIPTION_"~uniqueId, {"placeholder" : "eg: Enter Brand Description"}) }}
                                                {% endif %}
                                            </div>

                                            {% if editmode %} 
                                                {% if pimcore_image('INH_MAIN_IMAGE_'~uniqueId).isEmpty() %}
                                                    {{ pimcore_image('INH_MAIN_IMAGE_'~uniqueId, {'width': 1067, 'height': 128}).setImage(brand['brandData']['mainImage']) }}
                                                {% else %}
                                                    {{ pimcore_image('INH_MAIN_IMAGE_'~uniqueId, {'width': 1067, 'height': 128}) }}
                                                {% endif %}
                                                
                                                
                                            {% else %}

                                                {% if not pimcore_image('INH_MAIN_IMAGE_'~uniqueId).isEmpty() %}
                                                    {% set imgSrcObj = pimcore_image('INH_MAIN_IMAGE_'~uniqueId) %}
                                                {% endif %}
                                                
                                                {% if imgSrcObj %}
                                                    <img src="{{getImageThumbnail(imgSrcObj,imageWidth)}}" width="1067" height="128"/>
                                                {% endif %}
                                            {% endif %}
                                        </aside>
                                    </header>
                                    <section class="content">
                                        <?php if($brand['brandData']['safetyFeatures'] || !empty(trim($brand['brandData']['designFactor'])) || !empty(trim($brand['brandData']['tubeMaterial'])) || !empty(trim($brand['brandData']['coverMaterial'])) || !empty(trim($brand['brandData']['reinforcement'])) || !empty(trim($brand['brandData']['temperatureRangeFAndC'])) || !empty(trim($brand['brandData']['Coupling'])) || !empty(trim($brand['brandData']['Packaging']))): ?>
                                            <menu class="flex">
                                                <?php if(!empty(trim($brand['brandData']['designFactor'])) || !empty(trim($brand['brandData']['tubeMaterial'])) || !empty(trim($brand['brandData']['coverMaterial'])) || !empty(trim($brand['brandData']['reinforcement'])) || !empty(trim($brand['brandData']['temperatureRangeFAndC'])) || !empty(trim($brand['brandData']['Coupling'])) || !empty(trim($brand['brandData']['Packaging']))): ?>
                                                    <div class="specs">
                                                        <h6><?= $this->translate('specs') ?></h6>
                                                        <div class="spec-requirement flex">
                                                            <div class="col-6">
                                                                <?php if (!empty(trim($brand['brandData']['tubeMaterial']))): ?>
                                                                    <div class="full">
                                                                        <b><?= $this->translate('Tube Material') ?></b>
                                                                        <?= $brand['brandData']['tubeMaterial'] ?>
                                                                    </div>
                                                                <?php endif; ?>

                                                                <?php if (!empty(trim($brand['brandData']['coverMaterial']))): ?>
                                                                    <div class="full">
                                                                        <b><?= $this->translate('Cover Material') ?></b>
                                                                        <?= $brand['brandData']['coverMaterial'] ?>
                                                                    </div>
                                                                <?php endif; ?>

                                                                <?php if (!empty(trim($brand['brandData']['reinforcement']))): ?>
                                                                    <div class="full">
                                                                        <b><?= $this->translate('Reinforcement') ?></b>
                                                                        <?= $brand['brandData']['reinforcement'] ?>
                                                                    </div>
                                                                <?php endif; ?>

                                                                <?php if (!empty(trim($brand['brandData']['temperatureRangeFAndC']))): ?>
                                                                    <div class="full">
                                                                        <b><?= $this->translate('Temperature Range') ?></b>
                                                                        <?= $brand['brandData']['temperatureRangeFAndC'] ?>
                                                                    </div>
                                                                <?php endif; ?>

                                                                <?php if (!empty(trim($brand['brandData']['designFactor']))): ?>
                                                                    <div class="full">
                                                                        <b><?= $this->translate('Design Factor') ?></b>
                                                                        <?= $brand['brandData']['designFactor'] ?>
                                                                    </div>
                                                                <?php endif; ?>
                                                                
                                                            </div>
                                                            <div class="col-6">
                                                                
                                                                <?php if (!empty(trim($brand['brandData']['Packaging']))): ?>
                                                                    <div class="right-full">
                                                                        <b><?= $this->translate('Packaging') ?></b>
                                                                        <table>
                                                                        <?php 
                                                                        $rows = explode(PHP_EOL,$brand['brandData']['Packaging']);

                                                                        foreach ($rows as $key => $row) {
                                                                            ?>
                                                                            <tr>
                                                                                <?php
                                                                                
                                                                                $rowColData = explode(' - ', $row);

                                                                                if(count($rowColData) == 2){
                                                                                ?>
                                                                                <td><?= $rowColData[0]; ?></td>
                                                                                <td> - <?= $rowColData[1]; ?></td>
                                                                                <?php } else { ?>
                                                                                <td colspan="2"><?= $row; ?></td>
                                                                                <?php } ?>
                                                                            </tr>
                                                                            <?php
                                                                        }
                                                                        
                                                                        ?>
                                                                        </table>
                                                                    </div>
                                                                <?php endif; ?>

                                                                <?php if (!empty(trim($brand['brandData']['Coupling']))): ?>
                                                                    <div class="right-full">
                                                                        <b><?= $this->translate('Coupling') ?></b>
                                                                        <?= $brand['brandData']['Coupling'] ?>
                                                                    </div>
                                                                <?php endif; ?>
                                                                
                                                        </div>

                                                    </div>
                                                                        
                                                                    </div>
                                                                    <?php endif; ?>

                                                                    <?php if ($brand['brandData']['safetyFeatures']): ?>
                                                                        <div class="feature">
                                                                            <h6><?= $this->translate('features') ?></h6>
                                                                            <div>
                                                                                <?php foreach ($brand['brandData']['safetyFeatures'] as $key => $feature): ?>
                                                                                    <p  class="flex">
                                                                                        <?php if ($feature['iconSrc']): ?>
                                                                                            <img src="<?= $feature['iconSrc'] ?>" />
                                                                                        <?php endif; ?>
                                                                                        <font> <?= $feature['name'] ?></font>
                                                                                    </p>
                                                                                <?php endforeach; ?>

                                                                            </div>
                                                                        </div>
                                                                    <?php endif; ?>
                                                                </menu>
                                                            <?php endif; ?>
                                                            <menu>
                                                                <h6><?= $this->translate('branding') ?></h6>
                                                                <figure class="brandingLaylineStyle">
                                                                    <figcaption> <?= $brand['brandData']['BrandingLayline'] ?> </figcaption>
                                                                </figure>
                                                            </menu>
                                                            <?php
                                                            $noterow = 0;

                                                            if(isset($brand['articleData']) && is_array($brand['articleData'])):

                                                                foreach ($brand['articleData'] as $key => $GroupingFields):
                                                                    foreach ($GroupingFields as $gkey => $fittingTableName):

                                                                    $industrial_hose_data[$categoryForCatalog][] = ($brandKey && $key) ? $brandKey. " ". $key : $brandKey;
                                                                    $tableKey = md5($key.$gkey);
                                                                ?>
                                                <div class="inh-section-break">
                                                        <aside class="borders">
                                                                    <h5 class="marginTop ">
                                                                    <?php if($this->editmode): ?>
                                                                        <?php if($this->input('INH_PP_BrandNameGroupKey_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Brand Name Group Text"])->isEmpty()): ?>
                                                                                <?= $this->input('INH_PP_BrandNameGroupKey_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Brand Name Group Text"])->setDataFromResource($brandKey. " ". $key) ?>
                                                                        <?php else: ?>
                                                                                <?= $this->input('INH_PP_BrandNameGroupKey_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Brand Name Group Text"]); ?>
                                                                        <?php endif; ?>
                                                                    <?php else: ?>
                                                                            <?= $this->input('INH_PP_BrandNameGroupKey_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Brand Name Group Text"]) ?>
                                                                    <?php endif; ?>
                                                                    
                                                                    </h5>
                                                                    <?php if($fittingTableName['orderCodes']): ?>
                                                                    <div class="flex alignCenter orderCode">Order Codes : 
                                                                    
                                                                    <?php if($this->editmode): ?>
                                                                        <?php if($this->input('INH_PP_OrderCodes_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Order Codes"])->isEmpty()): ?>
                                                                                <?= $this->input('INH_PP_OrderCodes_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Order Codes"])->setDataFromResource($fittingTableName['orderCodes']) ?>
                                                                        <?php else: ?>
                                                                                <?= $this->input('INH_PP_OrderCodes_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Order Codes"]); ?>
                                                                        <?php endif; ?>
                                                                    <?php else: ?>
                                                                            <?= $this->input('INH_PP_OrderCodes_' . $uniqueId.'_'.$tableKey, ["placeholder" => "eg: Enter Order Codes"]) ?>
                                                                    <?php endif; ?>
                                                                    </div>
                                                        </aside>
                                                                    <?php endif; ?>

                                                                    <!-- <table class="grid" cellpadding="0" cellspacing="0"> -->
                                                                    <table class="grid special inh marginBottom5 continueLable" cellspacing="0" cellpadding="0">
                                                                        <thead>

                                                                            <?php if ($info['iconRequired'] == 'YES'): ?>
                                                                                <tr class="sub-head">
                                                                                    <?php foreach ($fittingTableName['columnsDataWithImages'] as $key => $c1data): ?>
                                                                                        <?php
                                                                                        $columnWidth = '';
                                                                                        $g1count = count($c1data);
                                                                                        $firstArray = array_shift($c1data);
                                                                                        if($firstArray['columnWidth'])
                                                                                                    $columnWidth = "width=".$firstArray['columnWidth']
                                                                                        ?>
                                                                                        <td colspan="<?= $g1count; ?>" <?php echo $columnWidth; ?>>
                                                                                            <?php if ($firstArray['columnIcon']): ?>
                                                                                                <img src="<?= $firstArray['columnIcon'] ?>" width="45" height="45" />
                                                                                            <?php endif; ?>
                                                                                        </td>
                                                                                    <?php endforeach; ?>
                                                                                </tr>
                                                                            <?php endif; ?>
                                                                            <tr class="head">
                                                                                <?php foreach ($fittingTableName['columnsDataWithImages'] as $key => $c2data): ?>
                                                                                    <?php
                                                                                    $columnWidth = '';
                                                                                    $g2count = count($c2data);
                                                                                    $first2Array = array_shift($c2data);
                                                                                    if($first2Array['columnWidth'])
                                                                                                    $columnWidth = "width=".$first2Array['columnWidth']
                                                                                    ?>
                                                                                    <td colspan="<?= $g2count; ?>" <?php echo $columnWidth; ?>><?= $first2Array['columnLabel'] ?></td>
                                                                                <?php endforeach; ?>
                                                                            </tr>

                                                                            <?php if ($fittingTableName['subHeaderRequired'] == 'YES'): ?>
                                                                                <tr class="head">
                                                                                    <?php foreach ($fittingTableName['columnsDataWithImages'] as $key => $c3data): ?>
                                                                                        <?php foreach ($c3data as $c3key => $c3value): ?>
                                                                                            <?php if ($c3value['unitName']): ?>
                                                                                                <td><?= $c3value['unitName'] ?></td>
                                                                                            <?php else: ?>
                                                                                                <td></td>
                                                                                            <?php endif; ?>
                                                                                        <?php endforeach; ?>
                                                                                    <?php endforeach; ?>
                                                                                </tr>
                                                                            <?php endif; ?>
                                                                        </thead>
                                                                        <tbody>
                                                                            <?php

                                                                            if(isset($fittingTableName['articles']) && is_array($fittingTableName['articles'])):
                                                                            $incrRow = 1;

                                                                            ?>
                                                                            <?php foreach ($fittingTableName['articles'] as $key => $element): ?>
                                                                                <?php if ($incrRow % 2 == 0): ?>
                                                                                    <tr class = 'tableNewFont'>
                                                                                    <?php else: ?>
                                                                                    <tr class="active tableNewFont">
                                                                                    <?php endif; ?>
                                                                                    <?php foreach ($element as $ekey => $value): ?>
                                                                                        <td><?= $value ?></td>
                                                                                    <?php endforeach; ?>
                                                                                </tr>
                                                                                <?php $incrRow++ ?>
                                                                            <?php
                                                                                endforeach;
                                                                            endif;
                                                                            ?>
                                                                        </tbody>


                                                                    </table>
                                                                    <p class="small"><?= $this->input('INH_PP_Note_' . $uniqueId.'_'.$tableKey, ['placeholder' => 'Enter comment']); ?></p>
                                                    </div>
                                            <?php
                                            $noterow++;
                                            endforeach;
                                            endforeach;
                                        endif;
                                        ?>
                                    </section>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
                {% set pg = pg +1 %}
            {% endfor %}
        {% endif %}

        <div class="hide">

            {% set industrial_hose_data_list = [] %}

            {% if industrial_hose_data %}

                {% for key, value in industrial_hose_data %}
                    {% set mergeData = key~"$$"~value|join(',') %}
                    {% set industrial_hose_data_list = industrial_hose_data_list|merge(mergeData) %}
                {% endfor %}

                {% if industrial_hose_data_list %}
                    {% set industrial_hose_details_text = industrial_hose_data_list|join(nl2br) %}
                    {{ pimcore_textarea('industrial_hose_details').setDataFromResource(industrial_hose_details_text)| raw }}
                {% endif %}

            {% endif %}
        </div>
    
        <style>
            .inhsetting-sidebar.inhsettingLeft {
                border: solid 2px blue !important;
            }
            .inhsetting-sidebar.inhsettingRight {
                border: solid 2px red !important;
            }
        </style>

        {% if info['containerRequest'] is not defined %}
                <script type="text/javascript" src="/static/js/tableContinueLable.js"></script>
        {% endif %}

    {% endif %}

{% endblock %}