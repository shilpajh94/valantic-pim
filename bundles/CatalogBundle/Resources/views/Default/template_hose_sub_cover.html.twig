{% if not parentContainer is defined %}
    {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
 
{% if editmode %}
    {{ pimcore_relation("template_hose_product_page", {
        "types": ["object"],
        "subtypes": {
            "object": ["object"]
        },
        "classes": ["CatalogTables"]
    }) }}
{% endif %}
 
{% if data %}
    {% for catalogGroupKey, catalogGroupData in data %}
        {% set md5Key = catalogGroupKey|md5 %}
        <div class="template">
            <div class="segregate" id="subCover">
 
                <div id="pageHeader" class="alternate"></div>
 
                <div class="footer">
                    <footer class="flex-center {{ footer_class }}">
                        <span class="logo">
                            <b>
                                {% if editmode %}
                                    {% if pimcore_input("HHSC_Logo_Text1_" ~ md5Key).isEmpty() %}
                                        {{ pimcore_input("HHSC_Logo_Text1_" ~ md5Key).setDataFromResource('Hose') | raw}}
                                    {% else %}
                                        {{ pimcore_input("HHSC_Logo_Text1_" ~ md5Key) }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("HHSC_Logo_Text1_" ~ md5Key) }}
                                {% endif %}
                            </b>
                            <img src="{{ footer_logo_src }}">
                        </span>
                        <div class="flex aligned">
                            <h5>
                                {% if editmode %}
                                    {{ pimcore_image("HHSC_Footer_Image_" ~ md5Key, {"width": 40}) }}
                                {% else %}
                                    {% set imgSrcObj4 = pimcore_image("HHSC_Footer_Image_" ~ md5Key) %}
                                    {% if imgSrcObj4 %}
                                        <img src="{{getImageThumbnail(imgSrcObj4, imageWidth) }}" width="40"/>
                                    {% endif %}
                                {% endif %}
                                <font>
                                    {% if editmode %}
                                        {% if pimcore_input("HHSC_Footer_" ~ md5Key).isEmpty() %}
                                            {{ pimcore_input("HHSC_Footer_" ~ md5Key).setDataFromResource(catalogGroupKey) | raw}}
                                        {% else %}
                                            {{ pimcore_input("HHSC_Footer_" ~ md5Key) }}
                                        {% endif %}
                                    {% else %}
                                        {{ pimcore_input("HHSC_Footer_" ~ md5Key) }}
                                    {% endif %}
                                </font>
                            </h5>
                        </div>
                    </footer>
                </div>
 
                <div class="footer1">
                    <footer class="flex-center {{ footer_class }}">
                        <div class="flex aligned">
                            <h5>
                                {% if editmode %}
                                    {{ pimcore_image("HHSC_Footer_Image1_" ~ md5Key, {"width": 40}) }}
                                {% else %}
                                    {% set imgSrcObj3 = pimcore_image("HHSC_Footer_Image1_" ~ md5Key) %}
                                    {% if imgSrcObj3 %}
                                        <img src="{{getImageThumbnail(imgSrcObj3, imageWidth) }}" width="40"/>
                                    {% endif %}
                                {% endif %}
                                <font>
                                    {% if editmode %}
                                        {% if pimcore_input("HHSC_Footer1_" ~ md5Key).isEmpty() %}
                                            {{ pimcore_input("HHSC_Footer1_" ~ md5Key).setDataFromResource(catalogGroupKey) | raw}}
                                        {% else %}
                                            {{ pimcore_input("HHSC_Footer1_" ~ md5Key) }}
                                        {% endif %}
                                    {% else %}
                                        {{ pimcore_input("HHSC_Footer1_" ~ md5Key) }}
                                    {% endif %}
                                </font>
                            </h5>
                        </div>
                        <span class="logo">
                            <b>
                                {% if editmode %}
                                    {% if pimcore_input("HHSC_Logo_Text2_" ~ md5Key).isEmpty() %}
                                        {{ pimcore_input("HHSC_Logo_Text2_" ~ md5Key).setDataFromResource('Hose') | raw}}
                                    {% else %}
                                        {{ pimcore_input("HHSC_Logo_Text2_" ~ md5Key) }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("HHSC_Logo_Text2_" ~ md5Key) }}
                                {% endif %}
                            </b>
                            <img src="{{ footer_logo_src }}">
                        </span>
                    </footer>
                </div>
 
                <article class="containerAll noBorder coverPage">
                    <header class="dark">
                        {% if editmode %}
                            {{ pimcore_image("HHSC_Image_" ~ md5Key) }}
                        {% else %}
                            {% set imgSrcObj = pimcore_image("HHSC_Image_" ~ md5Key) %}
                            {% if imgSrcObj %}
                                <img src="{{getImageThumbnail(imgSrcObj, imageWidth) }}"/>
                            {% endif %}
                        {% endif %}
                    </header>
 
                    <nav class="marginBottom30">
                        <h4>{{ pimcore_input("HHSC_Heading_" ~ md5Key) }}</h4>
                    </nav>
 
                    <div class="fullcontainer single">
                        <p class="marginBottom30">
                            {{ pimcore_wysiwyg("HHSC_Description_" ~ md5Key, {"class": "marginBottom30"}) }}
                        </p>
 
                        <div class="marginTop30">
                            {% if editmode %}
                                {{ pimcore_image("HHSC_Title_Image_" ~ md5Key) }}
                            {% else %}
                                {% set imgSrcObj2 = pimcore_image("HHSC_Title_Image_" ~ md5Key) %}
                                {% if imgSrcObj2 %}
                                    <img src="{{getImageThumbnail(imgSrcObj2, imageWidth) }}" width="100%"/>
                                {% endif %}
                            {% endif %}
                        </div>
 
                        <table cellspacing="0" cellpadding="0" class="grid">
                            <thead>
                                <tr class="head noBorder">
                                    <td></td>
                                    {# <td>{{ translate('Page') }}</td>
                                    <td>{{ translate('Construction') }}</td>
                                    <td>{{ translate('Inner Tube') }}</td>
                                    <td>{{ translate('Working Pressure (psi)') }}</td>
                                    <td>{{ translate('Temperature Range') }}</td>
                                    <td>{{ translate('Fitting Series') }}</td>
                                    <td>{{ translate('Approvals') }}</td>
                                    <td>{{ translate('Packaging') }}</td> #}
                                </tr>
                            </thead>
 
                            {% if data %}
                                {% set incr = 1 %}
                                {% for md5brandKey, brandData in catalogGroupData %}
                                    {% if incr % 2 == 0 %}
                                        <tr class='tableNewFont'>
                                    {% else %}
                                        <tr class="active tableNewFont">
                                    {% endif %}
                                    <td><b>{{ brandData['brandName'] }}</b></td>
                                    <td>{{ pimcore_input("HHSC_Page_" ~ md5brandKey) }}</td>
                                    <td>{{ brandData['reinforcement'] }}</td>
                                    <td>{{ brandData['tubeMaterialAtrributeString'] }}</td>
                                    <td>{{ brandData['workingPressurePSIString'] }}</td>
                                    <td>{{ brandData['rangeTemperatureF'] }}</td>
                                    <td>{{ brandData['fittingFamily'] }}</td>
                                    <td>{{ pimcore_input("Construction_Type_" ~ md5brandKey).setDataFromResource(brandData['industryStandard']) | raw}}</td>
                                    <td>{{ brandData['CatalogPackaging'] }}</td>
                                </tr>
 
                                {% set incr = incr + 1 %}
                                {% endfor %}
                            {% endif %}
 
                        </table>
                    </div>
 
                </article>
 
            </div>
        </div>
    {% endfor %}
{% endif %}
{% endblock %}