												<td class="highlight"><b>{{ pimcore_input("CrossSection2").setDataFromResource('Cross Section') | raw }}</b></td>
												{% set CrossSection_value2 = pimcore_input("CrossSection_value2") %}
												<td>{{CrossSection_value2|raw}}</td>
											</tr>
											<tr>
												<td </td>
												<td></td>
												<td class="highlight"><b>{{ pimcore_input("Length2").setDataFromResource('Length (in)') | raw }}</b></td>
												{% set Length2_value = pimcore_input("Length2_value") %}
												<td>{{Length2_value|raw}}</td>
											<tr>
												<th colspan="2" >Available Length Range</th>
												<th colspan="2" >Available Length Range</th>
											</tr>

											{# Find max row count for iteration #}
											
											{% set banded = data.EffectiveLengths.banded|default({}) %}
											{% set vbelts = data.EffectiveLengths.vbelts|default({}) %}
											{% set bandedCount = banded|length %}
											{% set vbeltsCount = vbelts|length %}
											{% set maxRows = bandedCount > vbeltsCount ? bandedCount : vbeltsCount %}

											{% for i in 0..(maxRows - 1) %}
												<tr>
													{% set bandedKey = banded|keys[i]|default('') %}
													<td>{{ bandedKey }}</td>
													<td>{{ banded[bandedKey]|default('') }}</td>

													{% set vbeltsKey = vbelts|keys[i]|default('') %}
													<td>{{ vbeltsKey }}</td>
													<td>{{ vbelts[vbeltsKey]|default('') }}</td>
												</tr>
											{% endfor %}

