{% if not isParentContainerRequest %}
	{% extends "ptgeucatalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

    {% if editmode %}
        {{ pimcore_relation("ptg_eu_product_profile_page", {
                    "types" : ["object"],
                    "subtypes" : {
                    "object" : ["object"]
                    },
                    "classes" : ["PTGEUCatalogCategory"],
            }) }}
    {% endif %}

    {% if profileData is defined and profileData %}

        <div class="footer3">
            <p>
            {% set  PTGEU_disclaimer = pimcore_textarea("PTGEU_disclaimer_")%}
                 {% if editmode %}
                 {{pimcore_textarea("PTGEU_disclaimer_")}}
                    {% else %}
                    {% if not PTGEU_disclaimer.Empty %}
                    {{pimcore_textarea("PTGEU_disclaimer_")}}
                    {% endif %}
                    
                     {% endif %}
            </p>
            <hr/>
            <div class="mt-10">
                {% if editmode %}
                    <span class="mr-4 display-float-left">
                        {{ pimcore_image("PTGEU_Barcode_",{"width": 50, "height": 50}) }}
                    </span>
                {% else %}
                    {% set imgSrcObj1 = pimcore_image("PTGEU_Barcode_") %}
                    {% if getImageThumbnail(imgSrcObj1,imageWidth) %}
                        <span class="mr-4 display-float-left">
                            <img src="{{ getImageThumbnail(imgSrcObj1, imageWidth) }}" style="width:50px;" alt="PTG Barcode Image"/>
                        </span>
                    {% endif %}
                {% endif %}
                <div class="display-flow-root">
                    {{ pimcore_wysiwyg("PTGEU_ContactInfo_") }}
                </div>
            </div>
        </div>

        {% for profile, groupData in profileData %}

            {% set profileKey = md5Twig(groupData['brandName'] ~ profile) %}
            <div class="top-section page-break-before-always above edit-prev-mode-mt-50">
                {% if BrandLogoSrc %}
                    <div class="logo">
                        <img src="{{BrandLogoSrc}}" alt="logo"/>
                    </div>
                {% endif %}
                <div class="img-wrapper position-relative">
                    <div class="set1 bg-mask">
                        {% if editmode %}
                            <div class="attr-font text-center">Attribute Name = Main Image</div>
                            {% if pimcore_image("PTGEU_Product_MainImage_"~profileKey).isEmpty() %}
                                {{ pimcore_image("PTGEU_Product_MainImage_"~profileKey).setImage(groupData['mainImageObj']) | raw }}
                            {% else %}
                                {{ pimcore_image("PTGEU_Product_MainImage_"~profileKey) }}
                            {% endif %}
                        {% else %}
                            {% set imgSrcObj1 = pimcore_image("PTGEU_Product_MainImage_"~profileKey) %}
                            {% if getImageThumbnail(imgSrcObj1, imageWidth) %}
                                <img src="{{ getImageThumbnail(imgSrcObj1, imageWidth) }}" alt="logo"/>
                            {% endif %}
                        {% endif %}
                    </div>

                    <div class="abs">
                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Technical Image</div>
                            {% if pimcore_image("PTGEU_Product_TechnicalImage_"~profileKey).isEmpty() %}
                                {{ pimcore_image("PTGEU_Product_TechnicalImage_"~profileKey).setImage(groupData['technicalDrawing1Obj']) | raw }}
                            {% else %}
                                {{ pimcore_image("PTGEU_Product_TechnicalImage_"~profileKey) }}
                            {% endif %}
                        {% else %}
                            {% set imgSrcObj1 = pimcore_image("PTGEU_Product_TechnicalImage_"~profileKey) %}
                            {% if getImageThumbnail(imgSrcObj1, imageWidth) %}
                                <img src="{{ getImageThumbnail(imgSrcObj1, imageWidth) }}" alt="technical image"/>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
                <section class="">
                    <h4>
                        {% if editmode %}
                            {% if pimcore_input("PTG_Footer_BrandName_"~profileKey).isEmpty() %}
                                {{ pimcore_input("PTG_Footer_BrandName_"~profileKey).setDataFromResource(groupData['brandName']) | raw }}
                            {% else %}
                                {{ pimcore_input("PTG_Footer_BrandName_"~profileKey) }}
                            {% endif %}
                        {% else %}
                            {{ pimcore_input("PTG_Footer_BrandName_"~profileKey) }}
                        {% endif %}
                    </h4>

                    <h6>
                        {{ pimcore_input("PTGEU_Technical_Data_"~profileKey, {'placeholder': 'Technical Data'}) }}
                    </h6>

                    <table class="table1" aria-describedby="outer">

                        {% if groupData['profile'] is defined and groupData['profile'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Profile'|trans }}</th>
                                <td></td>
                                <td>{{ groupData['profile'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['beltDesign'] is defined and groupData['beltDesign'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Belt_design'|trans }}</th>
                                <td></td>
                                <td>
                                    {% set beltDesignCombine = [] %}
                                    {% set propertyKey = '' %}
                                    {% for key, value in groupData['beltDesign'] %}
                                        {% set propertyKey = key|trans %}
                                        {% set beltDesignCombine = beltDesignCombine|merge([propertyKey~": "~value]) %}
                                    {% endfor %}
                                    {{ implodeBR(beltDesignCombine)| raw }}
                                </td>
                            </tr>
                        {% endif %}

                        {% if groupData['upperRibWidth'] is defined and groupData['upperRibWidth'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Upper_rib_width'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_mm'|trans }}]</td>
                                <td>{{ groupData['upperRibWidth'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['beltHeight'] is defined and groupData['beltHeight'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Belt_height'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_mm'|trans }}]</td>
                                <td>{{ groupData['beltHeight'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['flankAngle'] is defined and groupData['flankAngle'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Flank_angle'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_degree'|trans }}]</td>
                                <td>{{ groupData['flankAngle'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['hardness'] is defined and groupData['hardness'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Hardness'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_hardness_shore_a'|trans }}]</td>
                                <td>{{ groupData['hardness'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['weightPerMLength'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Weight_per_m_length'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_kg_per_m'|trans }}]</td>
                                <td>{{ groupData['weightPerMLength'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['minDiameter'] is defined and groupData['minDiameter'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Min_diameter'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_mm'|trans }}]</td>
                                <td>{{ groupData['minDiameter'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['minBlackIdlerDiameter'] is defined and groupData['minBlackIdlerDiameter'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Min_black_idler_diameter'|trans }}</th>
                                <td>[{{ 'PTGEU_unit_mm'|trans }}]</td>
                                <td>{{ groupData['minBlackIdlerDiameter'] }}</td>
                            </tr>
                        {% endif %}

                        {% if groupData['properties'] is defined and groupData['properties'] %}
                            <tr>
                                <th scope="outer">{{ 'PTGEU_Properties'|trans }}</th>
                                <td></td>
                                <td>
                                    {% set propertiesCombine = [] %}
                                    {% set propertyKey = '' %}
                                    {% for key, value in groupData['properties'] %}
                                        {% set propertyKey = key|trans %}
                                        {% set propertiesCombine = propertiesCombine|merge([propertyKey ~" "~value]) %}
                                    {% endfor %}
                                    {{ implodeBR(propertiesCombine) | raw }}
                                </td>
                            </tr>
                        {% endif %}

                        {% if groupData['nominalLengthList'] is defined and groupData['nominalLengthList'] %}
                            <tr>
                                <th scope="outer">{{ groupData['nominalLength']|trans }}</th>

                                <td class="noPadding">
                                    <table aria-describedby="inner1">
                                        <tr>
                                            <th scope="inner1">&nbsp;</th>
                                        </tr>
                                        {% for key, value in groupData['nominalLengthList'] %}
                                            <tr>
                                                <td colspan="1">[{{ 'PTGEU_unit_mm'|trans }}]</td>
                                            </tr>
                                        {% endfor %}
                                    </table>
                                </td>

                                <td colspan="1" class="noPadding">
                                    <table aria-describedby="inner2">
                                        <tr>
                                            <th scope="inner2">{{ groupData['datumLengthColumn']|trans }}</th>
                                            <th scope="inner3">{{ 'PTGEU_Length_tolerance'|trans }}</th>
                                        </tr>

                                        {% for key, value in groupData['nominalLengthList'] %}
                                            <tr>
                                                <td>{{ value['datumLength'] }}</td>
                                                <td>{{ value['lengthTolerance']|raw }}</td>
                                            </tr>
                                        {% endfor %}
                                    </table>
                                </td>
                            </tr>
                        {% endif %}
                    </table>

                    <h6 class="mt-4">{{ pimcore_input("Schematic_belt_marking_and_production_code_"~profileKey,{'placeholder': 'Schematic belt marking and production code'}) }}</h6>

                    <div class="img-wrapper">
                        <div class="branding-img">

                            {% if editmode %}
                                    {{ pimcore_image("PTGEU_Product_BrandingImage_"~profileKey) }}
                            {% else %}
                                {% set imgSrcObj1 = pimcore_image("PTGEU_Product_BrandingImage_"~profileKey) %}
                                {% if getImageThumbnail(imgSrcObj1, imageWidth) %}
                                    <img src="{{ getImageThumbnail(imgSrcObj1, imageWidth) }}" alt="logo"/>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </section>
            </div>
        {% endfor %}
    {% endif %}
    <style>
        .footer3 p {
            margin-bottom: 0.3rem;
        }

        .footer3 {
            margin-left: 50px;
            margin-right: 50px;
            font-size: 10px;
            position: running(footer3);
        }
        @media print {
            .footer3 {
                padding-bottom: 50px;
            }
        }

        @page {
            margin: 50px 0 150px;
        }


        @page:left {
            @top-left-corner {
                content: '';
            }
            @top-right {
                content: '';
            }
            @bottom-center {
                content: element(footer3);
                z-index: 1;
            }
        }


        @page:right {
            @top-right-corner {
                content: '';
            }

            @top-left {
                content: '';
            }
            @bottom-center {
                content: element(footer3);
                z-index: 1;
            }
        }
    </style>
{% endblock %}
