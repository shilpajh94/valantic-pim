													<menu
														class="flex">
														{# {% if groupData['safetyFeatures'] %} #}
														<div class="specs">
															<h6>{{ 'section_page_pts_belts_features'|trans }}</h6>
															<div class="section-page-pts-belts-features ">
																<div class="features">
																	<ul>
																		{% for key, feature in data.FeaturesBenefitsBulletPoint %}
																			<li class="center">
																				{{ feature['name'] }}
																			</li>
																		{% endfor %}
																	</ul>
																</div>
																{% if ((data.material)|trim is not empty) or ((data.reinforcement)|trim is not empty) or ((data.temperatureRangeFAndC)|trim is not empty) %}
																	<div>
																		{% if data.material %}
																			<div class="full">
																				<b>{{ 'Material'|trans }}:</b>
																				{{ data.material }}
																			</div>
																		{% endif %}
																		{% if data.reinforcement %}
																			<div class="full">
																				<b>{{ 'Reinforcement'|trans }}:</b>
																				{{ data.reinforcement }}
																			</div>
																		{% endif %}
																		{% if data.temperatureRangeFAndC %}
																			<div class="full">
																				<b>{{ 'Temperature Range'|trans }}:</b>
																				{{ data.minimumTemperatureF }}&deg;F to {{ data.maximumTemperatureF }}&deg;F
																			</div>
																		{% endif %}
																	</div>
																{% endif %}
															</div>
														</div>

													</menu>
												{% endif %}
