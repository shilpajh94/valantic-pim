{% extends "catalog/layouts/layout.html.twig" %}

{% block _content %}

{% if data %}

    <div class="template">
        <section class="segregate">
            <!-- Footer -->

            <div class="footer">
                <footer class="footerNew">
                    <p class="tableFooter">
                        {{ pimcore_textarea("Chemical_Chart_Data_Comment", {'placeholder': 'Enter Chemical Chart Data Comment'}) }}
                    </p>
                    <div class="page-logo">
                        <img src="{{ footer_logo_src }}" class="logoImage">
                    </div>
                </footer>
            </div>

            <div class="footer1">
                <p class="tableFooter">
                    {{ pimcore_textarea("Chemical_Chart_Data_Comment1", {'placeholder' : 'Enter Chemical Chart Data Comment'}) }}
                </p>
                <footer class="footerNew">
                    <div class="page-logo">
                        <img src="{{ footer_logo_src }}" class="logoImage">
                    </div>
                </footer>
            </div>

            <!-- End Footer-->

            <div class="wrapper padding">
                <article class="container page-break-inside-avoid">

                    <!-- Starting grid here -->
                    <div class="inhRight">
                        <h1 class="borderBottom block contitech-black">Chemical Charts
                        </h1>

                        <div class="flex flex-end">
                            <div style=" width:14%"></div>
                            <div class="col-6">
                                <h6>Rating Scale</h6>
                                <div class="flex">
                                    <div class="col-6">
                                        <p><b>A</b> = May be used for Continuous Service</p>
                                        <p><b>I</b> = Insufficient data, contact customer service</p>
                                    </div>
                                    <div class="col-6">
                                        <p><b>B</b> = May be used for Intermittent Service</p>
                                        <p><b>X</b> = Do not use</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <h6>Gasket</h6>
                                <div class="flex">
                                    <div class="col-5">
                                        <p><b>T</b> = Teflon®</p>
                                        <p><b>V</b> = Viton®</p>
                                    </div>
                                    <div class="col-5">
                                        <p><b>N</b> = Polychloroprene</p>
                                        <p><b>S</b> = Silicone</p>
                                    </div>
                                    <div class="col-2">
                                        <p><b></b></p>
                                        <p>	<b></b></p>
                                        <p><b></b></p>
                                        <p style="margin-top: 2px;"><b>B</b> = Nitrile</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table class="grid chart" cellspacing="0" cellpadding="0">
                            <thead>
                                {% set tdCount = tubeMaterialheaders|length %}
                                <!-- Main header -->
                                <tr class="heading">
                                    <td width="" colspan="2" class="headingtd"></td>
                                    <td colspan="{{ tdCount }}" class="headingtd">
                                        <b>Continental Chemical Hose / Hose Tube Polymer</b>
                                    </td>
                                    <td colspan="6" class="apex">
                                        <b>Insta-Lock Fitting/Metal</b>
                                    </td>
                                </tr>

                                <tr class="sub-head">

                                    <td width="" class="widthxl1"></td>
                                    <td width="" class="widthxl2">{{ pimcore_input("Temp", {"placeholder" : "Temperature"}) }}</td>

                                    {% for i in 1..tdCount %}
                                        <td width="" class="widthxl">{{ pimcore_input("Brand_" ~ i, {"placeholder" : "Brand"}) }}</td>
                                    {% endfor %}

                                    <td width="" class="apex widthxl"></td>
                                    <td width="" class="apex widthxl"></td>
                                    <td width="" class="apex widthxl"></td>
                                    <td width="" class="apex widthxl"></td>
                                </tr>

                                <tr class="head">
                                    <td width=""></td>
                                    <td width="">{{ pimcore_input("TempUnit", {"placeholder": "TempUnit"}) }}</td>


                                    {% if (tubeMaterialheaders) %}
                                        {% for key,values in tubeMaterialheaders %}
                                            <td width="">{{ values }}</td>
                                        {% endfor %}
                                    {% endif %}
                                    {% for k, fittingGasketHeader in fittingMaterialheaders %}
                                        <td width="" class="apex">
                                            {{ fittingGasketHeader }}
                                        </td>
                                    {% endfor %}
                                    <td width="" class="apex">Gasket</td>
                                </tr>
                            </thead>
                            <tbody class="tableNewFont">

                                {% if data %}
                                    {% for key, productData in data %}

                                        {% set first_character = productData['chemicalName']|slice(0, 1) %}
                                        {% set firstCharacterCheck = '' %}
                                        {% if (first_character != firstCharacterCheck) %}
                                            <tr>
                                                <td colspan="{{ tdCount + 2 + 4 }}">
                                                    <h4>
                                                        {{first_character}}
                                                    </h4>
                                                </td>
                                            </tr>
                                        {% endif %}
                                        {% set firstCharacterCheck = first_character %}

                                        <tr class="">

                                            {% set j = 0 %}

                                            {% for key1, value in productData %}
                                                {% if (productData['tubeMaterial'] and key1 != 'chemicalName' and key1 != 'temperatureRating') %}
                                                    {% if (key1 == 'tubeMaterial') %}
                                                        {% for key2, value2 in tubeMaterialheaders %}

                                                            {% if value.value2 is defined %}
                                                                {% for key3, value3 in value %}
                                                                    {% if value2 == key3 %}
                                                                        {% if(value3 == null or value3 == "") %}
                                                                            <td>{{ "X" }}</td>
                                                                        {% else %}
                                                                            <td>{{ value3 }}</td>
                                                                        {% endif %}
                                                                    {% endif %}
                                                                {% endfor %}
                                                            {% else %}
                                                                <td>{{ "X" }}</td>
                                                            {% endif %}
                                                        {% endfor %}
                                                        {% set j = j + 1 %}
                                                    {% elseif (key1 == 'fittingMaterial') %}
                                                        {% if value is empty %}
                                                            {% for f in fittingMaterialheaders|length %}
                                                                <td class="apex">{{ "X" }}</td>
                                                            {% endfor %}
                                                        {% else %}

                                                            {% for key2, value2 in fittingMaterialheaders %}
                                                                {% if value.value2 is defined %}
                                                                    {% for key3, value3 in value %}
                                                                        {% if value2 == key3 %}
                                                                            {% if value3 == null or value3 == "" %}
                                                                                <td class="apex">{{ "X" }}</td>
                                                                            {% else %}
                                                                                <td class="apex">{{ value3 }}</td>
                                                                            {% endif %}
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                {% else %}
                                                                    <td class="apex">{{ "X" }}</td>
                                                                {% endif %}
                                                            {% endfor %}
                                                        {% endif %}
                                                        {% set j = j + 1 %}
                                                    {% elseif (key1 == 'gasket') %}
                                                        {% if (value) %}
                                                            {% set j = j + 1 %}
                                                            <td class="apex">
                                                                {{ value }}
                                                            </td>
                                                        {% else %}
                                                            <td class="apex">{{ "" }}</td>
                                                        {% endif %}
                                                    {% endif %}
                                                {% elseif (not productData['tubeMaterial'] and productData['fittingMaterial'] and productData['gasket'] and key1 != 'chemicalName' and key1 != 'temperatureRating') %}
                                                    {% if (key1 == 'tubeMaterial') %}
                                                        {% if value is empty %}
                                                            {% for t in 0..tdCount %}
                                                                <td>{{"X"}}</td>
                                                            {% endfor %}
                                                        {% endif %}

                                                    {% endif %}
                                                {% elseif (key1 == 'fittingMaterial') %}
                                                    {% if value is empty %}
                                                        {% for f in 0..fittingMaterialheaders|length %}
                                                            <td class="apex">{{"X"}}</td>
                                                        {% endfor %}
                                                    {% else %}
                                                        {% for key2, value2 in fittingMaterialheaders %}
                                                            {% if value.value2 is defined %}
                                                                {% for key3, value3 in value %}
                                                                    {% if (value2 == key3) %}
                                                                        {% if (value3 == null or value3 == "") %}
                                                                            <td class="apex">{{"X"}}</td>
                                                                        {% else %}
                                                                            <td class="apex">{{ value3 }}</td>
                                                                        {% endif %}
                                                                    {% endif %}
                                                                {% endfor %}
                                                            {% else %}
                                                                <td class="apex">{{"X"}}</td>
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% endif %}
                                                    {% set j = j + 1 %}
                                                {% elseif (key1 == 'gasket') %}
                                                    {% if (value) %}
                                                        {% set j = j + 1 %}
                                                        <td class="apex">{{ value }}</td>
                                                    {% else %}
                                                        <td class="apex">{{""}}</td>
                                                    {% endif %}

                                                {% set j = j + 1 %}
                                                {% elseif (not productData['tubeMaterial'] and not productData['fittingMaterial'] and productData['gasket'] and key1 != 'chemicalName' and key1 != 'temperatureRating') %}
                                                {% if (key1 == 'tubeMaterial') %}
                                                    {% if value is empty %}
                                                        {% for t in 0..tdCount %}
                                                            <td>{{"X"}}</td>
                                                        {% endfor %}
                                                    {% endif %}
                                                {% elseif (key1 == 'fittingMaterial') %}
                                                    {% if value is empty %}
                                                        {% for t in 0..3 %}
                                                            <td class="apex">{{"X"}}</td>
                                                        {% endfor %}
                                                    {% endif %}
                                                {% elseif (key1 == 'gasket') %}
                                                    {% if (value) %}
                                                        {% set j = j + 1 %}
                                                        <td class="apex">{{ value }}</td>
                                                    {% else %}
                                                        <td class="apex">{{""}}</td>
                                                    {% endif %}
                                                {% endif %}
                                                {% set j = j + 1 %}
                                                {% elseif (key1 == 'chemicalName' or key1 == 'temperatureRating') %}
                                                    <td class="tabletd">{{ value }}</td>
                                                {% endif %}
                                            {% endfor %}
                                        {% if (j == 0) %}
                                            <td colspan="{{tdCount + 4}}" class="NoHose">{{"No Hose Recommended For This Application"}}</td>
                                        {% endif %}
                                        </tr>
                                    {% endfor %}
                                {% endif %}

                            </tbody>
                        </table>
                    </div>
                </article>
            </div>
        </section>
    </div>
{% endif %}

<script type="text/javascript" src="/static/js/tableContinueLable.js"></script><style>

/* .chart.grid tbody tr{
            border-bottom:0 !important;
            border-top:0 !important;

        }

        .chart.grid tbody td{
            border-left: 5px solid white;
            border-right: 5px solid white;
            border-bottom:1px solid black !important;
        } */
.headingtd {
	padding: 5px 0;
}
.NoHose {
	font-weight: bold !important;
	font-size: 8px !important;
}
.tableFooter {
	padding: 0 40px;
	margin: 25px 0;
}
.page-logo {
	margin-right: 45px;
}
.footerNew {
	background: #fff;
	flex-wrap: nowrap !important;
	display: flex;
	align-items: flex-end;
	flex-direction: column;
}
.logoImage {
	max-width: 150px;
}

.inhRight h1 {
	margin: 0 !important;
	padding: 0 !important;
	font-size: 30px !important;
}

.widthxl1 {
	width: 90px !important;
	word-wrap: break-word !important;
}
.widthxl2 {
	width: 40px !important;
}
.widthxl {
	width: 50px !important;
}

h6 {
	font-size: 10px;
	margin-bottom: 0;
	padding-bottom: 0;
}

.chart.grid .sub-head td {
	border-bottom: 0 !important;
	padding: 5px 2px 0;
	word-break: break-all !important;
	vertical-align: bottom;
	/* border:1px solid red; */
	height: auto !important;
	word-wrap: break-word !important;
	font-size: 7px;
	font-weight: 950;
}

.chart.grid .head td {
	word-break: break-all !important;
	vertical-align: bottom;
	padding: 0 2px;
	/* border:1px solid green; */
	height: auto !important;
	word-wrap: break-word !important;
	font-size: 7px;
	font-weight: 950;
}

.tableNewFont td {
	font-size: 7px;
}

.heading td {
	vertical-align: middle;
	font-size: 7px !important;
	border-top: 1px solid black;
	border-bottom: 1px solid black;
	/* word-spacing: -1px;
            letter-spacing: 0px; */
}

.chart.grid {
	margin-top: 0;
	table-layout: unset;
}

.chart.grid td {
	height: auto;
	/* word-break:break-all !important; */
}

.apex {
	background: #f0f0f0;
}

.chart h4 {
	padding: 0;
	font-size: 9px;
	font-weight: 900;
}

.flex-end {
	justify-content: flex-end;
}

.flex-end .col-6 {
	flex: 1;
	width: 67%;
}
.flex-end .col-4 {
	max-width: 29%;
	flex: 1;
}

.flex-end p {
	padding: 2px 6px 2px 0;
	font-size: 9px;
	word-spacing: -1px;
}

@media print {
	.chart.grid {
		margin-top: -20px;
	}
}</style>{% endblock %}
