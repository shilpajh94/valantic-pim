{% if parentContainer is not defined %}
	{% extends "@ContitechCSCatalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	<div class="template pdf-page coverPage1">

		<div class="">
            {% if editmode %}
                <div class="error" >Warning: a minimum 300 dpi is file is required.</div>
            {% endif %}
            
			<div class="template without-header areaPdf">
                {% if editmode %}
                    {{ pimcore_pdf("pdf", {'placeholder': 'PDF drop'})}}
                {% else %}
                    {% if showPDFInput %}
                        {{ pimcore_pdf("pdf", {'placeholder': 'PDF drop'})}}
                    {% else %}
                        {% set element = pimcore_pdf("pdf").getElement() %}
                        {% if element %}
                            {% set path = getAssetFullPathCompatibleToS3(element) %}
                            <div id="pimcore-pdf" class="pimcore-pdfViewer">
                                <a href="{{path}}" target="_blank">
                                    <img alt="" src="{{path}}">
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
			</div>
		</div>
	</div>

	<style>
		#pimcore-pdf {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
		}

		#pimcore-pdf img {
			width: 100%;
			height: auto;
		}

		@media print {
			#pimcore-pdf img {
				width: 100%;
				height: 100%;
			}
		}

		.coverPage1 {
			page: title80;
			width: 100%;
			height: 100%;
			break-after: avoid;
			break-before: avoid;
		}

		.coverPage1 .footer2 {
			display: none;
			text-align: left;
			position: running(footer2);

		}

		.coverPage1 .footer3 {
			display: none;
			text-align: left;
			position: running(footer3);
		}

		@page title80 {
			margin: 0;
			padding: 0;
			content: counter(0);

			@top-right-corner {
				content: padding;
            }

			@top-left-corner {
				content: "";
			}

			@top-right {
				content: "";
			}
			@bottom-left {
				content: none;
			}
			@bottom-right {
				content: none;
			}
		}

		@page title80:left {
			@bottom-center {
				content: element(footer2);
				z-index: 1;
			}
		}

		@page title80:right {
			@bottom-center {
				content: element(footer3);
				z-index: 1;
			}
		}
	</style>
{% endblock %}
