									{% if  section_page_pts_belts_SIOP_level_3.isEmpty() %}
										{% set section_page_pts_belts_SIOP_level_3 = section_page_pts_belts_SIOP_level_3.setDataFromResource(data.SIOPLEVEL3) %}
									{% endif %}


									{% set section_page_pts_belts_SIOP_level_4 = pimcore_input("section_page_pts_belts_SIOP_level_4") %}
									{% if  section_page_pts_belts_SIOP_level_4.isEmpty() %}
										{% set section_page_pts_belts_SIOP_level_4 = section_page_pts_belts_SIOP_level_4.setDataFromResource(data.SIOPLEVEL4) %}

