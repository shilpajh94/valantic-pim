												<td>{{CrossSection_value1|raw}}</td>
												<td class="highlight"><b>{{ pimcore_input("Ribs").setDataFromResource('# Ribs') | raw }}</b></td>
												{% set Ribs_value = pimcore_input("Ribs_value") %}
												<td>{{Ribs_value|raw}}</td>
											</tr>
											<tr>
												<td class="highlight"><b>{{ pimcore_input("Length").setDataFromResource('Length (in)') | raw }}</b></td>
												{% set Length_value = pimcore_input("Length_value") %}
