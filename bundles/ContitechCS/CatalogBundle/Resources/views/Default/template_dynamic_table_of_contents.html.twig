{% if parentContainer is not defined %}
	{% extends "@ContitechCSCatalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
    <div class="wrapper">
        <header id="header">
            <div class="header-sec">
                <div class="header-txt"><span class="first-title">{{'CS_header_title'| trans}}</span>
                    <span class="second-title">
                        {{ pimcore_input("TOC_title",{"placeholder":"Table Of Contents"}) }}
                    </span>
                </div>
                <div class="print-pg-no"></div>
            </div>
        </header>
        <footer id="footer" class="footer">
            <div class="footer-logo">
                <img src="{{footer_logo_src}}" alt="" width="150">
            </div>
        </footer>
        <main id="content" role="main">
            <section class="table-content-sec">
                {% if editmode %}
                    {% if pimcore_input("CBS_TOC_Heading").isEmpty() %}
                        <h1 class="orange">{{ pimcore_input("CBS_TOC_Heading", {'placeholder' : 'Table of Contents'}) }}</h1>
                    {% else %}
                        <h1 class="orange">{{ pimcore_input("CBS_TOC_Heading") }}</h1>
                    {% endif %}
                {% else %}
                    <h1 class="orange">{{ pimcore_input("CBS_TOC_Heading") }}</h1>
                {% endif %}
                
                <div class="table-of-contents">
                    <div class="colum-2">
                        {% set i = 0 %}
                        {% set parents =  (data is defined and data) ? data|keys : [] %}

                        {% for incr0 in pimcore_block("CBS_TOC_HeadingBlock",{'default': parents|length}).iterator %}
                            {% set i = incr0- 1 %}
                            {% set headingVal =  (parents[i] is defined) ? parents[i] : '' %}
                            {% if editmode %}
                                <label>Enter section heading</label><br></br>
                            {% endif %}

                            <h3 class="orange-bg">
                                {% if pimcore_input("CBS_TOC_HeadingName").isEmpty() %}
                                    {{ pimcore_input("CBS_TOC_HeadingName", {'placeholder' : 'Enter heading'}).setDataFromResource(headingVal) | raw }}
                                {% else %}
                                    {{ pimcore_input("CBS_TOC_HeadingName", {'placeholder' : 'Enter heading'}) }}
                                {% endif %}
                            </h3>
                            <ul>
                                {% set j = 0 %}
                                {% set totalChilds =  (data[headingVal] is defined) ? data[headingVal] | length : 0 %}

                                {% for incr in pimcore_block("CBS_TOC_ContentBlock",{'default': totalChilds}).iterator %}
                                    {% set j = incr - 1 %}
                                    {% set pageTitle = '' %}
                                    {% if data[headingVal][j] is defined %}
                                        {% set pageTitle = data[headingVal][j] %}
                                    {% endif %}

                                    {% if editmode %}
                                        <li>
                                            <label><u>Enter page title</u></label><br>
                                        </li>
                                    {% endif %}
                                    
                                    <li>
                                        <span class="chapter">
                                            {% if pimcore_input("CBS_TOC_Title").isEmpty() %}
                                                {{ pimcore_input("CBS_TOC_Title", {'placeholder' : 'Enter title here.'}).setDataFromResource(pageTitle) | raw }}
                                            {% else %}
                                                {{ pimcore_input("CBS_TOC_Title", {'placeholder' : 'Enter title here.'}) }}
                                            {% endif %}
                                        </span>
                                        <span class="page">
                                            {{ pimcore_input("CBS_TOC_Page", {'placeholder' : 'Enter page number here.'}) }}
                                        </span>
                                    </li>
                                    <ul>
                                        {% for block in pimcore_block("CBS_TOC_ContentBlockInner").iterator %}
                                            {% if editmode %}
                                                <li>
                                                <label><u>Enter sub page title</u></label><br>
                                                </li>
                                            {% endif %}
                                            
                                            <li>
                                                <span class="chapter">
                                                    {{ pimcore_input("CBS_TOC_Title_Inner", {'placeholder' : 'Enter sub page title here.'}) }}
                                                </span>
                                                <span class="page">
                                                    {{ pimcore_input("CBS_TOC_Page_Inner", {'placeholder' : 'Enter page number here.'}) }}
                                                </span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endfor %}
                            </ul>
                        {% endfor %}
                    </div>
                </div>
            </section>
        </main>

    </div>
{% endblock %}