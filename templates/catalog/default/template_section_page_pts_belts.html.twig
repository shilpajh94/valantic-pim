											{% set section_page_pts_belts_Profile_Dimension_image  = pimcore_image("section_page_pts_belts_Profile_Dimension_image", {"width": 400, "height": 100}) %}

											{% if data.beltIdentificationImage %}
												{% set section_page_pts_belts_Identification_Image = section_page_pts_belts_Identification_Image.setImage(data.beltIdentificationImage) %}
											{% endif %}

											{% if data.profileDimensionPtsBelts %}
												{% set section_page_pts_belts_Profile_Dimension_image = section_page_pts_belts_Profile_Dimension_image.setImage(data.profileDimensionPtsBelts) %}
											{% endif %}
											{% if editmode %}
												{{section_page_pts_belts_Identification_Image|raw}}
												{{section_page_pts_belts_Profile_Dimension_image|raw}}
											{% else %}

												{% if section_page_pts_belts_Identification_Image %}
													<img class="section_page_pts_belts_Identification_Image" src="{{getImageThumbnail(section_page_pts_belts_Identification_Image, imageWidth)}}" alt=""/>
												{% endif %}
												{% if section_page_pts_belts_Profile_Dimension_image %}
													<img class="section_page_pts_belts_Profile_Dimension_image" src="{{getImageThumbnail(section_page_pts_belts_Profile_Dimension_image, imageWidth)}}" alt=""/>
												{% endif %}
											{% endif %}
										</div>
									</div>


									{% set section_page_pts_belts_Catalog_Asset_Right_Image = pimcore_image("section_page_pts_belts_Catalog_Asset_Right_Image", {"width": 400, "height": 200}) %}
									{% if data.mainImage %}
										{% set section_page_pts_belts_Catalog_Asset_Right_Image = section_page_pts_belts_Catalog_Asset_Right_Image.setImage(data.mainImage) %}
									{% endif %}
									{% if editmode %}
										{{section_page_pts_belts_Catalog_Asset_Right_Image|raw}}
									{% else %}

										{% if section_page_pts_belts_Catalog_Asset_Right_Image %}
											<div class="section_page_pts_belts_Catalog_Asset_Right_Image">
												<img id="section_page_pts_belts_Catalog_Asset_Image" src="{{getImageThumbnail(section_page_pts_belts_Catalog_Asset_Right_Image, imageWidth)}}" alt="section_page_pts_belts_Catalog_Asset_Right_Image"/>
