											</th>
											<th>
												<b>Pitch Length (mm)</b>
											</th>
											<th>
												<b>A</b>
											</th>
											<th>
												<b>B</b>
											</th>
											<th>
												<b>C</b>
											</th>
										</tr>

									</thead>
