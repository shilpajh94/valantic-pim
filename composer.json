{
  "name": "pimcore/skeleton",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "php-http/discovery": true,
      "symfony/runtime": true
    }
  },
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "coreshop/pimcore-bundle": "*",
    "coreshop/resource-bundle": "*",
    "coreshop/rule-bundle": "*",
    "cweagans/composer-patches": "^2.0.0-beta2",
    "elements/process-manager-bundle": "*",
    "league/flysystem-aws-s3-v3": "^3.12.0",
    "php-http/discovery": "^1.19",
    "pimcore/admin-ui-classic-bundle": "^1.4",
    "pimcore/bundle-generator": "^2.0",
    "pimcore/compatibility-bridge-v10": "^1.0",
    "pimcore/data-importer": "^1.9",
    "pimcore/ecommerce-framework-bundle": "^1.0",
    "pimcore/file-explorer-bundle": "^1.0",
    "pimcore/google-marketing-bundle": "^1.0",
    "pimcore/personalization-bundle": "^1.0",
    "pimcore/perspective-editor": "^1.8",
    "pimcore/pimcore": "11.2.*",
    "pimcore/system-info-bundle": "^1.0",
    "pimcore/web-to-print-bundle": "^1.1",
    "psr/http-factory-implementation": "*",
    "simplesamlphp/saml2": "4.6.10",
    "symfony/dotenv": "^6.2",
    "symfony/http-client": "^6.4",
    "symfony/http-foundation": "^6.4",
    "symfony/runtime": "^6.2",
    "valantic/pimcore-elastica-bridge": "^4.3"
  },
  "require-dev": {
    "codeception/codeception": "^5.0.3",
    "codeception/module-symfony": "^3.1.0"
  },
  "suggest": {
    "pimcore/data-hub": "Universal data interface for GraphQL, CSV and other formats"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Test\\": "tests/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject",
      "Pimcore\\Model\\Object\\": "var/classes/Object",
      "Website\\": "legacy/website/lib",
      "ADAuthBundle\\": "bundles/ADAuthBundle/src",
      "AppBundle\\": "bundles/AppBundle/src",
      "B2BTranslationBundle\\": "bundles/B2BTranslationBundle/src",
      "CatalogBundle\\": "bundles/CatalogBundle/src",
      "ClassRelationBundle\\": "bundles/ClassRelationBundle/src",
      "DistributionHubBundle\\": "bundles/DistributionHubBundle/src",
      "EmailNotificationBundle\\": "bundles/EmailNotificationBundle/src",
      "ImportBundle\\": "bundles/ImportBundle/src",
      "PimDataPostBundle\\": "bundles/PimDataPostBundle/src",
      "RequiredAttributesBundle\\": "bundles/RequiredAttributesBundle/src",
      "RestApiBundle\\": "bundles/RestApiBundle/src",
      "S3CustomizationBundle\\": "bundles/S3CustomizationBundle/src",
      "PTGEU\\ImportBundle\\": "bundles/PTGEU/ImportBundle/src",
      "PTGEU\\ProductBundle\\": "bundles/PTGEU/ProductBundle/src",
      "PTGEU\\CatalogBundle\\": "bundles/PTGEU/CatalogBundle/src",
      "IFSEU\\ProductBundle\\": "bundles/IFSEU/ProductBundle/src",
      "IFSEU\\ImportBundle\\": "bundles/IFSEU/ImportBundle/src",
      "IFSEU\\RestApiBundle\\": "bundles/IFSEU/RestApiBundle/src",
      "ContitechCS\\ImportBundle\\": "bundles/ContitechCS/ImportBundle/src",
      "ContitechCS\\ProductBundle\\": "bundles/ContitechCS/ProductBundle/src",
      "ContitechCS\\CatalogBundle\\": "bundles/ContitechCS/CatalogBundle/src",
      "ContitechCS\\CatalogUIApiBundle\\": "bundles/ContitechCS/CatalogUIApiBundle/src",
      "Instride\\Bundle\\DataDefinitionsBundle\\": "bundles/instride/data-definitions/src/DataDefinitionsBundle",
      "SSOIntegrationBundle\\": "bundles/SSOIntegrationBundle",
      "B2BSalesforcePTGEMEABundle\\": "bundles/B2BSalesforcePTGEMEABundle/src",
      "Pimcore\\Bundle\\DataHubBundle\\": "bundles/Pimcore/data-hub/src",
      "Pimcore\\Bundle\\DataImporterBundle\\": "bundles/Pimcore/data-importer/src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": "Pimcore\\Composer::postCreateProject",
    "post-install-cmd": [
      "Pimcore\\Composer::postInstall",
      "@pimcore-scripts"
    ],
    "post-update-cmd": [
      "Pimcore\\Composer::postUpdate",
      "@pimcore-scripts",
      "./bin/console doctrine:migrations:migrate"
    ],
    "pimcore-scripts": [
      "Pimcore\\Composer::clearCache",
      "Pimcore\\Composer::installAssets"
    ]
  },
  "extra": {
    "symfony-assets-install": "relative",
    "patches": {
      "pimcore/admin-ui-classic-bundle": {
        "Flag for English language": "./vendor-patches/pimcore/admin-ui-classic-bundle/english_language_flag.patch"
      }
    }
  }
}
