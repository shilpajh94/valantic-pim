{% if not isParentContainerRequest %}
        {% extends "catalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
<div class="template coverPage3">
    <div class="segregate ">
        {% if editmode %}
            <div class="error" >Warning: a minimum 300 dpi is file is required.</div>
        {% endif %}
            <div id="pageHeader"></div>
            <div class="footer">
                <footer class="flex-center ">
                    <span class="logo">
                        {% if editmode %}
                            {{ pimcore_image('PDF_PAGE_FOOTER1_LOGO', {"title":"Brand Logo"}) }}
                        {% else %}
                        <img src="{{ pimcore_image('PDF_PAGE_FOOTER1_LOGO').getSrc() }}" />
                        {% endif %}
                    </span>
                    <div class="flex aligned">
                        <h5 class="marginTop2">
                            {{ pimcore_input('PDF_PAGE_FOOTER1_BRAND', {"placeholder":"Brand"}) }}
                            <span>
                                {{ pimcore_input('PDF_PAGE_FOOTER1_CAT', {"placeholder":"eg: Enter Product Category"}) }}
                            </span>
                        </h5>
                        <div class="compatible">
                            {{ pimcore_wysiwyg('PDF_PAGE_FOOTER1_COMP_FITTING', {"placeholder":"eg: Enter Product Category"}) }}
                        </div>
                    </div>
                </footer>
            </div>

            <div class="footer1">
                <footer class="flex-center">
                    <div class="flex aligned">
                        <div class="compatible">
                            {{ pimcore_wysiwyg('PDF_PAGE_FOOTER2_COMP_FITTING', {"placeholder":"eg: Enter Product Category"}) }}
                        </div>
                        <h5 class="marginTop2">
                            {{ pimcore_input('PDF_PAGE_FOOTER2_BRAND', {"placeholder":"Brand"}) }}
                            <span>
                                {{ pimcore_input('PDF_PAGE_FOOTER2_CAT', {"placeholder":"eg: Enter Product Category"}) }}
                            </span>
                        </h5>
                    </div>
                    <span class="logo">
                         {% if editmode %}
                            {{ pimcore_image('PDF_PAGE_FOOTER2_LOGO', {"title":"Brand Logo"}) }}
                         {% else %}
                        <img src="{{ pimcore_image('PDF_PAGE_FOOTER2_LOGO').getSrc() }}" />
                         {% endif %}
                    </span>
                </footer>
            </div>
            <div class="without-header areaPdf">
                {% if editmode %}
                    {{ pimcore_pdf("pdfwithfooter", {'placeholder': 'PDF drop'})}}
                {% else %}
                    {% if showPDFInput %}
                        {{ pimcore_pdf("pdfwithfooter", {'placeholder': 'PDF drop'})}}
                    {% else %}
                        {% set element = pimcore_pdf("pdfwithfooter").getElement() %}
                        {% if element %}
                            {% set path = getAssetFullPathCompatibleToS3(element) %}
                            <div id="pimcore-pdf" class="pimcore-pdfViewer1">
                                <a href="{{path}}" target="_blank">
                                    <img alt="" src="{{path}}">
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>
    </div>
</div>
<style>

.pimcore-pdfViewer1{ height:100vh; /*overflow:hidden;*/ padding: 15px;}
.pimcore-pdfViewer1 img{ max-width:100%; width: 100%; 
height:auto; max-height:98%;}

.coverPage3{

break-after: avoid;
break-before: avoid;
}
</style>
{% endblock %}