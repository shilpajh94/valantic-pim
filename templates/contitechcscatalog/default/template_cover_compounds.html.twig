{% if not isParentContainerRequest %}
	{% extends "contitechcscatalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	{% if editmode %}
		{{ pimcore_relation('cbs_template_cover_compound_page', {
        'types' : ['object'],
        'subtypes' : {
            'object' : ['object']
        },
        'classes' : ['CSCatalogCategory'],
    }) }}
	{% endif %}

    {% if data is defined %}
        
        {% set coverCompound = data['coverCompoundData'] %}
        <div class="wrapper">
            <header id="header">
                <div class="header-sec">
                    <div class="header-txt"><span class="first-title">{{ 'CS_header_title'|trans }}</span>
                        <span class="second-title">
                                {% if pimcore_input("TBC_title").isEmpty() %}
                                    {{ pimcore_input("CC_title",{'placeholder' : 'Enter your title'}).setDataFromResource(HierarchyNameLevel2) | raw }}
                                {% else %}
                                    {{ pimcore_input("CC_title",{'placeholder' : 'Enter your title'}) }}
                                {% endif %}
                            </span>
                    </div>
                        <div class="print-pg-no"></div>
                    </div>
            </header>

            <footer id="footer" class="footer">
                <div class="footer-logo">
                    <img src="{{ footer_logo_src }}" alt="" width="150">
                </div>
            </footer>

            <main id="content" role="main">
                <section class="fortressxp-belts">
                    <div class="belts-information">
                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Name</div>
                        {% endif %}

                        <h1 class="orange">
                            <strong>
                                {% if editmode %}
                                    {% if pimcore_input("CS_ProductName").isEmpty() %}
                                        {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}).setDataFromResource(coverCompound['Name']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}) }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}) }}
                                {% endif %}
                            </strong>
                        </h1>

                        <span class="sub-title">
							{% if editmode %}
								<div class="attr-font">Attribute Name = Product Claim/Slogan</div>
							{% endif %}
							{% if editmode %}
								{% if pimcore_input("CC_ProductClaimSlogan").isEmpty() %}
									{{ pimcore_input("CC_ProductClaimSlogan",{'placeholder' : 'Enter Product Slogan'}).setDataFromResource(coverCompound['ProductClaimSlogan']) | raw }}
								{% else %}
									{{ pimcore_input("CC_ProductClaimSlogan",{'placeholder' : 'Enter Product Slogan'}) }}
								{% endif %}
							{% else %}
								{{ pimcore_input("CC_ProductClaimSlogan",{'placeholder' : 'Enter Product Slogan'}) }}
							{% endif %}
						</span>

                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Short Text</div>
                        {% endif %}
                        <div class="colum-2 p-0">
                            <p>
                                {% if editmode %}
                                    {% if pimcore_input("ContiC_ShortText").isEmpty() %}
                                        {{ pimcore_input("ContiC_ShortText",{'placeholder' : 'Enter Short Text'}).setDataFromResource(coverCompound['ShortText']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("ContiC_ShortText",{'placeholder' : 'Enter Short Text'}) }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("ContiC_ShortText",{'placeholder' : 'Enter Short Text'}) }}
                                {% endif %}
                            </p>

                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Long Text</div>
                            {% endif %}

                            <p>
                                {% if editmode %}
                                    {% if pimcore_input("ContiC_LongText").isEmpty() %}
                                        {{ pimcore_input("ContiC_LongText",{'placeholder' : 'Enter Long Text'}).setDataFromResource(coverCompound['LongText']) | raw }}
                                    {% else %}
                                        {{ pimcore_input("ContiC_LongText",{'placeholder' : 'Enter Long Text'}) }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("ContiC_LongText",{'placeholder' : 'Enter Long Text'}) }}
                                {% endif %}
                            </p>
                        </div>

                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Product Image</div>
                        {% endif %}

                        {% if editmode %}
                            <div class="full-image-sec">
                                {% if pimcore_image("CC_productImage").isEmpty() %}
                                    {{ pimcore_image("CC_productImage", {'height':370}).setImage(coverCompound['productImage']) | raw }}
                                {% else %}
                                    {{ pimcore_image("CC_productImage", {'height':370}) }}
                                {% endif %}
                            </div>
                        {% else %}
                            {% set productImgSrcObj = pimcore_image("CC_productImage") %}
							{% if productImgSrcObj.getId() is not empty %}
                                <div class="full-image-sec">
								    <img src="{{ getImageThumbnail(productImgSrcObj, imageWidth) }}" alt="" style="max-height:370px; width:auto;"/>
                                </div>
							{% endif %}
                        {% endif %}
                    </div>

                    <div class="page-break"></div>

                    <div class="belts-information">
                        <h1><span class="orange">
                            <strong>
                                {% if editmode %}
                                    {% if pimcore_input("CC_CCAA").isEmpty() %}
                                        {{ pimcore_input("CC_CCAA", {'placeholder' : 'Cover Compounds and Applications'}).setDataFromResource('Cover Compounds and Applications') | raw}}
                                    {% else %}
                                        {{ pimcore_input("CC_CCAA") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("CC_CCAA") }}
                                {% endif %}
                                
                            </strong>
                        </h1>

                        <div class = "application-info">
                            {% if editmode %}
                                {{ pimcore_relations("objectPaths", {'class' : 'cover_compounds_and_applications'}) }}
                            {% endif %}  
                        </div>

                        {% if data['CCAARows'] is defined %}
                            <div class="table-data compounds-table mb-4">
                                <table width="100%" class="white-bg">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th colspan="15" class="orange">
                                                {{ ('CS_Applications')|trans }}
                                            </th>
                                        </tr>
                                        <tr class="vertical-head">
                                            <th align="left" class="orange">
                                            {{ ('CS_Compounds')|trans }}
                                            </th>
                                        
                                            {% set applicationData = data['applicationData'] %}

                                            {% for key,value in applicationData %}
                                                <th class="rotate"><div>{{ value }};</div></th>
                                            {% endfor %}
                                            
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for key,row in data['CCAARows'] %}
                                            <tr align="center">
                                                {% set firstKey = row | keys | first %}
                                                {% for key,value in row %}
                                                    {% set style = '' %}
                                                    {% set class = '' %}
                                                    {% if firstKey == key %}
                                                        {% set style = 'align=left' %}
                                                    {% endif %}
                                                    {% if value == true %}
                                                        {% set class = 'class=orange-bg' %}
                                                        {% set value = '' %}
                                                    {% endif %}
                                                    <td  {{ style }} {{ class }} > {{ value }}; <span class="white-bg"></span></td>
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>

                    <div class="page-break"></div>

                    <div class="belts-information">
                        <h1 class="orange">
                            {% if editmode %}
                                {% if pimcore_input("CC_Title_Standard_Compounds").isEmpty() %}
                                    {{ pimcore_input("CC_Title_Standard_Compounds", {'placeholder' : 'Standard Compounds'}).setDataFromResource('Standard Compounds') | raw }}
                                {% else %}
                                    {{ pimcore_input("CC_Title_Standard_Compounds") }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("CC_Title_Standard_Compounds") }}
                            {% endif %}
                        </h1>

                        <div class = "standard-compounds">
                            <table>
                                <tr>
                                    <td>
                                        {% for incr in pimcore_block("contentblock", {'default': 9}).iterator %}
                                            <h3 style="margin-bottom : 0rem;">{{ pimcore_input("heading") }}</h2>
                                            <p class = 'description'>{{ pimcore_input("context") }}</p>
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% for incr1 in pimcore_block("contentblock1", {'default': 7}).iterator %}
                                            <h3 style="margin-bottom : 0rem;">{{ pimcore_input("heading1") }}</h2>
                                            <p>{{ pimcore_input("context1") }}</p>
                                        {% endfor %}
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="page-break"></div>

                    <div class="belts-information">
                        {% set singleProductPage = data['singleProductPage'] %}
                        {% if editmode %}
                            <div class="attr-font"> Attribute Name = Performance Category </div>
                        {% endif %}
                        <h1 class="orange">
                            {% if editmode %}
                                {% if pimcore_input("CCHRPage_NamePerformanceCategory").isEmpty() %}
                                    {{ pimcore_input("CCHRPage_NamePerformanceCategory", {'placeholder' : 'Enter Performance Category'}).setDataFromResource(singleProductPage['NamePerformanceCategory']) | raw }}
                                {% else %}
                                    {{ pimcore_input("CCHRPage_NamePerformanceCategory", {'placeholder' : 'Enter Performance Category'}) }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("CCHRPage_NamePerformanceCategory", {'placeholder' : 'Enter Performance Category'}) }}
                            {% endif %}
                        </h1>

                        {% if editmode %}
                            <div class="attr-font"> Attribute Name = Product Image </div>
                        {% endif %}
                        {% if editmode %}
							{% if pimcore_image("CCHRPage_productImage").isEmpty() %}
								{{ pimcore_image("CCHRPage_productImage", {'height':145}).setImage(singleProductPage['productImage']) | raw }}
							{% else %}
								{{ pimcore_image("CCHRPage_productImage", {'height':145}) }}
							{% endif %}
						{% else %}
							{% set CCHRPage_productImageObj = pimcore_image("CCHRPage_productImage") %}
							{% if CCHRPage_productImageObj.getId() is not empty %}
								<img src="{{ getImageThumbnail(CCHRPage_productImageObj, imageWidth) }}" class="w-100 mb-4"  alt="" style="max-height:145px; width:auto;"/>
							{% endif %}
						{% endif %}
                        
                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Long Text</div>
                        {% endif %}

                        <p>
                            {% if editmode %}
                                {% if pimcore_textarea("CCHRPage_LongText").isEmpty() %}
                                    {{ pimcore_textarea("CCHRPage_LongText",{'placeholder' : 'Enter Long Text'}).setDataFromResource(singleProductPage['LongText']) | raw }}
                                {% else %}
                                    {{ pimcore_textarea("CCHRPage_LongText",{'placeholder' : 'Enter Long Text'}) }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_textarea("CCHRPage_LongText",{'placeholder' : 'Enter Long Text'}) }}
                            {% endif %}
                        </p>

                        {% if singleProductPage['FeaturesAndBenefits'] is defined %}
                            
                            <div class="features-benefit-sec">
                                {% for fkey,feature in singleProductPage['FeaturesAndBenefits'] %}
                                    {% set md5FeatureNameKey = md5Twig(feature['FeatureName']) %}
                                    
                                    <div class="media">
                                        {% if editmode %}
                                            <div class="attr-font">Attribute Name = Feature Image</div>
                                        {% endif %}
                                        {% if editmode %}
                                            {% if pimcore_image("CCHRPageFeature_"~ md5FeatureNameKey).isEmpty() %}
                                                {{ pimcore_image("CCHRPageFeature_"~ md5FeatureNameKey).setImage(feature['FeatureImage']) | raw }}
                                            {% else %}
                                                {{ pimcore_image("CCHRPageFeature_"~ md5FeatureNameKey) }}
                                            {% endif %}
                                        {% else %}
                                            {% set CCHRPageFeatureImgSrcObj = pimcore_image("CCHRPageFeature_"~ md5FeatureNameKey) %}
                                            {% if CCHRPageFeatureImgSrcObj.getId() is not empty %}
                                                <img src="{{ getImageThumbnail(CCHRPageFeatureImgSrcObj, imageWidth)}}" class="features-images" alt=""/>
                                            {% endif %}
                                        {% endif %}
                                        
                                        <div class="media-body">
                                            {% if editmode %}
                                                <div class="attr-font">Attribute Name = Features And Benefits Name</div>
                                            {% endif %}
                                            <h2 class="orange">
                                                {% if editmode %}
                                                    {% if pimcore_input("CCHRPageFeatureTitle_"~ md5FeatureNameKey).isEmpty() %}
                                                        {{ pimcore_input("CCHRPageFeatureTitle_"~ md5FeatureNameKey, {'placeholder' : 'Enter Features Name'}).setDataFromResource(feature['FeatureName']) | raw }}
                                                    {% else %}
                                                        {{ pimcore_input("CCHRPageFeatureTitle_"~ md5FeatureNameKey, {'placeholder' : 'Enter Features Name'}) }}
                                                    {% endif %}
                                                {% else %}
                                                    {{ pimcore_input("CCHRPageFeatureTitle_"~ md5FeatureNameKey) }}
                                                {% endif %}
                                            </h2>
                                            {% if editmode %}
                                                <div class="attr-font">Attribute Name = Features Description</div>
                                            {% endif %}
                                            <p>
                                                {% if editmode %}
                                                    {% if pimcore_input("CCHRPageFeatureDesc_"~ md5FeatureNameKey).isEmpty() %}
                                                        {{ pimcore_input("CCHRPageFeatureDesc_"~ md5FeatureNameKey, {'placeholder' : 'Enter Features Description'}).setDataFromResource(feature['FeatureDescription']) | raw }}
                                                    {% else %}
                                                        {{ pimcore_input("CCHRPageFeatureDesc_"~ md5FeatureNameKey, {'placeholder' : 'Enter Features Description'}) }}
                                                    {% endif %}
                                                {% else %}
                                                    {{ pimcore_input("CCHRPageFeatureDesc_"~ md5FeatureNameKey) }}
                                                {% endif %}
                                            </p>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="environment-quality-sec environment-quality-sec-temprature">
                            <div class="media my-4">
                                {% if editmode %}
                                    {{ pimcore_image("CCHRPage_tempratureImage", {'height':400}) }}
                                {% else %}
                                    {% set CCHRPage_tempratureImageObj = pimcore_image("CCHRPage_tempratureImage") %}
                                    {% if CCHRPage_tempratureImageObj.getId() is not empty %}
                                        <img src="{{ getImageThumbnail(CCHRPage_tempratureImageObj, imageWidth) }}" class="features-images  ml-0"  alt="" style="max-height:400px; width:auto;">
                                    {% endif %}
                                {% endif %}

                                {% if singleProductPage['Level4ObjChildData'] is defined %}
                                    <div class="media-body pr-4">
                                        <table class="solar-shield-table">
                                            {% set count = 0 %}
                                            {% for chKey,chValue in singleProductPage['Level4ObjChildData']  %}
                                                {% set md5Key = md5Twig(chValue['Name'] ~ '_' ~ count) %}
                                                {% if not count > 3 %} 
                                                
                                                    {% set count = count + 1 %}
                                                    
                                                    <tr>
                                                        <td class="orange" width="25%">
                                                            {% if editmode %}
                                                                {% if pimcore_input("CCHRPageTitle_"~ md5Key).isEmpty() %}
                                                                    {{ pimcore_input("CCHRPageTitle_"~ md5Key, {'placeholder' : 'Solar-Shield Product'}).setDataFromResource(chValue['Name']) | raw }}
                                                                {% else %}
                                                                    {{ pimcore_input("CCHRPageTitle_"~ md5Key) }}
                                                                {% endif %}
                                                            {% else %}
                                                                {{ pimcore_input("CCHRPageTitle_"~ md5Key) }}
                                                            {% endif %}
                                                        </td>
                                                        <td width="75%">
                                                            {% if editmode %}
                                                                {% if pimcore_textarea("CCHRPageDesc_"~ md5Key).isEmpty() %}
                                                                    {{ pimcore_textarea("CCHRPageDesc_"~ md5Key, {'placeholder' : 'Solar-Shield Product Description'}).setDataFromResource(chValue['LongText']) | raw }}
                                                                {% else %}
                                                                    {{ pimcore_textarea("CCHRPageDesc_"~ md5Key) }}
                                                                {% endif %}
                                                            {% else %}
                                                                {{ pimcore_textarea("CCHRPageDesc_"~ md5Key) }}
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endif %}
                                            {% endfor %}
                                        </table>

                                        {% if editmode %}
                                            <p class="table-notes">
                                                {{ pimcore_textarea("CCHRPage_Comment", {'placeholder' : 'Enter Note'}) }}
                                            </p>
                                        {% else %}
                                            {% if not pimcore_textarea("CCHRPage_Comment").isEmpty() %}
                                                <p class="table-notes">
                                                    {{ pimcore_textarea("CCHRPage_Comment", {'placeholder' : 'Enter Note'}) }}
                                                </p>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        
                    </div>

                    <div class="belts-information">
                        <h1><span class="orange">
                            <strong>
                                {% if editmode %}
                                    {% if pimcore_input("CC_TableTitle").isEmpty() %}
                                        {{ pimcore_input("CC_TableTitle", {'placeholder' : 'Cover Compounds'}).setDataFromResource('Standard Compounds') | raw}}
                                    {% else %}
                                        {{ pimcore_input("CC_TableTitle") }}
                                    {% endif %}
                                {% else %}
                                    {{ pimcore_input("CC_TableTitle") }}
                                {% endif %}
                                
                            </strong>
                        </h1>

                        {% if editmode %}
                            {{ pimcore_relations("coverCompoundTableObjects", {'class' : 'cover_compounds_and_applications'}) }}
                        {% endif %}

                        {% set coverCompounds = data['coverCompounds'] %}
                        {% if coverCompounds is defined %}
                            <div class="cover-compounds-table">
                                <table width="100%">
                                    <thead>
                                        <tr>
                                            {% set coverCompoundsHeaderKeys = data['coverCompoundsHeaderKeys'] %}
                                            {% set firstKey = coverCompoundsHeaderKeys | keys | first %}
                                            {% set colspan = coverCompoundsHeaderKeys | length %}

                                            {% for hkey,headerValue in coverCompoundsHeaderKeys %}
                                                {% if firstKey == hkey %}
                                                    {% set style = 'align=center' %}
                                                {% endif %}
                                                <th {{ style }} >{{ (headerValue)|trans }}</th>
                                            {% endfor %}
                                        </tr>
                                    </thead>

                                    {% for coverCompoundType,coverCompoundArray in coverCompounds %}
                                        <tr>
                                            <th colspan="{{ colspan }};" class="orange-bg" align="left">{{ coverCompoundType }}</th>
                                        </tr>
                                        <tbody>
                                            {% for cc,ccArr in coverCompoundArray %}
                                                <tr align="center">
                                                {% set firstKey = ccArr | keys | first %}
                                                {% for tdKey,tdValue in ccArr %}
                                                    {% if firstKey == tdKey %}
                                                        {% set style = 'align=left' %}
                                                    {% else %}
                                                        {% set style = 'align=center' %}
                                                    {% endif %}
                                                    <td {{ style }}>{{ tdValue }}</td>
                                                {% endfor %}
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    {% endfor %}
                                </table>
                            </div>
                        {% endif %}
                    </div>

                </section>
            </main>

        </div>

    {% endif %}

{% endblock %}