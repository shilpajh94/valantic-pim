{% if parentContainer is not defined %}
        {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
<div class="template">
    <div id="descriptive">
        <div id="pageHeader"></div>
        <span  class="pageName">Index</span>

        <div class="numberTitle">
            {% if editmode %} 
                    {% if pimcore_input("HHIDN_Heading").isEmpty() %} 
                            <h2>{{ pimcore_input("HHIDN_Heading",{'placeholder':"Index Page Title"}).setDataFromResource('Index') | raw }} </h2>
                    {% else %}
                            <h2>{{ pimcore_input("HHIDN_Heading") }}</h2>
                    {% endif %}
            {% else %}
                    <h2>{{ pimcore_input("HHIDN_Heading") }}</h2>
            {% endif %}
        </div>
        <div id="amortizationTable" class="content_double single">
            {% if editmode %} 
                <div class="flex">
                    <div class="upper"> 
                        {% if editmode %} 
                                {% if pimcore_input("HHIDN_th_col_1").isEmpty() %} 
                                        {{ pimcore_input("HHIDN_th_col_1",{'placeholder':"Column 1"}).setDataFromResource('Descriptive #') | raw }}
                                {% else %}
                                        {{ pimcore_input("HHIDN_th_col_1",{'placeholder':"Column 1"}) }}
                                {% endif %}
                        {% else %}
                                {{ pimcore_input("HHIDN_th_col_1",{'placeholder':"Column 1"}) }}
                        {% endif %}
                    </div>

                    <div class="upper"> 
                        {% if editmode %} 
                                {% if pimcore_input("HHIDN_th_col_2").isEmpty() %} 
                                        {{ pimcore_input("HHIDN_th_col_2",{'placeholder':"Column 2"}).setDataFromResource('Page #') | raw }}
                                {% else %}
                                        {{ pimcore_input("HHIDN_th_col_2",{'placeholder':"Column 2"}) }}
                                {% endif %}
                        {% else %}
                                {{ pimcore_input("HHIDN_th_col_2",{'placeholder':"Column 2"}) }}
                        {% endif %}
                    
                    </div>
                </div>
                    
                {% for i in pimcore_block('HHIDN_Index_Content').iterator %}
                    <div class="paging">
                        <span class="pageTitle">{{ pimcore_input("HHIDN_td1",{'placeholder':"Page Title"}) }}</span>
                        <span class="pageNo">{{ pimcore_input("HHIDN_td2",{'placeholder':"Page No"}) }}</span>
                    </div>
                {% endfor %}
            {% else %}
                <table cellpadding="0" cellspacing="0" class="grid">
                        <thead>
                            <tr>
                            <td><span class="upper">{{ pimcore_input("HHIDN_th_col_1") }}</span></td>
                            <td align="right"><span class="upper">{{ pimcore_input("HHIDN_th_col_2") }}</span></td>
                            </tr>
                        </thead>
                        <tbody>
                            {% for i in pimcore_block('HHIDN_Index_Content').iterator %}
                                <tr>
                                    <td colspan="2">
                                    <div class="paging">
                                        <span class="pageTitle"><?= $this->input("HHIDN_td1"); ?></span>
                                        <span class="pageNo"><?= $this->input("HHIDN_td2"); ?></span>
                                    </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
<style>
div.content_double {
    -webkit-column-count: 2;
    -moz-column-count: 2;
    column-count: 2;
    -webkit-column-fill: auto;
    -moz-column-fill: auto;
    column-fill: auto;

}
</style>
{% endblock %}