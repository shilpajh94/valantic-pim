{% extends "@PTGEUCatalog/Layouts/layout.html.twig" %}

{% block _content %}

	{% if allChildren is defined and allChildren %}
		{% for child in allChildren %}

			{{ pimcore_inc(child, { isParentContainerRequest : true })}}

		{% endfor %}
	{% else %}

		<h1>No child document found</h1>
	{% endif %}
    
	<script type="text/javascript" src="/static/ptgeu/js/tableContinueLable.js"></script>
{% endblock %}