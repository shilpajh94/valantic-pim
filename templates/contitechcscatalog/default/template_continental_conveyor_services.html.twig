{% if not isParentContainerRequest %}
	{% extends "contitechcscatalog/layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	{% if editmode %}
		{{ pimcore_relation("cbs_template_belt_services_page", {
                "types" : ["object"],
                "subtypes" : {
                "object" : ["object"]
                },
                "classes" : ["CSCatalogCategory"],
        }) }}

    {% endif %}

    {% if data is defined and data %}
        <div class="wrapper conveyor-system">
            <header id="header">
                <div class="header-sec">
                    <div class="header-txt"><span class="first-title">{{'CS_header_title'|trans}}</span>
                        <span class="second-title">
                            {% if pimcore_input("CCS_title").isEmpty() %}
                                {{ pimcore_input("CCS_title", {'placeholder' : 'Enter your title'}).setDataFromResource(data['HierarchyNameLevel2']) | raw }}
                            {% else %}
                                {{ pimcore_input("CCS_title", {'placeholder' : 'Enter your title'}) }}
                            {% endif %}
                        </span>
                    </div>
                    <div class="print-pg-no"></div>
                </div>
            </header>
            <footer id="footer" class="footer">
                <div class="footer-logo">
                    <img src="{{footer_logo_src}}" alt="" width="150">
                </div>
            </footer>
            <main id="content" role="main">
                <section class="fortressxp-belts">
                    {% if editmode %}
                        <div class="attr-font">Attribute Name = Name</div>
                    {% endif %}
                    <h1 class="orange">
                        <span class="ccss-title">
                            {% if editmode %}
                                {% if pimcore_input("CCS_Name").isEmpty() %}
                                    {{ pimcore_input("CCS_Name", {'placeholder' : 'Enter Product Name'}).setDataFromResource(data['Name']) | raw }}
                                {% else %}
                                    {{ pimcore_input("CCS_Name", {'placeholder' : 'Enter Product Name'}) }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("CCS_Name", {'placeholder' : 'Enter Product Name'}) }}
                            {% endif %}   
                        </span>
                        
                        <span class="sub-title">
                            {% if editmode %}
                                <div class="attr-font">Attribute Name = PProduct Claim/Slogan</div>
                            {% endif %}

                            {% if editmode %}
                                {% if pimcore_input("CCS_ProductClaimSlogan").isEmpty() %}
                                    {{ pimcore_input("CCS_ProductClaimSlogan", {'placeholder' : 'Enter Product Slogan'}).setDataFromResource(data['ProductClaimSlogan']) | raw }}
                                {% else %}
                                    {{ pimcore_input("CCS_ProductClaimSlogan", {'placeholder' : 'Enter Product Slogan'}) }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("CCS_ProductClaimSlogan", {'placeholder' : 'Enter Product Slogan'}) }}
                            {% endif %}   
                        </span>
                    </h1>

                    <div class="p-medium">
                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Short Text</div>
                        {% endif %}
                        <p>
                            {% if editmode %}
                                {% if pimcore_textarea("CSS_ShortText").isEmpty() %}
                                    {{ pimcore_textarea("CSS_ShortText", {'placeholder' : 'Enter Short Text'}).setDataFromResource(data['ShortText']) | raw }}
                                {% else %}
                                    {{ pimcore_textarea("CSS_ShortText", {'placeholder' : 'Enter Short Text'}) }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_textarea("CSS_ShortText", {'placeholder' : 'Enter Short Text'}) }}
                            {% endif %}   
                        </p>
                    </div>

                    <div class="features-benefit-sec ccs-service">
                        {% if child['childrenData'] is defined and child['childrenData'] %}
                            {% for key, child in data['childrenData'] %}
                                {% if editmode %}
                                    <div class="attr-font">Child Attribute Name = Product Image</div>
                                {% endif %}
                                <div class="media">
                                    {% if child['ProductImage'] is defined and child['ProductImage'] and getImageThumbnail(child['ProductImage'],imageWidth) %}
                                        <img src="{{getImageThumbnail(child['ProductImage'],imageWidth)}}" width="150"  alt="" class="features-images">
                                    {% elseif default_image %}
                                        <img src="{{default_image}}" alt="" width="150" class="features-images">
                                    {% endif %}
                                    <div class="media-body">
                                        {% if editmode %}
                                            <div class="attr-font">Child Attribute Name = Name</div>
                                        {% endif %}
                                        <h2 class="orange">
                                            {% if editmode %}
                                                {% if pimcore_input("CSS_Name_"~key).isEmpty() %}
                                                    {{ pimcore_input("CSS_Name_"~key, {'placeholder' : 'Enter Child Name'}).setDataFromResource(child['Name']) | raw }}
                                                {% else %}
                                                    {{ pimcore_input("CSS_Name_"~key, {'placeholder' : 'Enter Child Name'}) }}
                                                {% endif %}
                                            {% else %}
                                                {{ pimcore_input("CSS_Name_"~key, {'placeholder' : 'Enter Child Name'}) }}
                                            {% endif %}   
                                        </h2>

                                        {% if editmode %}
                                            <div class="attr-font">Child Attribute Name = Long Text</div>
                                        {% endif %}
                                        <p>
                                            {% if editmode %}
                                                {% if pimcore_input("CSS_LongText_"~key).isEmpty() %}
                                                    {{ pimcore_input("CSS_LongText_"~key, {'placeholder' : 'Enter Long Text'}).setDataFromResource(child['LongText']) | raw }}
                                                {% else %}
                                                    {{ pimcore_input("CSS_LongText_"~key, {'placeholder' : 'Enter Long Text'}) }}
                                                {% endif %}
                                            {% else %}
                                                {{ pimcore_input("CSS_LongText_"~key, {'placeholder' : 'Enter Long Text'}) }}
                                            {% endif %}  
                                        </p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </section>
            </main>
        </div>
    {% endif %}
{% endblock %}