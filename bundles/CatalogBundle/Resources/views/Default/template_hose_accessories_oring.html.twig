{% if not isParentContainerRequest %}
        {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}
    {% if editmode %}

            {{ pimcore_relation("template_hose_accessories_oring",{
            "types": ["object"],
            "subtypes": {
                    "object": ["object"],
            },
            "classes": ["CatalogTables"]
            }) }}
    {% endif %}

    {% if data is defined and data %}
            {% set partNumbers = [] %}
            {% set productNumbers = [] %}
            <div class="template">
                    <section class="" id="oRing">
                    <div id="pageHeader"></div>
                    <span class="pageName">Hydraulic Hose</span>
                    <div class="footer">
                            <footer class="flex-center {{footer_class}}">
                            <span class="logo">
                                    <b>
                                    {% if editmode %} 
                                            {% if pimcore_input("HHAO_Logo_Text1").isEmpty() %} 
                                                    {{ pimcore_input("HHAO_Logo_Text1").setDataFromResource('Fittings') | raw }}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Logo_Text1") }}
                                            {% endif %}
                                    {% else %}
                                            {{ pimcore_input("HHAO_Logo_Text1") }}
                                    {% endif %}
                                    </b>
                                    <img src="{{footer_logo_src}}">
                            </span>
                            <div class="flex aligned">
                                    <h5>
                                    {% if editmode %}
                                            {% if pimcore_input("HHAO_Footer_Title1").isEmpty() %} 
                                                    {{ pimcore_input("HHAO_Footer_Title1").setDataFromResource('Fitting Accessories') | raw}}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Footer_Title1") }}
                                            {% endif %}
                                    {% else %}
                                            {{ pimcore_input("HHAO_Footer_Title1") }}
                                    {% endif %}
                                    <span>
                                            {% if editmode %}
                                                    {% if pimcore_input("HHAO_Footer_SubTitle1").isEmpty() %} 
                                                            {{ pimcore_input("HHAO_Footer_SubTitle1").setDataFromResource('O-Rings') | raw}}
                                                    {% else %}
                                                            {{ pimcore_input("HHAO_Footer_SubTitle1") }}
                                                    {% endif %}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Footer_SubTitle1") }}
                                            {% endif %}
                                    </span>
                                    </h5>
                            </div>
                            </footer>
                    </div>
                    <div class="footer1">
                            <footer class="flex-center {{footer_class}}">
                            <div class="flex aligned">
                                    <h5>
                                    {% if editmode %}
                                            {% if pimcore_input("HHAO_Footer_Title2").isEmpty() %} 
                                                    {{ pimcore_input("HHAO_Footer_Title2").setDataFromResource('Fitting Accessories') | raw}}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Footer_Title2") }}
                                            {% endif %}
                                    {% else %}
                                            {{ pimcore_input("HHAO_Footer_Title2") }}
                                    {% endif %}
                                    <span>
                                            {% if editmode %}
                                                    {% if pimcore_input("HHAO_Footer_SubTitle2").isEmpty() %} 
                                                            {{ pimcore_input("HHAO_Footer_SubTitle2").setDataFromResource('O-Rings') | raw}}
                                                    {% else %}
                                                            {{ pimcore_input("HHAO_Footer_SubTitle2") }}
                                                    {% endif %}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Footer_SubTitle2") }}
                                            {% endif %}
                                    </span>
                                    </h5>
                            </div>
                            <span class="logo">
                                    <b>
                                    {% if editmode %}
                                            {% if pimcore_input("HHAO_Logo_Text2").isEmpty() %} 
                                                    {{ pimcore_input("HHAO_Logo_Text2").setDataFromResource('Fittings') | raw}}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Logo_Text2") }}
                                            {% endif %}
                                    {% else %}
                                            {{ pimcore_input("HHAO_Logo_Text2") }}
                                    {% endif %}
                                    </b>
                                    <img src="{{footer_logo_src}}">
                            </span>
                            </footer>
                    </div>

                    <div class="single">
                            <header>
                            <h1 class="oRing">
                                    {% if editmode %}
                                            {% if pimcore_input("HHAO_Heading").isEmpty() %} 
                                                    {{ pimcore_input("HHAO_Heading").setDataFromResource('Fitting Accessories: O-Rings') | raw}}
                                            {% else %}
                                                    {{ pimcore_input("HHAO_Heading") }}
                                            {% endif %}
                                    {% else %}
                                            {{ pimcore_input("HHAO_Heading") }}
                                    {% endif %}
                            </h1>
                            </header>
                            <table cellpadding="0" cellspacing="0" class="orings">

                            <tr>
                                    <td valign="top" width="30%">
                                    &nbsp;
                                    <div class="description">
                                            {% if editmode %}
                                                    {% if pimcore_image("HHAO_Image").isEmpty() %}
                                                            {{ pimcore_image("HHAO_Image",{"width":200}) }}
                                                    {% else %}
                                                            {{ pimcore_image("HHAO_Image",{"width":200}).setImage(data['imageObj']) | raw}}
                                                    {% endif %}
                                            {% else %}
                                                    {% set imgSrcObj =  pimcore_image("HHAO_Image") %}
                                                    {% if imgSrcObj %}
                                                            <img src="{{ getImageThumbnail(imgSrcObj,imageWidth) }}" width="200"/>
                                                    {% endif %}
                                            {% endif %}
                                            <div class="material-desc">
                                            <table cellspacing="0" cellpadding="0">
                                                    {% if data['materialString'] %}
                                                    <tr>
                                                    <td valign="top">{# $this->translate('Material') #}</td>
                                                    <td valign="top">{{ data['materialString'] }}</td>
                                                    </tr>
                                                    {% endif %}

                                                    {% if data['hardness'] %}
                                                    <tr>
                                                    <td valign="top">{# $this->translate('Hardness') #}</td>
                                                    <td valign="top">{{ data['hardness'] }}</td>
                                                    </tr>
                                                    {% endif %}

                                                    {% if data['tempratureRange'] %}
                                                    <tr>
                                                    <td valign="top">{# $this->translate('Temprature Range') #}</td>
                                                    <td valign="top">{{ data['tempratureRange'] }}</td>
                                                    </tr>
                                                    {% endif %}
                                            </table>
                                            </div>
                                    </div>
                                    </td>

                                    <td width="70%">
                                    {% if data['brandData'] %}
                                            {% for md5key, brand in data['brandData'] %}
                                            <div class="marginBottom50">
                                                    <h3 class="contitech-yellow">
                                                    {% if editmode %}
                                                            {% if pimcore_input("HHAO_BrandName_"~md5key).isEmpty() %}
                                                                    {{ pimcore_input("HHAO_BrandName_"~md5key).setDataFromResource(brand['brandName']) | raw}}
                                                            {% else %}
                                                                    {{ pimcore_input("HHAO_BrandName_"~md5key) }}
                                                            {% endif %}
                                                    {% else %}
                                                            {{ pimcore_input("HHAO_BrandName_"~md5key) }}
                                                    {% endif %}
                                                    </h3>

                                                    {% set columnList=[] %}
                                                    
                                                    
                                                    <table class="grid inh" cellspacing="0" cellpadding="0">
                                                    <thead>
                                                            {% if (brand['iconRequired'] == 'YES') %}
                                                            <tr class="sub-head">
                                                                    {% for key, c1data in brand['columnsDataWithImages'] %}

                                                                    {% set columnWidth = '' %}
                                                                    {% set g1count = c1data|length %}
                                                                    {% set firstArray = c1data|first %}

                                                                    {% if (firstArray['columnWidth']) %}
                                                                            {% set columnWidth = "width="~firstArray['columnWidth'] %}
                                                                    {% endif %}

                                                                    <td colspan="{{g1count}}" {{columnWidth}}>
                                                                            {% if ( firstArray['columnIcon'] is defined and firstArray['columnIcon']) %}
                                                                                    <img src="{{firstArray['columnIcon']}}" width="45" height="45" />
                                                                            {% endif %}
                                                                    </td>
                                                                    {% endfor %}
                                                            </tr>
                                                            {% endif %}
                                                            
                                                            <tr class="head">
                                                                    {% for key, c2data in brand['columnsDataWithImages'] %}

                                                                            {% set columnWidth = '' %}
                                                                            {% set g2count = c2data|length %}
                                                                            {% set first2Array = c2data|first %}

                                                                            {% if (first2Array['columnWidth']) %}
                                                                                    {% set columnWidth = "width="~first2Array['columnWidth'] %}
                                                                            {% endif %}
                                                                            <td colspan="{{g2count}}" {{columnWidth}}>{{first2Array['columnLabel']}}</td>

                                                                    {% endfor %}
                                                            </tr>
                                                            
                                                            {% if (brand['subHeaderRequired'] == 'YES') %}
                                                                    <tr class="sub-head">
                                                                            {% for key, c3data in brand['columnsDataWithImages'] %}
                                                                                    {% for c3key, c3value in c3data %}
                                                                                            {% set columnList = columnList|merge([c3key]) %}
                                                                                            {% if (c3value['unitName']) %}
                                                                                                    <td>{{c3value['unitName']}}</td>
                                                                                            {% else %}
                                                                                                    <td></td>
                                                                                            {% endif %}
                                                                                    {% endfor %}
                                                                            {% endfor %}
                                                                    </tr>
                                                            {% endif %}
                                                    </thead>
                                                    <tbody>
                                                            {% set incrRow = 1 %}
                                                            {% for key, element in brand['articlesData'] %}

                                                            {% if (incrRow%2==0) %}
                                                                    <tr>
                                                            {% else %}
                                                                    <tr class="active">
                                                            {% endif %}
                                                            
                                                            {% if 'Descriptive' in columnList %}
                                                                    {% set columnKey = null %}
                                                                    {% for key, value in columnList %}
                                                                            {% if value == 'Descriptive' %}
                                                                            {% set columnKey = key %}
                                                                            {% endif %}
                                                                    {% endfor %}

                                                                    {% set descriptiveNumberText = element[columnKey] %}
                                                                    {% set descriptiveNumberList = descriptiveNumberText | split('-') %}

                                                                    {% if descriptiveNumberList[0] not in partNumbers %}
                                                                            {% set partNumbers = partNumbers|merge([descriptiveNumberList[0]]) %}
                                                                    {% endif %}

                                                            {% endif %}

                                                            {% if 'industryStandard' in columnList %}
                                                                    {% set columnKey = null %}
                                                                    {% for key, value in columnList %}
                                                                            {% if value == 'industryStandard' %}
                                                                            {% set columnKey = key %}
                                                                            {% endif %}
                                                                    {% endfor %}

                                                                    {% set industryStandardText = element[columnKey] %}
                                                                    {% set industryStandardList = industryStandardText | split('-') %}

                                                                    {% if industryStandardList[0] not in productNumbers %}
                                                                            {% set productNumbers = productNumbers|merge([industryStandardList[0]]) %}
                                                                    {% endif %}

                                                            {% endif %}

                                                            
                                                            {% for ekey, value in element %}
                                                                    <td>{{value}}</td>
                                                            {% endfor %}
                                                            </tr>
                                                            {% set incrRow = incrRow + 1 %}
                                                            {% endfor %}
                                                    </tbody>
                                                    </table>
                                                    <p class="small">
                                                            {{ pimcore_input("HHAO_note_"~md5key, {placeholder:'Enter comment'}) }}
                                                    </p>
                                            </div>
                                            {% endfor %}
                                    {% endif %}
                                    </td>
                            </tr>
                            </table>
                    </div>
                    </section>

                    <div class="hide">
                    {% if partNumbers|length > 0 %}
                            {% set partNumberString = partNumbers|join(',') %}
                            {{ pimcore_textarea('product_page_part_number').setDataFromResource(partNumberString) | raw}}
                    {% endif %}
                    
                    {% if productNumbers|length > 0 %}
                            {% set productNumbersString = productNumbers|join(',') %}
                            {{ pimcore_textarea('product_page_product_number').setDataFromResource(productNumbersString) | raw}}
                    {% endif %}
                    </div>
            </div>
    {% endif %}
{% endblock %}