							{% if  section_page_pts_belts_footer_SIOP5.isEmpty() %}
								{% set section_page_pts_belts_footer_SIOP5 = section_page_pts_belts_footer_SIOP5.setDataFromResource(data.SIOPLEVEL5) %}
							{% endif %}
							<h5>
								{% if editmode %}
									#{{section_page_pts_belts_footer_SIOP5|raw }}
								{% else %}
									#{{section_page_pts_belts_footer_SIOP5|raw }}
								{% endif %}

								<span>
