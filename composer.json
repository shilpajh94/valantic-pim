{
  "name": "pimcore/skeleton",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "prefer-stable": true,
  "require": {
    "elements/process-manager-bundle": "^5.0",
    "league/flysystem-aws-s3-v3": "^3.12.0",
    "pimcore/admin-ui-classic-bundle": "^1.3",
    "pimcore/bundle-generator": "^2.0",
    "pimcore/compatibility-bridge-v10": "^1.0",
    "pimcore/ecommerce-framework-bundle": "^1.0",
    "pimcore/file-explorer-bundle": "^1.0",
    "pimcore/google-marketing-bundle": "^1.0",
    "pimcore/personalization-bundle": "^1.0",
    "pimcore/pimcore": "^11.0",
    "pimcore/system-info-bundle": "^1.0",
    "pimcore/web-to-print-bundle": "^1.1",
    "symfony/dotenv": "^6.2",
    "symfony/runtime": "^6.2"
  },
  "require-dev": {
    "codeception/codeception": "^5.0.3",
    "codeception/module-symfony": "^3.1.0"
  },
  "suggest": {
    "pimcore/data-hub": "Universal data interface for GraphQL, CSV and other formats"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject",
      "Pimcore\\Model\\Object\\": "var/classes/Object",
      "Website\\": "legacy/website/lib",
      "ADAuthBundle\\": "bundles/ADAuthBundle",
      "AppBundle\\": "bundles/AppBundle",
      "B2BExportBundle\\": "bundles/B2BExportBundle",
      "B2BTranslationBundle\\": "bundles/B2BTranslationBundle",
      "CatalogBundle\\": "bundles/CatalogBundle/src",
      "ClassRelationBundle\\": "bundles/ClassRelationBundle",
      "DistributionHubBundle\\": "bundles/DistributionHubBundle",
      "EmailNotificationBundle\\": "bundles/EmailNotificationBundle",
      "ImportBundle\\": "bundles/ImportBundle",
      "PimDataPostBundle\\": "bundles/PimDataPostBundle",
      "RequiredAttributesBundle\\": "bundles/RequiredAttributesBundle",
      "RestApiBundle\\": "bundles/RestApiBundle",
      "S3CustomizationBundle\\": "bundles/S3CustomizationBundle",
      "PTGEU\\ImportBundle\\": "bundles/PTGEU/ImportBundle/src",
      "PTGEU\\ProductBundle\\": "bundles/PTGEU/ProductBundle",
      "PTGEU\\CatalogBundle\\": "bundles/PTGEU/CatalogBundle/src",
      "IFSEU\\ProductBundle\\": "bundles/IFSEU/ProductBundle",
      "IFSEU\\ImportBundle\\": "bundles/IFSEU/ImportBundle/src",
      "IFSEU\\RestApiBundle\\": "bundles/IFSEU/RestApiBundle",
      "ContitechCS\\ImportBundle\\": "bundles/ContitechCS/ImportBundle",
      "ContitechCS\\ProductBundle\\": "bundles/ContitechCS/ProductBundle",
      "ContitechCS\\CatalogBundle\\": "bundles/ContitechCS/CatalogBundle/src",
      "ContitechCS\\CatalogUIApiBundle\\": "bundles/ContitechCS/CatalogUIApiBundle/src",
      "Wvision\\Bundle\\DataDefinitionsBundle\\": "bundles/w-vision/data-definitions/src/DataDefinitionsBundle"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": "Pimcore\\Composer::postCreateProject",
    "post-install-cmd": [
      "Pimcore\\Composer::postInstall",
      "@pimcore-scripts"
    ],
    "post-update-cmd": [
      "Pimcore\\Composer::postUpdate",
      "@pimcore-scripts",
      "./bin/console doctrine:migrations:migrate"
    ],
    "pimcore-scripts": [
      "Pimcore\\Composer::clearCache",
      "Pimcore\\Composer::installAssets"
    ]
  }
}
