{% if parentContainer is not defined %}
        {% extends "@Catalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

{% if editmode %}

        {{ pimcore_relation("template_hose_accessories_clamps",{
        "types": ["object"],
        "subtypes": {
                "object": ["object"],
        },
        "classes": ["CatalogTables"]
        }) }}
{% endif %}


{% set partNumbers = [] %}
{% set productNumbers = [] %}

<div class="template">
        <section class="segregate">
                <div id="pageHeader"></div>
                <span class="pageName">Hydraulic Hose</span>

                <div class="footer">
                        <footer class="flex-center {{footer_class}}">
                                <span class="logo">
                                        <b>
                                                {% if editmode %} 
                                                        {% if pimcore_input("HHAC_Logo_Text1").isEmpty() %} 
                                                                {{ pimcore_input("HHAC_Logo_Text1").setDataFromResource('Hose') }}
                                                        {% else %}
                                                                {{ pimcore_input("HHAC_Logo_Text1") }}
                                                        {% endif %}
                                                {% else %}
                                                        {{ pimcore_input("HHAC_Logo_Text1") }}
                                                {% endif %}


                                        </b>
                                        <img src="{{ footer_logo_src }}">
                                </span>

                                <div class="flex aligned">
                                        <h5>
                                                {% if editmode %}
                                                        {% if pimcore_input("HHAC_Footer_Title1").isEmpty() %} 
                                                                {{ pimcore_input("HHAC_Footer_Title1").setDataFromResource('Hose Accessories') }}
                                                        {% else %}
                                                                {{ pimcore_input("HHAC_Footer_Title1") }}
                                                        {% endif %}
                                                {% else %}
                                                        {{ pimcore_input("HHAC_Footer_Title1") }}
                                                {% endif %}

                                                <span>
                                                        {% if editmode %}
                                                                {% if pimcore_input("HHAC_Footer_SubTitle1").isEmpty() %} 
                                                                        {{ pimcore_input("HHAC_Footer_SubTitle1").setDataFromResource('Routing Clamps') }}
                                                                {% else %}
                                                                        {{ pimcore_input("HHAC_Footer_SubTitle1") }}
                                                                {% endif %}
                                                        {% else %}
                                                                {{ pimcore_input("HHAC_Footer_SubTitle1") }}
                                                        {% endif %}
                                                </span>
                                        </h5>
                                </div>
                        </footer>
                </div>

                <div class="footer1">
                        <footer class="flex-center {{ footer_class }}">
                                <div class="flex aligned">
                                        <h5>
                                                {% if editmode %}
                                                        {% if pimcore_input("HHAC_Footer_Title2").isEmpty() %} 
                                                                {{ pimcore_input("HHAC_Footer_Title2").setDataFromResource('Hose Accessories') }}
                                                        {% else %}
                                                                {{ pimcore_input("HHAC_Footer_Title2") }}
                                                        {% endif %}
                                                {% else %}
                                                        {{ pimcore_input("HHAC_Footer_Title2") }}
                                                {% endif %}

                                                <span>
                                                        {% if editmode %}
                                                                {% if pimcore_input("HHAC_Footer_SubTitle2").isEmpty() %} 
                                                                        {{ pimcore_input("HHAC_Footer_SubTitle2").setDataFromResource('Routing Clamps') }}
                                                                {% else %}
                                                                        {{ pimcore_input("HHAC_Footer_SubTitle2") }}
                                                                {% endif %}
                                                        {% else %}
                                                                {{ pimcore_input("HHAC_Footer_SubTitle2") }}
                                                        {% endif %}
                                                </span>
                                        </h5>
                                </div>

                                <span class="logo">
                                        <b>
                                                {% if editmode %}
                                                        {% if pimcore_input("HHAC_Logo_Text2").isEmpty() %} 
                                                                {{ pimcore_input("HHAC_Logo_Text2").setDataFromResource('Hose') }}
                                                        {% else %}
                                                                {{ pimcore_input("HHAC_Logo_Text2") }}
                                                        {% endif %}
                                                {% else %}
                                                        {{ pimcore_input("HHAC_Logo_Text2") }}
                                                {% endif %}
                                        </b>
                                        <img src="{{ footer_logo_src }}">
                                </span>
                        </footer>
                </div>

                <div class="wrapper">
                        <article class="container noBorder">
                                <section class="content single">

                                        {% if data %}
                                                {% set onlyOneTitle = false %}

                                                {% for md5key, brand in data %}

                                                        <figure class="justify-between">

                                                                <figcaption>
                                                                        {% if not onlyOneTitle %}
                                                                                <h2>
                                                                                        {% if editmode %}
                                                                                                {% if pimcore_input("HHAC_Heading"~md5key).isEmpty() %}
                                                                                                        {{ pimcore_input("HHAC_Heading"~md5key).setDataFromResource("Hose Accessories") }}
                                                                                                {% else %}
                                                                                                        {{ pimcore_input("HHAC_Heading"~md5key) }}
                                                                                                {% endif %}
                                                                                        {% else %}
                                                                                                {{ pimcore_input("HHAC_Heading"~md5key) }}
                                                                                        {% endif %}
                                                                                
                                                                                </h2>
                                                                                {% set onlyOneTitle = true %}
                                                                        {% endif %}
        
                                                                        <h3 class="contitech-yellow">
                                                                                {% if editmode %}
                                                                                        {% if pimcore_input("HHAC_BrandName_"~md5key).isEmpty() %}
                                                                                                {{ pimcore_input("HHAC_BrandName_"~md5key).setDataFromResource(brand['brandName']) }}
                                                                                        {% else %}
                                                                                                {{ pimcore_input("HHAC_BrandName_"~md5key) }}
                                                                                        {% endif %}
                                                                                {% else %}
                                                                                        {{ pimcore_input("HHAC_BrandName_"~md5key) }}
                                                                                {% endif %}
                                                                        </h3>

                                                                        <span>
                                                                                {% if editmode %}
                                                                                        {% if pimcore_input("HHAC_LongDescription_"~md5key).isEmpty() %}
                                                                                                {{ pimcore_input("HHAC_LongDescription_"~md5key).setDataFromResource(brand['longDescription']) }}
                                                                                        {% else %}
                                                                                                {{ pimcore_input("HHAC_LongDescription_"~md5key) }}
                                                                                        {% endif %}
                                                                                {% else %}
                                                                                        {{ pimcore_input("HHAC_LongDescription_"~md5key) }}
                                                                                {% endif %}
                                                                        </span>
                                                                        
                                                                        {% if brand['materialString']|trim is not empty %}
                                                                                <menu>
                                                                                        <div class="specs">
                                                                                                <h6 class="small contitech-black">{# <?= $this->translate('specs') ?>#}</h6>
                                                                                                <div class="spec-requirement">
                                                                                                        <div>
                                                                                                                {% if brand['materialString']|trim is not empty %}
                                                                                                                        <p class="small">
                                                                                                                                <b>{# <?= $this->translate('Material') ?> #}</b>
                                                                                                                                {{ brand['materialString'] }}
                                                                                                                        </p>
                                                                                                                {% endif %}
                                                                                                        </div>
                                                                                                </div>
                                                                                        </div>
                                                                                </menu>
                                                                        {% endif %}
                                                                </figcaption>

                                                                {% if editmode %}
                                                                        {% if pimcore_image("HHAC_Image_"~md5key).isEmpty() %}
                                                                                {{ pimcore_image("HHAC_Image_"~md5key,{"width":200, "height":200}) }}
                                                                        {% else %}
                                                                                {{ pimcore_image("HHAC_Image_"~md5key,{"width":200, "height":200}).setImage(brand['imageObj']) }}
                                                                        {% endif %}
                                                                {% else %}
                                                                        {% set imgSrcObj =  pimcore_image("HHAC_Image_"~md5key) %}
                                                                        {% if imgSrcObj %}
                                                                                <img src="{{ getImageThumbnail(imgSrcObj,imageWidth) }}" height="200" width="200"/>
                                                                        {% endif %}
                                                                {% endif %}
                                                        </figure>

                                                        <table class="grid inh" cellspacing="0" cellpadding="0">
                                                                <thead>
                                                                        {% if (iconRequired == 'YES') %}
                                                                                <tr class="sub-head">
                                                                                        {% for key, c1data in brand['columnsDataWithImages'] %}

                                                                                                {% set columnWidth = '' %}
                                                                                                {% set g1count = c1data|length %}
                                                                                                {% set firstArray = c1data|first %}

                                                                                                {% if (firstArray['columnWidth']) %}
                                                                                                        {% set columnWidth = "width="~firstArray['columnWidth'] %}
                                                                                                {% endif %}

                                                                                                <td colspan="{{g1count}}" {{columnWidth}}>
                                                                                                        {% if ( firstArray['columnIcon'] is defined and firstArray['columnIcon']) %}
                                                                                                                <img src="{{firstArray['columnIcon']}}" width="45" height="45" />
                                                                                                        {% endif %}
                                                                                                </td>
                                                                                        {% endfor %}
                                                                                </tr>
                                                                        {% endif %}
                                                                        
                                                                        <tr class="head">
                                                                                {% for key, c2data in brand['columnsDataWithImages'] %}

                                                                                        {% set columnWidth = '' %}
                                                                                        {% set g2count = c2data|length %}
                                                                                        {% set first2Array = c2data|first %}

                                                                                        {% if (first2Array['columnWidth']) %}
                                                                                                {% set columnWidth = "width="~first2Array['columnWidth'] %}
                                                                                        {% endif %}
                                                                                        <td colspan="{{g2count}}" {{columnWidth}}>{{first2Array['columnLabel']}}</td>

                                                                                {% endfor %}
                                                                        </tr>

                                                                        
                                                                        {% if (subHeaderRequired == 'YES') %}
                                                                                <tr class="sub-head">
                                                                                        {% for key, c3data in brand['columnsDataWithImages'] %}
                                                                                                {% for c3key, c3value in c3data %}
                                                                                                        {% if (c3value['unitName']) %}
                                                                                                                <td>{{c3value['unitName']}}</td>
                                                                                                        {% else %}
                                                                                                                <td></td>
                                                                                                        {% endif %}
                                                                                                {% endfor %}
                                                                                        {% endfor %}
                                                                                </tr>
                                                                        {% endif %}
                                                                </thead>
                                                                <tbody>
                                                                        {% set incrRow = 1 %}
                                                                        {% for key, element in brand['articlesData'] %}
                                                                                {% if (incrRow%2==0) %}
                                                                                        <tr>
                                                                                {% else %}
                                                                                        <tr class="active">
                                                                                {% endif %}
                                                                        
                                                                                {% if element['Descriptive'] is defined %}
                                                                                        {% set descriptiveNumberText = element['Descriptive'] %}
                                                                                        {% set descriptiveNumberList = descriptiveNumberText | split('-') %}

                                                                                        {% if descriptiveNumberList[0] not in partNumbers %}
                                                                                                {% set partNumbers = partNumbers|merge([descriptiveNumberList[0]]) %}
                                                                                        {% endif %}

                                                                                {% endif %}

                                                                                {% if element['industryStandard'] is defined %}
                                                                                        {% set industryStandardText = element['industryStandard'] %}
                                                                                        {% set industryStandardList = industryStandardText | split('-') %}

                                                                                        {% if industryStandardList[0] not in productNumbers %}
                                                                                                {% set productNumbers = productNumbers|merge([industryStandardList[0]]) %}
                                                                                        {% endif %}

                                                                                {% endif %}

                                                                                {% for ekey, value in element %}
                                                                                        <td>{{value}}</td>
                                                                                {% endfor %}
                                                                                </tr>
                                                                                {% set incrRow = incrRow + 1 %}
                                                                        {% endfor %}
                                                                </tbody>
                                                        </table>
                                                        <p class="small">
                                                                {{ pimcore_input("HHAC_note_"~md5Key, {placeholder:'Enter comment'}) }}
                                                        </p>
                                                {% endfor %}
                                        {% endif %}
                                </section>
                        </article>
                </div>
        </section>

        <div class="hide">
                {% if partNumbers|length > 0 %}
                        {% set partNumberString = partNumbers|join(',') %}
                        {{ pimcore_textarea('product_page_part_number').setDataFromResource(partNumberString)}}
                {% endif %}
                
                {% if productNumbers|length > 0 %}
                        {% set productNumbersString = productNumbers|join(',') %}
                        {{ pimcore_textarea('product_page_product_number').setDataFromResource(productNumbersString)}}
                {% endif %}
        </div>
</div>
{% endblock %}