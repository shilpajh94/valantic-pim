{% if parentContainer is not defined %}
	{% extends "@ContitechCSCatalog/Layouts/layout.html.twig" %}
{% endif %}

{% block _content %}

	{% if editmode %}
		{{ pimcore_relation("cbs_mega_pipe_belt", {
                "types" : ["object"],
                "subtypes" : {
                "object" : ["object"]
                },
                "classes" : ["CSCatalogTables"],
        }) }}

    {% endif %}

    {% if data is defined and data %}
        <div class="wrapper">
            <header id="header">
                <div class="header-sec">
                    <div class="header-txt"><span class="first-title">{{'CS_header_title'|trans}}</span>
                        <span class="second-title">
                            {% if pimcore_input("MPB_title").isEmpty() %}
                                {{ pimcore_input("MPB_title", {'placeholder' : 'Enter your title'}).setDataFromResource(data['HierarchyNameLevel2']) | raw }}
                            {% else %}
                                {{ pimcore_input("MPB_title", {'placeholder' : 'Enter your title'}) }}
                            {% endif %}
                        </span>
                    </div>
                        <div class="print-pg-no"></div>
                    </div>
            </header>

            <footer id="footer" class="footer">
                <div class="footer-logo">
                    <img src="{{footer_logo_src}}" alt="" width="150">
                </div>
            </footer>

            <main id="content" role="main">
                <section class="fortressxp-belts">
                    {% if editmode %}
                        <div class="attr-font">Attribute Name = Name</div>
                    {% endif %}
                    <h1 class="orange">  
                        {% if editmode %}
                            {% if pimcore_input("CS_ProductName").isEmpty() %}
                                {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}).setDataFromResource(data['Name']) | raw }}
                            {% else %}
                                {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}) }}
                            {% endif %}
                        {% else %}
                            {{ pimcore_input("CS_ProductName", {'placeholder' : 'Enter Product Name'}) }}
                        {% endif %}                     
                    
                        <span class="sub-title">
                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Product Claim/Slogan</div>
                            {% endif %}
                            {% if editmode %}
                                {% if pimcore_input("MPB_ProductClaimSlogan").isEmpty() %}
                                    {{ pimcore_input("MPB_ProductClaimSlogan", {'placeholder' : 'Enter Product Slogan'}).setDataFromResource(data['ProductClaimSlogan']) | raw }}
                                {% else %}
                                    {{ pimcore_input("MPB_ProductClaimSlogan", {'placeholder' : 'Enter Product Slogan'}) }}
                                {% endif %}
                            {% else %}
                                {{ pimcore_input("MPB_ProductClaimSlogan", {'placeholder' : 'Enter Product Slogan'}) }}
                            {% endif %}
                        </span>
                    </h1>

                    <div class="p-medium">
                        {% if editmode %}
                            <div class="attr-font">Attribute Name = Short Text</div>
                        {% endif %}

                        {% if editmode %}
                            {% if pimcore_wysiwyg("MPB_ShortText").isEmpty() %}
                                {{ pimcore_wysiwyg("MPB_ShortText", {'placeholder' : 'Enter Short Text'}).setDataFromResource(data['ShortText']) | raw }}
                            {% else %}
                                {{ pimcore_wysiwyg("MPB_ShortText", {'placeholder' : 'Enter Short Text'}) }}
                            {% endif %}
                        {% else %}
                            {{ pimcore_wysiwyg("MPB_ShortText", {'placeholder' : 'Enter Short Text'}) }}
                        {% endif %}
                    </div>
                    
                    <div class="feature-benefit-list">

                        {% if data['Features'] is defined and data['Features'] %}
                        
                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Features</div>
                            {% endif %}
                            <h3 class="orange">
                                {{ pimcore_input("ST_advantage_heading", {'placeholder' : 'Technical Information'}) }}
                            </h3>
                            <ul>
                                {% for key, item in data['Features'] %}
                                    <li>
                                        {{item}}
                                    </li>
                                {% endfor %}
                            </ul>
                                
                        {% endif %}
                                
                        {% if data['CSProductFeaturesAndBenefits'] is defined and data['CSProductFeaturesAndBenefits'] %}
                            {% if editmode %}
                                <div class="attr-font">Attribute Name = Features and Benefits</div>
                            {% endif %}
                            
                            <h3 class="orange black-bold mb-0 mt-4">{{ pimcore_input("Features_heading",{"placeholder": "Features and Benefits"}) }}</h3>
                            <ul>
                                {% for key, applictaion in data['CSProductFeaturesAndBenefits'] %}
                                    {% if (applictaion.getFeatureName() | trim) %}
                                        <li>{{applictaion.getFeatureName()}}</li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        {% endif %}

                    </div>

                    {% if editmode %}
                        <div class="attr-font">Attribute Name = Product Image</div>
                    {% endif %}

                    {% if editmode %}
                        {% if pimcore_image("MPB_productImage").isEmpty() %}
                            {{ pimcore_image("MPB_productImage", {"height" : 350}).setImage(data['ProductImage']) | raw }}
                        {% else %}
                            {{ pimcore_image("MPB_productImage", {"height" : 350}) }}
                        {% endif %}
                    {% else %}
                        {% set MPB_productImageObj = pimcore_image("MPB_productImage") %}
                        {% if getImageThumbnail(MPB_productImageObj, imageWidth) %}
                            <img src="{{ getImageThumbnail(MPB_productImageObj, imageWidth) }}" class="w-100"  alt="" style="max-height:362px; width:auto;">
                        {% endif %}
                    {% endif %}
                </section>
            </main>
        </div>
    {% endif %}
{% endblock %}